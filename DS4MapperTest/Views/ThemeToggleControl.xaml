<UserControl x:Class="DS4MapperTest.Views.ThemeToggleControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Focusable="False"
             d:DesignHeight="48" d:DesignWidth="100">
    <Border x:Name="Chrome"
            BorderThickness="1"
            CornerRadius="{StaticResource JsmccButtonRadius}"
            Padding="14,12"
            Cursor="Hand"
            SnapsToDevicePixels="True"
            Focusable="True"
            KeyboardNavigation.IsTabStop="True"
            MouseLeftButtonUp="Chrome_MouseLeftButtonUp"
            KeyUp="Chrome_KeyUp">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource JsmccBgInputBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource JsmccBorderBrush}"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{DynamicResource JsmccBgButtonHoverBrush}"/>
                        <Setter Property="BorderBrush" Value="{DynamicResource JsmccBorderStrongBrush}"/>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>
        <StackPanel Orientation="Horizontal">
            <TextBlock x:Name="IconText"
                       FontFamily="Segoe UI Symbol"
                       FontSize="15"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0"
                       Foreground="{DynamicResource JsmccTextStrongBrush}"/>

            <Grid Width="46" Height="24" Margin="0,2" VerticalAlignment="Center">
                <Border x:Name="TrackBorder"
                        Background="{DynamicResource JsmccBgButtonHoverBrush}"
                        BorderBrush="{DynamicResource JsmccBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="999"/>
                <Ellipse x:Name="SwitchThumb"
                         Width="19"
                         Height="19"
                         HorizontalAlignment="Left"
                         Margin="3,0,0,0"
                         Fill="{DynamicResource JsmccBg2Brush}"
                         Stroke="{DynamicResource JsmccBorderBrush}"
                         StrokeThickness="1">
                    <Ellipse.Effect>
                        <DropShadowEffect ShadowDepth="1" Direction="270" BlurRadius="3" Color="Black" Opacity="0.25"/>
                    </Ellipse.Effect>
                </Ellipse>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
