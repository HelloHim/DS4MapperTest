<UserControl x:Class="DS4MapperTest.Views.InlineOutputBindingEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:DS4MapperTest.Views"
             Focusable="True">
    <Border Background="{DynamicResource JsmccBg1Brush}"
            BorderBrush="{DynamicResource JsmccAccentBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="10"
            Margin="0,8,0,0">
        <DockPanel LastChildFill="True">
            <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,8">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock x:Name="TitleText"
                               Style="{StaticResource JsmccLabelText}"/>
                    <TextBlock Text="Binding output"
                               Style="{StaticResource JsmccMutedText}"
                               Margin="0,2,0,0"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal">
                    <Button Content="Apply"
                            Click="ApplyButton_Click"
                            Style="{StaticResource JsmccButtonStyle}"
                            MinWidth="64"/>
                    <Button Content="Cancel"
                            Click="CancelButton_Click"
                            Style="{StaticResource JsmccButtonStyle}"
                            MinWidth="68"
                            Margin="8,0,0,0"/>
                    <Button Content="Unbind"
                            Click="UnbindButton_Click"
                            Style="{StaticResource JsmccDangerButtonStyle}"
                            MinWidth="72"
                            Margin="8,0,0,0"/>
                </StackPanel>
            </DockPanel>

            <views:OutputBindingEditorControl x:Name="Editor"
                                              ShowDoneButton="False"/>
        </DockPanel>
    </Border>
</UserControl>
