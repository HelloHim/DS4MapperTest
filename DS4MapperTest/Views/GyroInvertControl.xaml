<UserControl x:Class="DS4MapperTest.Views.GyroInvertControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d"
             d:DesignHeight="500"
             d:DesignWidth="860">
    <UserControl.Resources>
        <Style x:Key="InvertRowBorder" TargetType="Border" BasedOn="{StaticResource JsmccSettingRowBorder}">
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <DataTemplate x:Key="MouseInvertTemplate">
            <StackPanel>
                <Border Style="{StaticResource JsmccCardBorder}">
                    <StackPanel>
                        <TextBlock Text="Gyro Invert" Style="{StaticResource JsmccCardTitle}" Margin="0,0,0,6"/>

                        <Border Style="{StaticResource InvertRowBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Enable Gyro Invert" Style="{StaticResource JsmccLabelText}"/>
                                <CheckBox Grid.Column="1" Style="{StaticResource JsmccToggleStyle}" IsChecked="{Binding GyroInvertEnabled}"/>
                            </Grid>
                        </Border>

                        <StackPanel IsEnabled="{Binding GyroInvertEnabled}">
                            <Border Style="{StaticResource InvertRowBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Invert Axis" Style="{StaticResource JsmccLabelText}"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding GyroInvertAxisItems}" DisplayMemberPath="DisplayName"
                                              SelectedValuePath="ChoiceValue" SelectedValue="{Binding GyroInvertAxisChoice}"
                                              Style="{StaticResource JsmccComboBoxStyle}" MinWidth="150"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource InvertRowBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Activation Mode" Style="{StaticResource JsmccLabelText}"/>
                                    <ComboBox Grid.Column="1" ItemsSource="{Binding GyroActivationModeItems}" DisplayMemberPath="DisplayName"
                                              SelectedValuePath="ChoiceValue" SelectedValue="{Binding GyroInvertActivationModeChoice}"
                                              Style="{StaticResource JsmccComboBoxStyle}" MinWidth="150"/>
                                </Grid>
                            </Border>

                            <StackPanel Visibility="{Binding GyroInvertActivationButtonsUsed, Converter={StaticResource Boolean2VisibilityConverter}}">
                                <TextBlock Text="Activation Buttons" Style="{StaticResource JsmccLabelText}" Margin="0,4,0,4"/>
                                <ItemsControl ItemsSource="{Binding InvertActivationButtonItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <ToggleButton Content="{Binding DisplayString}"
                                                          IsChecked="{Binding Enabled, Mode=TwoWay}"
                                                          Style="{StaticResource JsmccChipToggleStyle}"
                                                          Margin="0,0,6,6"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <Border Style="{StaticResource InvertRowBorder}" Margin="0,6,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0"
                                                   Text="Multiple Gyro Button Behaviour"
                                                   Style="{StaticResource JsmccLabelText}"
                                                   Margin="0,0,14,0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <RadioButton Content="Any selected"
                                                         IsChecked="{Binding GyroInvertTriggerAnySelected, Mode=TwoWay}"
                                                         Style="{StaticResource CalibModeToggleStyle}"
                                                         Margin="0,0,6,0"/>
                                            <RadioButton Content="All selected"
                                                         IsChecked="{Binding GyroInvertTriggerAllSelected, Mode=TwoWay}"
                                                         Style="{StaticResource CalibModeToggleStyle}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <Border Style="{StaticResource InvertRowBorder}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Activation Hold Time"
                                                   Style="{StaticResource JsmccLabelText}" Margin="0,0,14,0"/>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <hc:NumericUpDown Minimum="0" Maximum="60000" Increment="10"
                                                              DecimalPlaces="0" Width="108"
                                                              Style="{StaticResource JsmccNumericUpDownStyle}"
                                                              Value="{Binding GyroInvertActivationHoldMs, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBlock Text="ms" Style="{StaticResource JsmccMutedText}"
                                                       Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="GyroInvertBindingTemplate">
            <ContentControl Tag="Invert" DataContext="{Binding}"
                            Loaded="InlineSettingsHost_Loaded"/>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False">
        <StackPanel Margin="0,0,10,12">
            <TextBlock Text="Gyro Invert" Style="{StaticResource JsmccSectionTitle}"/>
            <TextBlock Text="Independently invert the gyro mouse's horizontal and/or vertical output while a chosen button is held (or released). Off by default."
                       Style="{StaticResource JsmccBodyText}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"/>

            <ItemsControl ItemsSource="{Binding GyroBindings}" ItemTemplate="{StaticResource GyroInvertBindingTemplate}" Margin="0,12,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
