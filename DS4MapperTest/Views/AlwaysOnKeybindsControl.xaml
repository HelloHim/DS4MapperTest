<UserControl x:Class="DS4MapperTest.Views.AlwaysOnKeybindsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="520"
             d:DesignWidth="860">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <StackPanel>
        <DockPanel Margin="0,0,0,10" LastChildFill="True">
            <StackPanel DockPanel.Dock="Left">
                <TextBlock Text="Always-On" Style="{StaticResource JsmccSectionTitle}"/>
                <TextBlock Text="Configure actions that are active for the current action set/layer without requiring a button press."
                           Style="{StaticResource JsmccBodyText}"
                           TextWrapping="Wrap"
                           Margin="0,4,16,0"/>
            </StackPanel>

            <Button DockPanel.Dock="Right"
                    Content="Add Always-On Action"
                    Click="AddAlwaysOnButton_Click"
                    Style="{StaticResource JsmccButtonStyle}"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"/>
        </DockPanel>

        <Border>
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource JsmccCardBorder}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasAlwaysOnKeybinds}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="No always-on actions are configured for the current set/layer."
                       Style="{StaticResource JsmccBodyText}"
                       TextWrapping="Wrap"/>
        </Border>

        <ItemsControl x:Name="AlwaysOnItems"
                      ItemsSource="{Binding AlwaysOnKeybinds}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource JsmccCardBorder}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                                <TextBlock Text="{Binding DisplayName}"
                                           Style="{StaticResource JsmccCardTitle}"/>
                                <TextBlock Text="{Binding HelperText}"
                                           Style="{StaticResource JsmccMutedText}"
                                           Margin="0,3,0,0"/>
                                <TextBlock Text="{Binding DisplayBind, StringFormat=Output: {0}}"
                                           Style="{StaticResource JsmccBodyText}"
                                           TextWrapping="Wrap"
                                           Margin="0,8,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0"
                                        Grid.Column="1"
                                        Orientation="Horizontal"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Top">
                                <Button Content="Edit"
                                        Tag="{Binding}"
                                        Click="EditAlwaysOnButton_Click"
                                        Style="{StaticResource JsmccButtonStyle}"
                                        MinWidth="58"/>
                                <Button Content="Remove"
                                        Tag="{Binding}"
                                        Click="RemoveAlwaysOnButton_Click"
                                        Style="{StaticResource JsmccDangerButtonStyle}"
                                        MinWidth="76"
                                        Margin="8,0,0,0"/>
                            </StackPanel>

                            <ContentControl x:Name="InlineEditorHost"
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Visibility="Collapsed"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
