<UserControl x:Class="DS4MapperTest.Views.ExtraKeybindsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:DS4MapperTest.Views"
             mc:Ignorable="d"
             d:DesignHeight="620"
             d:DesignWidth="860">
    <StackPanel>
        <views:SharedButtonKeybindsControl
            SectionTitle="Touchpad"
            Description="Touchpad touch and click inputs exposed by the current controller."
            EmptyText="No touchpad touch or click bindings were found for the current controller."
            CardSubtitle="Touchpad input"
            ItemsSource="{Binding TouchpadButtonBindings}"/>

        <views:SharedButtonKeybindsControl
            Margin="0,18,0,0"
            SectionTitle="Extra"
            Description="Special controller inputs that do not fit the other categories. Regular Press maps to Normal Press."
            EmptyText="No extra button bindings were found for the current controller."
            CardSubtitle="Extra input"
            ItemsSource="{Binding ExtraButtonBindings}"/>

        <views:AlwaysOnKeybindsControl Margin="0,18,0,0"/>
    </StackPanel>
</UserControl>
