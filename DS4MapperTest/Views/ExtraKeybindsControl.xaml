<UserControl x:Class="DS4MapperTest.Views.ExtraKeybindsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:DS4MapperTest.Views"
             mc:Ignorable="d"
             d:DesignHeight="620"
             d:DesignWidth="860">
    <StackPanel>
        <views:SharedButtonKeybindsControl
            SectionTitle="Misc Buttons"
            Description="Extra controller buttons. Each MISC slot corresponds to a different physical button depending on your controller."
            EmptyText="No misc button bindings were found for the current controller."
            CardSubtitle="Misc input"
            ItemsSource="{Binding ExtraButtonBindings}"/>

        <views:AlwaysOnKeybindsControl Margin="0,18,0,0"/>
    </StackPanel>
</UserControl>
