<UserControl x:Class="DS4MapperTest.Views.Shared.CalibrationModeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d"
             d:DesignWidth="480" d:DesignHeight="170">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="AngleCalibrationBorder" TargetType="Border" BasedOn="{StaticResource JsmccSettingRowBorder}">
            <Setter Property="Background" Value="{DynamicResource JsmccBg1Brush}"/>
        </Style>
    </UserControl.Resources>

    <Border Style="{StaticResource AngleCalibrationBorder}" Margin="0,8,0,0">
        <StackPanel>
            <TextBlock Text="Angle Calibration" Style="{StaticResource JsmccLabelText}" Margin="0,0,0,6"/>
            <TextBlock Style="{StaticResource JsmccMutedText}"
                       TextWrapping="Wrap"
                       Margin="0,0,0,6">
                <Run Text="Counts is the mouse movement for a 360&#176; turn. RWC combines Counts and In-Game Sensitivity into a single calibration value."/>
                <LineBreak/>
                <Run Text="Counts = RWC &#215; 360 &#247; In-Game Sensitivity | RWC = Counts &#215; In-Game Sensitivity &#247; 360"/>
            </TextBlock>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                <RadioButton Content="Counts" GroupName="CalibrationMode"
                             Style="{StaticResource CalibModeToggleStyle}"
                             IsChecked="{Binding IsCountsMode, Mode=TwoWay}"/>
                <RadioButton Content="Real World Calibration" GroupName="CalibrationMode"
                             Style="{StaticResource CalibModeToggleStyle}"
                             IsChecked="{Binding IsRwcMode, Mode=TwoWay}"
                             Margin="8,0,0,0"/>
            </StackPanel>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Game Calibration Preset" Style="{StaticResource JsmccLabelText}"/>
                <ComboBox Grid.Column="1"
                          ItemsSource="{Binding GamePresets}"
                          SelectedItem="{Binding SelectedPreset}"
                          DisplayMemberPath="Name"
                          Width="180"
                          HorizontalAlignment="Left"
                          Visibility="{Binding IsRwcMode, Converter={StaticResource BoolToVis}}"
                          Style="{StaticResource JsmccComboBoxStyle}"/>
                <TextBlock Grid.Column="1" Text="{Binding SelectedPreset.Name}"
                           Width="180" VerticalAlignment="Center"
                           Style="{StaticResource JsmccMutedText}"
                           Visibility="{Binding IsCountsMode, Converter={StaticResource BoolToVis}}"/>
            </Grid>

            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding MasterCalibrationLabel}" Style="{StaticResource JsmccLabelText}"/>
                <!-- Both of these, and the derived field below, bind the same values and so
                     have to share one range. The hidden one still holds a live TwoWay binding,
                     and a NumericUpDown clamps whatever it is given to its own Maximum before
                     writing it back: at the old 999999.9999 ceiling, a Counts total past a
                     million (a preset picked at a sensitivity it was not measured at, say)
                     came back clamped from the field that was not even on screen. Counts is
                     the field that needs the headroom; RWC never approaches it. -->
                <hc:NumericUpDown Grid.Column="1" Minimum="0" Maximum="99999999.9999" DecimalPlaces="4" Increment="1000"
                                  ValueFormat="0.0###"
                                  Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                  Visibility="{Binding IsCountsMode, Converter={StaticResource BoolToVis}}"
                                  Value="{Binding MasterCalibrationValue, UpdateSourceTrigger=PropertyChanged}"/>
                <hc:NumericUpDown Grid.Column="1" Minimum="0" Maximum="99999999.9999" DecimalPlaces="4" Increment="1.0"
                                  ValueFormat="0.0###"
                                  Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                  Visibility="{Binding IsRwcMode, Converter={StaticResource BoolToVis}}"
                                  Value="{Binding MasterCalibrationValue, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>

            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="In-Game Sensitivity" Style="{StaticResource JsmccLabelText}"/>
                <!-- Every preset's RWC is Counts x this value / 360, so the field has to hold
                     whatever a game's own sensitivity slider can produce or the calibration is
                     rounded before it is ever used. Four places silently cut Quake Live's
                     0.545612 to 0.5456, which moves its RWC by 0.001, and a maximum of 10 put
                     Rainbow Six's 50 and THE FINALS' 12 out of reach entirely. -->
                <hc:NumericUpDown Grid.Column="1" Minimum="0.0001" Maximum="1000" DecimalPlaces="7" Increment="0.1"
                                  ValueFormat="0.0######"
                                  Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                  Value="{Binding InGameSens, UpdateSourceTrigger=PropertyChanged}"/>
            </Grid>

            <Grid Margin="0,6,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding DerivedLabel}" Style="{StaticResource JsmccLabelText}"/>
                <hc:NumericUpDown Grid.Column="1" Minimum="0" Maximum="99999999.9999" DecimalPlaces="4"
                                  ValueFormat="0.0###" IsEnabled="False" Focusable="False"
                                  Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                  Value="{Binding DerivedValue, Mode=OneWay}"/>
            </Grid>

            <TextBlock Text="Calibration is shared across Gyro Mouse, Trackpad Mouse, Joystick Mouse, Flick Stick, and Flick Turn Binds, in this profile."
                       Style="{StaticResource JsmccMutedText}"
                       TextWrapping="Wrap"
                       Margin="0,8,0,0"/>
        </StackPanel>
    </Border>
</UserControl>
