<UserControl x:Class="DS4MapperTest.Views.StickSideTouchBindingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:DS4MapperTest.Views"
             mc:Ignorable="d"
             d:DesignHeight="420"
             d:DesignWidth="860">
    <views:SharedButtonKeybindsControl
        SectionTitle="{Binding SideLabel}"
        Description="Stick touch bindings are always available, for controllers whose stick reports a touch sensor."
        EmptyText="{Binding TouchUnavailableMessage}"
        CardSubtitle="Stick touch sensor"
        ItemsSource="{Binding TouchBindingItems}"/>
</UserControl>
