<UserControl x:Class="DS4MapperTest.Views.ReleaseFuncPropControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:local="clr-namespace:DS4MapperTest.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel>
        <StackPanel>
            <local:ButtonActionFuncSelectControl x:Name="funcTypeControl" Margin="0,8,0,0" />
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Label Content="Name" />
                <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="300" Margin="8,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Label Content="Bindings" />
                <Button Content="{Binding DisplayBind,Mode=OneTime}" Width="200" Click="Button_Click" Margin="8,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Label Content="End Delay" />
                <hc:NumericUpDown Value="{Binding DelayMs, UpdateSourceTrigger=LostFocus}" DecimalPlaces="0"
                                  Minimum="0" Maximum="60000" Increment="10"
                                  Width="300" Margin="8,0,0,0" />
                <TextBlock Text="ms" VerticalAlignment="Center" Margin="6,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Label Content="Toggle" />
                <CheckBox IsChecked="{Binding ToggleEnabled}" Margin="8,0,0,0"
                          ToolTip="Alternate press and release on each source release, instead of a timed pulse">
                </CheckBox>
            </StackPanel>
        </StackPanel>
    </DockPanel>
</UserControl>
