<Window x:Class="DS4MapperTest.Views.ActionContentEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:views="clr-namespace:DS4MapperTest.Views"
        xmlns:converters="clr-namespace:DS4MapperTest.Converters"
        mc:Ignorable="d"
        Title="Edit Action Content"
        Height="720"
        Width="980"
        MinHeight="480"
        MinWidth="760"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource JsmccBg0Brush}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InvertBoolToVisibilityConverter x:Key="InvertBoolToVis"/>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Save" Click="SaveButton_Click" Style="{StaticResource JsmccButtonStyle}" Margin="0,0,8,0"/>
                <Button Content="Cancel" Click="CancelButton_Click" Style="{StaticResource JsmccButtonStyle}"/>
            </StackPanel>
            <StackPanel>
                <TextBlock Text="Edit Action Content" Style="{StaticResource JsmccPageTitle}"/>
                <TextBlock x:Name="headerSubtitleText"
                           Text="Editing the actions bound in this action set/layer."
                           Style="{StaticResource JsmccMutedText}"/>
            </StackPanel>
        </DockPanel>

        <TabControl x:Name="contentTabControl" Grid.Row="1" Style="{StaticResource JsmccPillTabControlStyle}">
            <TabItem x:Name="gyroTab" Header="Gyro &amp; Sensitivity">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                    <StackPanel Margin="0,10,0,0">
                        <TabControl Style="{StaticResource JsmccPillTabControlStyle}">
                            <TabItem Header="Gyro Behaviour">
                                <ScrollViewer VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled"
                                              CanContentScroll="False">
                                    <StackPanel>
                                        <views:GyroActionsPanel ShowActionSettings="False"
                                                                PanelTitle="Gyro Action"
                                                                PanelDescription="Choose what the gyro outputs. Output direction, invert, sensitivity, and noise steadying are tuned below and in the neighbouring tabs."/>
                                        <views:GyroOutputControl Margin="0,10,0,0"/>
                                    </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                            <TabItem Header="Gyro Activation">
                                <views:GyroActionsPanel ShowActionSelect="False"
                                                        ShowNameSettings="False"
                                                        ShowPanelHeader="False"
                                                        ShowBindingHeader="False"/>
                            </TabItem>
                            <TabItem Header="Sensitivity">
                                <views:GyroSensitivityControl/>
                            </TabItem>
                            <TabItem Header="Noise &amp; Steadying">
                                <views:GyroNoiseSteadyingControl/>
                            </TabItem>
                            <TabItem Header="Invert Gyro Activation">
                                <views:GyroInvertControl/>
                            </TabItem>
                            <TabItem Header="Extra">
                                <views:GyroActionsPanel ShowActionSelect="False"
                                                        ShowActivationSettings="False"
                                                        ShowPanelHeader="False"
                                                        ShowBindingHeader="False"/>
                            </TabItem>
                        </TabControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem x:Name="keybindsTab" Header="Keybinds">
                <StackPanel Margin="0,10,0,0">
                    <TabControl Style="{StaticResource JsmccPillTabControlStyle}">
                        <TabItem Header="Face">
                            <views:FaceKeybindsControl/>
                        </TabItem>
                        <TabItem Header="D-Pad">
                            <views:DPadKeybindsControl/>
                        </TabItem>
                        <TabItem Header="Bumpers">
                            <views:BumpersKeybindsControl/>
                        </TabItem>
                        <TabItem Header="Triggers">
                            <views:TriggersKeybindsControl/>
                        </TabItem>
                        <TabItem Header="Center">
                            <views:CenterKeybindsControl/>
                        </TabItem>
                        <TabItem Header="Paddles">
                            <views:PaddlesKeybindsControl/>
                        </TabItem>
                        <TabItem Header="Extra">
                            <views:ExtraKeybindsControl/>
                        </TabItem>
                    </TabControl>
                </StackPanel>
            </TabItem>

            <TabItem x:Name="touchpadTab" Header="Touchpad">
                <StackPanel Margin="0,10,0,0">
                    <views:TouchpadControl/>
                </StackPanel>
            </TabItem>

            <TabItem x:Name="sticksTab" Header="Sticks">
                <StackPanel Margin="0,10,0,0">
                    <TabControl Style="{StaticResource JsmccPillTabControlStyle}">
                        <TabItem Header="Touch Bindings">
                            <views:SticksTouchBindingsControl/>
                        </TabItem>
                        <TabItem Header="Click Bindings">
                            <views:SticksBindingsControl/>
                        </TabItem>
                        <TabItem Header="Left Stick Settings">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          CanContentScroll="False">
                                <StackPanel DataContext="{Binding LeftStickKeybinds}" Margin="0,0,10,12">
                                    <Border Style="{StaticResource JsmccCardBorder}"
                                            Visibility="{Binding HasBinding, Converter={StaticResource InvertBoolToVis}}">
                                        <TextBlock Text="No left stick binding available for this controller."
                                                   Style="{StaticResource JsmccBodyText}"
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                    <views:StickSideModeSettingsControl Visibility="{Binding HasBinding, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Right Stick Settings">
                            <ScrollViewer VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          CanContentScroll="False">
                                <StackPanel DataContext="{Binding RightStickKeybinds}" Margin="0,0,10,12">
                                    <Border Style="{StaticResource JsmccCardBorder}"
                                            Visibility="{Binding HasBinding, Converter={StaticResource InvertBoolToVis}}">
                                        <TextBlock Text="No right stick binding available for this controller."
                                                   Style="{StaticResource JsmccBodyText}"
                                                   TextWrapping="Wrap"/>
                                    </Border>
                                    <views:StickSideModeSettingsControl Visibility="{Binding HasBinding, Converter={StaticResource BoolToVis}}"/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                    </TabControl>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
