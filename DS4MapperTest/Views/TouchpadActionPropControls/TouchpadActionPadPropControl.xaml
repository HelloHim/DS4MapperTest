<UserControl x:Class="DS4MapperTest.Views.TouchpadActionPropControls.TouchpadActionPadPropControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:views="clr-namespace:DS4MapperTest.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="ModeRowBorder" TargetType="Border" BasedOn="{StaticResource JsmccSettingRowBorder}">
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <StackPanel x:Name="ExtraFieldsPanel">
            <Border Style="{StaticResource JsmccSettingRowBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Action Name"
                               Style="{StaticResource JsmccLabelText}"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                             Width="220"
                             HorizontalAlignment="Left"
                             Style="{StaticResource JsmccTextBoxStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Hidden"/>
                </Grid>
            </Border>
        </StackPanel>

        <StackPanel x:Name="ModeFieldsPanel">
            <Border Style="{StaticResource JsmccSettingRowBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="DPad Mode"
                               Style="{StaticResource JsmccLabelText}"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding PadModeItems}"
                              SelectedIndex="{Binding SelectedPadModeIndex}"
                              DisplayMemberPath="DisplayName"
                              Width="220"
                              HorizontalAlignment="Left">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource JsmccComboBoxStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HighlightPadMode}" Value="False">
                                        <Setter Property="Opacity" Value="0.7"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>
                </Grid>
            </Border>

            <Border Style="{StaticResource JsmccSettingRowBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Requires Click"
                               Style="{StaticResource JsmccLabelText}"/>
                    <CheckBox Grid.Column="1"
                              IsChecked="{Binding RequiresClick}"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox" BasedOn="{StaticResource JsmccToggleStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HighlightRequiresClick}" Value="False">
                                        <Setter Property="Opacity" Value="0.7"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>
                </Grid>
            </Border>

            <Border Style="{StaticResource JsmccSettingRowBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Binding Presets"
                               Style="{StaticResource JsmccLabelText}"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding ActionPresetChoicesItems}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="ChoiceValue"
                              SelectedValue="{Binding ActionPresetChoice}"
                              Width="180"
                              HorizontalAlignment="Left"
                              Style="{StaticResource JsmccComboBoxStyle}"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource JsmccSettingRowBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Directional Binds"
                                   Style="{StaticResource JsmccLabelText}"/>
                        <TextBlock Text="Quick bind"
                                   Style="{StaticResource JsmccMutedText}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <ItemsControl ItemsSource="{Binding CardinalDirectionItems}"
                                      Visibility="{Binding ShowCardinalPad, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource JsmccSettingRowBorder}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           Style="{StaticResource JsmccLabelText}"/>
                                                <TextBlock Text="{Binding Subtitle}"
                                                           Style="{StaticResource JsmccMutedText}"
                                                           Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <views:ActionOutputListControl Grid.Column="1"
                                                                           Grid.ColumnSpan="2"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding DiagonalDirectionItems}"
                                      Visibility="{Binding ShowDiagonalPad, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource JsmccSettingRowBorder}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           Style="{StaticResource JsmccLabelText}"/>
                                                <TextBlock Text="{Binding Subtitle}"
                                                           Style="{StaticResource JsmccMutedText}"
                                                           Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <views:ActionOutputListControl Grid.Column="1"
                                                                           Grid.ColumnSpan="2"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource JsmccSettingRowBorder}"
                    Visibility="{Binding ShowReleaseBrakeSection, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Counter Movement Release Press" Style="{StaticResource JsmccLabelText}" FontWeight="Bold" Margin="0,0,0,2"/>
                    <TextBlock Text="When a digital touchpad direction is released, the mapper can generate a short press of the opposite direction."
                               Style="{StaticResource JsmccMutedText}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,4"/>

                    <Border Style="{StaticResource ModeRowBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Enable Counter Movement Release Press" Style="{StaticResource JsmccLabelText}"/>
                            <CheckBox Grid.Column="1" IsChecked="{Binding CounterMovementReleasePressEnabled}" Style="{StaticResource JsmccToggleStyle}" VerticalAlignment="Center"/>
                        </Grid>
                    </Border>

                    <StackPanel IsEnabled="{Binding CounterMovementReleasePressEnabled}"
                                Visibility="{Binding CounterMovementReleasePressEnabled, Converter={StaticResource BoolToVis}}">
                        <Border Style="{StaticResource ModeRowBorder}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Counter Tap Length Mode" Style="{StaticResource JsmccLabelText}"/>
                                    <ComboBox Grid.Column="1"
                                              ItemsSource="{Binding TapLengthModeItems}"
                                              DisplayMemberPath="DisplayName"
                                              SelectedValuePath="ChoiceValue"
                                              SelectedValue="{Binding OppositeTapLengthMode}"
                                              Style="{StaticResource JsmccComboBoxStyle}"
                                              HorizontalAlignment="Left"
                                              MinWidth="220"/>
                                </Grid>
                                <TextBlock Text="{Binding OppositeTapLengthModeDescription}"
                                           Style="{StaticResource JsmccMutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModeRowBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Counter Tap Length Preset" Style="{StaticResource JsmccLabelText}"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding TapLengthPresetItems}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="ChoiceValue"
                                          SelectedValue="{Binding TapLengthPreset}"
                                          Style="{StaticResource JsmccComboBoxStyle}"
                                          HorizontalAlignment="Left"
                                          MinWidth="150"
                                          ToolTip="Custom uses the values below. CS2 sets the fixed duration to 84ms with 7% variance (equivalent to a 78-90ms range) and leaves everything else, including the start delay, unchanged."/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ModeRowBorder}"
                                Visibility="{Binding ShowFixedModeFields, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Counter Tap Length" Style="{StaticResource JsmccLabelText}"/>
                                    <hc:NumericUpDown Grid.Column="1" Minimum="10" Maximum="150" DecimalPlaces="0" Increment="1"
                                                      Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                                      Value="{Binding OppositeTapLengthMs, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Column="2" Text="ms" Style="{StaticResource JsmccLabelText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="Uses the same total duration for every qualifying release."
                                           Style="{StaticResource JsmccMutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModeRowBorder}"
                                Visibility="{Binding ShowWaitVariancePercentageModeFields, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Counter Tap Length" Style="{StaticResource JsmccLabelText}"/>
                                    <hc:NumericUpDown Grid.Column="1" Minimum="10" Maximum="150" DecimalPlaces="0" Increment="1"
                                                      Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                                      Value="{Binding OppositeTapLengthMs, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Column="2" Text="ms" Style="{StaticResource JsmccLabelText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Wait Variance Percentage" Style="{StaticResource JsmccLabelText}"/>
                                    <hc:NumericUpDown Grid.Column="1" Minimum="0" Maximum="100" DecimalPlaces="0" Increment="1"
                                                      Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                                      Value="{Binding OppositeTapLengthVariancePercent, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Column="2" Text="%" Style="{StaticResource JsmccLabelText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="Sets the percentage range below and above the fixed tap length. Final boundaries are rounded down to whole milliseconds."
                                           Style="{StaticResource JsmccMutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModeRowBorder}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Deadzone Release Press" Style="{StaticResource JsmccLabelText}"/>
                                    <CheckBox Grid.Column="1"
                                              IsChecked="{Binding CounterMovementDeadZoneReleaseEnabled}"
                                              Style="{StaticResource JsmccToggleStyle}"
                                              VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="When enabled, sliding into the touchpad deadzone triggers the opposite tap without lifting your thumb."
                                           Style="{StaticResource JsmccMutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource ModeRowBorder}"
                                Visibility="{Binding ShowMinimumAndMaximumModeFields, Converter={StaticResource BoolToVis}}">
                            <StackPanel>
                                <TextBlock Text="Counter Tap Length Variance" Style="{StaticResource JsmccLabelText}" Margin="0,0,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="170"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Minimum" Style="{StaticResource JsmccLabelText}"/>
                                    <hc:NumericUpDown Grid.Column="1" Minimum="10" Maximum="150" DecimalPlaces="0" Increment="1"
                                                      Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                                      Value="{Binding OppositeTapLengthMinimumMs, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Column="2" Text="ms" Style="{StaticResource JsmccLabelText}" Margin="6,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="Maximum" Style="{StaticResource JsmccLabelText}"/>
                                    <hc:NumericUpDown Grid.Column="4" Minimum="10" Maximum="150" DecimalPlaces="0" Increment="1"
                                                      Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                                      Value="{Binding OppositeTapLengthMaximumMs, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Column="5" Text="ms" Style="{StaticResource JsmccLabelText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="Selects a total duration at random from the specified inclusive range. On each qualifying release, one value is picked at random from this range and used as the complete window for that release."
                                           Style="{StaticResource JsmccMutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Expander Header="Advanced Settings" IsExpanded="False" Margin="0,0,0,6">
                            <StackPanel Margin="12,8,0,0">
                                <Border Style="{StaticResource ModeRowBorder}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="260"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Counter Tap Start Delay Mode" Style="{StaticResource JsmccLabelText}"/>
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding StartDelayModeItems}"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectedValuePath="ChoiceValue"
                                                      SelectedValue="{Binding OppositeTapStartDelayMode}"
                                                      Style="{StaticResource JsmccComboBoxStyle}"
                                                      HorizontalAlignment="Left"
                                                      MinWidth="220"/>
                                        </Grid>
                                        <TextBlock Text="{Binding OppositeTapStartDelayModeDescription}"
                                                   Style="{StaticResource JsmccMutedText}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource ModeRowBorder}"
                                        Visibility="{Binding ShowStartDelayFixedModeFields, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="260"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Counter Tap Start Delay" Style="{StaticResource JsmccLabelText}"/>
                                            <hc:NumericUpDown Grid.Column="1" Minimum="0" Maximum="150" DecimalPlaces="0" Increment="1"
                                                              Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                                              Value="{Binding OppositeTapStartDelayMs, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBlock Grid.Column="2" Text="ms" Style="{StaticResource JsmccLabelText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Text="Sets a fixed neutral delay before the generated opposite press begins."
                                                   Style="{StaticResource JsmccMutedText}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource ModeRowBorder}"
                                        Visibility="{Binding ShowStartDelayWaitVariancePercentageModeFields, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="260"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Counter Tap Start Delay" Style="{StaticResource JsmccLabelText}"/>
                                            <hc:NumericUpDown Grid.Column="1" Minimum="0" Maximum="150" DecimalPlaces="0" Increment="1"
                                                              Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                                              Value="{Binding OppositeTapStartDelayMs, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBlock Grid.Column="2" Text="ms" Style="{StaticResource JsmccLabelText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="260"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Wait Variance Percentage" Style="{StaticResource JsmccLabelText}"/>
                                            <hc:NumericUpDown Grid.Column="1" Minimum="0" Maximum="100" DecimalPlaces="0" Increment="1"
                                                              Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                                              Value="{Binding OppositeTapStartDelayVariancePercent, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBlock Grid.Column="2" Text="%" Style="{StaticResource JsmccLabelText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Text="Sets the percentage range below and above the fixed start delay. Final boundaries are rounded down to whole milliseconds."
                                                   Style="{StaticResource JsmccMutedText}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource ModeRowBorder}"
                                        Visibility="{Binding ShowStartDelayMinimumAndMaximumModeFields, Converter={StaticResource BoolToVis}}">
                                    <StackPanel>
                                        <TextBlock Text="Counter Tap Start Delay Variance" Style="{StaticResource JsmccLabelText}" Margin="0,0,0,4"/>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Minimum" Style="{StaticResource JsmccLabelText}"/>
                                            <hc:NumericUpDown Grid.Column="1" Minimum="0" Maximum="150" DecimalPlaces="0" Increment="1"
                                                              Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                                              Value="{Binding OppositeTapStartDelayMinimumMs, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBlock Grid.Column="2" Text="ms" Style="{StaticResource JsmccLabelText}" Margin="6,0,12,0" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="3" Text="Maximum" Style="{StaticResource JsmccLabelText}"/>
                                            <hc:NumericUpDown Grid.Column="4" Minimum="0" Maximum="150" DecimalPlaces="0" Increment="1"
                                                              Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                                              Value="{Binding OppositeTapStartDelayMaximumMs, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBlock Grid.Column="5" Text="ms" Style="{StaticResource JsmccLabelText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Text="Sets the minimum and maximum neutral delay before the generated opposite press begins. The start delay is included within the selected tap-length window above: it is subtracted from the opposite-direction hold time, so the complete action never runs longer than the selected duration."
                                                   Style="{StaticResource JsmccMutedText}"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource ModeRowBorder}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="170"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Minimum Hold Time" Style="{StaticResource JsmccLabelText}"/>
                                            <hc:NumericUpDown Grid.Column="1" Minimum="0" Maximum="300" DecimalPlaces="0" Increment="1"
                                                              Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                                              Value="{Binding BrakeMinimumHoldMs, UpdateSourceTrigger=LostFocus}"/>
                                            <TextBlock Grid.Column="2" Text="ms" Style="{StaticResource JsmccLabelText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                        </Grid>
                                        <TextBlock Text="Controls how long a digital direction must stay active before Counter Movement Release Press is eligible."
                                                   Style="{StaticResource JsmccMutedText}"
                                                   TextWrapping="Wrap"
                                                   Margin="170,4,0,0"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel x:Name="ZoneGeometryFieldsPanel">
            <Border Style="{StaticResource JsmccSettingRowBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Dead Zone Type"
                               Style="{StaticResource JsmccLabelText}"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding DeadZoneModesChoices}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="ChoiceValue"
                              SelectedValue="{Binding DeadZoneType}"
                              Width="220"
                              HorizontalAlignment="Left">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource JsmccComboBoxStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HighlightDeadZoneType}" Value="False">
                                        <Setter Property="Opacity" Value="0.7"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>
                </Grid>
            </Border>

            <Border Style="{StaticResource JsmccSettingRowBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Dead Zone"
                               Style="{StaticResource JsmccLabelText}"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding DeadZone, UpdateSourceTrigger=LostFocus}"
                             Width="100"
                             HorizontalAlignment="Left">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource JsmccTextBoxStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HighlightDeadZone}" Value="False">
                                        <Setter Property="Opacity" Value="0.7"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>
            </Border>

            <Border Style="{StaticResource JsmccSettingRowBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Diagonal Range"
                               Style="{StaticResource JsmccLabelText}"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding DiagonalRange, UpdateSourceTrigger=LostFocus}"
                             Width="100"
                             HorizontalAlignment="Left">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource JsmccTextBoxStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HighlightDiagonalRange}" Value="False">
                                        <Setter Property="Opacity" Value="0.7"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>
            </Border>
        </StackPanel>

        <StackPanel x:Name="OuterRingFieldsPanel">
            <Border Style="{StaticResource JsmccSettingRowBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Outer Ring"
                               Style="{StaticResource JsmccLabelText}"/>
                    <StackPanel Grid.Column="1">
                        <WrapPanel>
                            <Border Background="{DynamicResource JsmccBgFieldGroupBrush}"
                                    BorderBrush="{DynamicResource JsmccBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6,4"
                                    Margin="0,0,8,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Enable"
                                               Style="{StaticResource JsmccLabelText}"
                                               Margin="0,0,8,0"/>
                                    <CheckBox IsChecked="{Binding UseOuterRing}"
                                              Style="{StaticResource JsmccToggleStyle}"
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource JsmccBgFieldGroupBrush}"
                                    BorderBrush="{DynamicResource JsmccBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6,4"
                                    Margin="0,0,8,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Invert"
                                               Style="{StaticResource JsmccLabelText}"
                                               Margin="0,0,8,0"/>
                                    <CheckBox IsChecked="{Binding OuterRingInvert}"
                                              Style="{StaticResource JsmccToggleStyle}"
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <Border Style="{StaticResource JsmccSettingRowBorder}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Outer Ring Bind"
                                           Style="{StaticResource JsmccLabelText}"/>
                                <views:ActionOutputListControl Grid.Column="1"
                                                               DataContext="{Binding RingBindItem}"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource JsmccSettingRowBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Dead Zone"
                                           Style="{StaticResource JsmccLabelText}"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding OuterRingDeadZone, UpdateSourceTrigger=LostFocus}"
                                         Width="100"
                                         HorizontalAlignment="Left"
                                         Style="{StaticResource JsmccTextBoxStyle}"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource JsmccSettingRowBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Active Range"
                                           Style="{StaticResource JsmccLabelText}"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding OuterRingRangeChoiceItems}"
                                          SelectedValue="{Binding OuterRingRangeChoice}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="ChoiceValue"
                                          Width="180"
                                          HorizontalAlignment="Left"
                                          Style="{StaticResource JsmccComboBoxStyle}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>

        <StackPanel x:Name="AdvancedFieldsPanel"/>
    </StackPanel>
</UserControl>
