<UserControl x:Class="DS4MapperTest.Views.TouchpadActionPropControls.TouchpadActionPadPropControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:views="clr-namespace:DS4MapperTest.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <StackPanel>
        <StackPanel x:Name="ExtraFieldsPanel">
            <Border Style="{StaticResource JsmccSettingRowBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Action Name"
                               Style="{StaticResource JsmccLabelText}"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                             Width="220"
                             HorizontalAlignment="Left"
                             Style="{StaticResource JsmccTextBoxStyle}"
                             ScrollViewer.HorizontalScrollBarVisibility="Hidden"/>
                </Grid>
            </Border>
        </StackPanel>

        <StackPanel x:Name="ModeFieldsPanel">
            <Border Style="{StaticResource JsmccSettingRowBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="DPad Mode"
                               Style="{StaticResource JsmccLabelText}"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding PadModeItems}"
                              SelectedIndex="{Binding SelectedPadModeIndex}"
                              DisplayMemberPath="DisplayName"
                              Width="220"
                              HorizontalAlignment="Left">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource JsmccComboBoxStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HighlightPadMode}" Value="False">
                                        <Setter Property="Opacity" Value="0.7"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>
                </Grid>
            </Border>

            <Border Style="{StaticResource JsmccSettingRowBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Requires Click"
                               Style="{StaticResource JsmccLabelText}"/>
                    <CheckBox Grid.Column="1"
                              IsChecked="{Binding RequiresClick}"
                              HorizontalAlignment="Left"
                              VerticalAlignment="Center">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox" BasedOn="{StaticResource JsmccToggleStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HighlightRequiresClick}" Value="False">
                                        <Setter Property="Opacity" Value="0.7"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>
                </Grid>
            </Border>

            <Border Style="{StaticResource JsmccSettingRowBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Directional Binds"
                                   Style="{StaticResource JsmccLabelText}"/>
                        <TextBlock Text="Quick bind"
                                   Style="{StaticResource JsmccMutedText}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1">
                        <ItemsControl ItemsSource="{Binding CardinalDirectionItems}"
                                      Visibility="{Binding ShowCardinalPad, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource JsmccSettingRowBorder}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           Style="{StaticResource JsmccLabelText}"/>
                                                <TextBlock Text="{Binding Subtitle}"
                                                           Style="{StaticResource JsmccMutedText}"
                                                           Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <views:QuickBindControl Grid.Column="1"/>
                                            <Button Grid.Column="2"
                                                    Content="Edit Functions"
                                                    Tag="{Binding}"
                                                    Click="DirectionAdvancedEdit_Click"
                                                    Style="{StaticResource JsmccButtonStyle}"
                                                    MinWidth="104"
                                                    Margin="10,0,0,0"
                                                    HorizontalAlignment="Right"/>
                                            <ContentControl x:Name="InlineEditorHost"
                                                            Grid.Row="1"
                                                            Grid.Column="0"
                                                            Grid.ColumnSpan="3"
                                                            Visibility="Collapsed"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ItemsControl ItemsSource="{Binding DiagonalDirectionItems}"
                                      Visibility="{Binding ShowDiagonalPad, Converter={StaticResource BoolToVis}}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource JsmccSettingRowBorder}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           Style="{StaticResource JsmccLabelText}"/>
                                                <TextBlock Text="{Binding Subtitle}"
                                                           Style="{StaticResource JsmccMutedText}"
                                                           Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <views:QuickBindControl Grid.Column="1"/>
                                            <Button Grid.Column="2"
                                                    Content="Edit Functions"
                                                    Tag="{Binding}"
                                                    Click="DirectionAdvancedEdit_Click"
                                                    Style="{StaticResource JsmccButtonStyle}"
                                                    MinWidth="104"
                                                    Margin="10,0,0,0"
                                                    HorizontalAlignment="Right"/>
                                            <ContentControl x:Name="InlineEditorHost"
                                                            Grid.Row="1"
                                                            Grid.Column="0"
                                                            Grid.ColumnSpan="3"
                                                            Visibility="Collapsed"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource JsmccSettingRowBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Presets"
                               Style="{StaticResource JsmccLabelText}"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding ActionPresetChoicesItems}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="ChoiceValue"
                              SelectedValue="{Binding ActionPresetChoice}"
                              Width="180"
                              HorizontalAlignment="Left"
                              Style="{StaticResource JsmccComboBoxStyle}"/>
                </Grid>
            </Border>

            <Border Style="{StaticResource JsmccSettingRowBorder}"
                    Visibility="{Binding ShowReleaseBrakeSection, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <TextBlock Text="Digital Release Brake"
                               Style="{StaticResource JsmccCardTitle}"/>

                    <WrapPanel Margin="0,8,0,0">
                        <Border Background="{DynamicResource JsmccBgInputBrush}"
                                BorderBrush="{DynamicResource JsmccBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,4"
                                Margin="0,0,8,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Enable"
                                           Style="{StaticResource JsmccLabelText}"
                                           Margin="0,0,8,0"/>
                                <CheckBox IsChecked="{Binding BrakeEnabled}"
                                          Style="{StaticResource JsmccToggleStyle}"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource JsmccBgInputBrush}"
                                BorderBrush="{DynamicResource JsmccBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,4"
                                Margin="0,0,8,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Opposite Tap Length"
                                           Style="{StaticResource JsmccLabelText}"
                                           Margin="0,0,8,0"/>
                                <hc:NumericUpDown Minimum="10"
                                                  Maximum="150"
                                                  Value="{Binding BrakeDurationMs}"
                                                  DecimalPlaces="0"
                                                  Increment="1"
                                                  Width="96"
                                                  Style="{StaticResource JsmccNumericUpDownStyle}"/>
                                <TextBlock Text="ms"
                                           Style="{StaticResource JsmccMutedText}"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource JsmccBgInputBrush}"
                                BorderBrush="{DynamicResource JsmccBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="6,4"
                                Margin="0,0,8,4">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Minimum Hold Time"
                                           Style="{StaticResource JsmccLabelText}"
                                           Margin="0,0,8,0"/>
                                <hc:NumericUpDown Minimum="0"
                                                  Maximum="300"
                                                  Value="{Binding BrakeMinimumHoldMs}"
                                                  DecimalPlaces="0"
                                                  Increment="1"
                                                  Width="96"
                                                  Style="{StaticResource JsmccNumericUpDownStyle}"/>
                                <TextBlock Text="ms"
                                           Style="{StaticResource JsmccMutedText}"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel x:Name="ZoneGeometryFieldsPanel">
            <Border Style="{StaticResource JsmccSettingRowBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Dead Zone Type"
                               Style="{StaticResource JsmccLabelText}"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding DeadZoneModesChoices}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="ChoiceValue"
                              SelectedValue="{Binding DeadZoneType}"
                              Width="220"
                              HorizontalAlignment="Left">
                        <ComboBox.Style>
                            <Style TargetType="ComboBox" BasedOn="{StaticResource JsmccComboBoxStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HighlightDeadZoneType}" Value="False">
                                        <Setter Property="Opacity" Value="0.7"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ComboBox.Style>
                    </ComboBox>
                </Grid>
            </Border>

            <Border Style="{StaticResource JsmccSettingRowBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Dead Zone"
                               Style="{StaticResource JsmccLabelText}"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding DeadZone, UpdateSourceTrigger=LostFocus}"
                             Width="100"
                             HorizontalAlignment="Left">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource JsmccTextBoxStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HighlightDeadZone}" Value="False">
                                        <Setter Property="Opacity" Value="0.7"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>
            </Border>

            <Border Style="{StaticResource JsmccSettingRowBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Diagonal Range"
                               Style="{StaticResource JsmccLabelText}"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding DiagonalRange, UpdateSourceTrigger=LostFocus}"
                             Width="100"
                             HorizontalAlignment="Left">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource JsmccTextBoxStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HighlightDiagonalRange}" Value="False">
                                        <Setter Property="Opacity" Value="0.7"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </Grid>
            </Border>
        </StackPanel>

        <StackPanel x:Name="AdvancedFieldsPanel">
            <Border Style="{StaticResource JsmccSettingRowBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Outer Ring"
                               Style="{StaticResource JsmccLabelText}"/>
                    <StackPanel Grid.Column="1">
                        <WrapPanel>
                            <Border Background="{DynamicResource JsmccBgInputBrush}"
                                    BorderBrush="{DynamicResource JsmccBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6,4"
                                    Margin="0,0,8,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Use"
                                               Style="{StaticResource JsmccLabelText}"
                                               Margin="0,0,8,0"/>
                                    <CheckBox IsChecked="{Binding UseOuterRing}"
                                              Style="{StaticResource JsmccToggleStyle}"
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>

                            <Border Background="{DynamicResource JsmccBgInputBrush}"
                                    BorderBrush="{DynamicResource JsmccBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6,4"
                                    Margin="0,0,8,4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Invert"
                                               Style="{StaticResource JsmccLabelText}"
                                               Margin="0,0,8,0"/>
                                    <CheckBox IsChecked="{Binding OuterRingInvert}"
                                              Style="{StaticResource JsmccToggleStyle}"
                                              VerticalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <Border Style="{StaticResource JsmccSettingRowBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Outer Ring Bind"
                                           Style="{StaticResource JsmccLabelText}"/>
                                <Button Grid.Column="1"
                                        x:Name="btnEditTest"
                                        Content="{Binding ActionRingDisplayBind, Mode=OneWay, FallbackValue='Test Bind'}"
                                        Click="btnEditTest_Click"
                                        Style="{StaticResource JsmccOutputButtonStyle}"
                                        HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource JsmccSettingRowBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Dead Zone"
                                           Style="{StaticResource JsmccLabelText}"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding OuterRingDeadZone, UpdateSourceTrigger=LostFocus}"
                                         Width="100"
                                         HorizontalAlignment="Left"
                                         Style="{StaticResource JsmccTextBoxStyle}"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource JsmccSettingRowBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="Active Range"
                                           Style="{StaticResource JsmccLabelText}"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding OuterRingRangeChoiceItems}"
                                          SelectedValue="{Binding OuterRingRangeChoice}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="ChoiceValue"
                                          Width="180"
                                          HorizontalAlignment="Left"
                                          Style="{StaticResource JsmccComboBoxStyle}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
    </StackPanel>
</UserControl>
