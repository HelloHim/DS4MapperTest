<UserControl x:Class="DS4MapperTest.Views.TouchpadActionPropControls.TouchpadStickActionPropControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DS4MapperTest.Views.TouchpadActionPropControls"
             xmlns:views="clr-namespace:DS4MapperTest.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <Style x:Key="ModeRowBorder" TargetType="Border" BasedOn="{StaticResource JsmccSettingRowBorder}">
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="ModeRowLabel" TargetType="TextBlock" BasedOn="{StaticResource JsmccLabelText}">
            <Setter Property="Width" Value="170"/>
        </Style>
    </UserControl.Resources>
    <DockPanel>
        <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto">
            <StackPanel>
            <StackPanel x:Name="ExtraFieldsPanel">
                <Border Style="{StaticResource ModeRowBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Action Name" Style="{StaticResource ModeRowLabel}"/>
                        <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                                 Width="220" HorizontalAlignment="Left"
                                 ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource JsmccTextBoxStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HighlightName}" Value="False">
                                            <Setter Property="Opacity" Value="0.7" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel x:Name="MovementFieldsPanel">
                <Border Style="{StaticResource ModeRowBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Output Stick" Style="{StaticResource ModeRowLabel}"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding OutputStickItems}" SelectedIndex="{Binding OutputStickIndex}"
                                  DisplayMemberPath="DisplayName"
                                  HorizontalAlignment="Left" MinWidth="180">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource JsmccComboBoxStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HighlightOutputStickIndex}" Value="False">
                                            <Setter Property="Opacity" Value="0.7" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ModeRowBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Invert" Style="{StaticResource ModeRowLabel}"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding InvertItems}" DisplayMemberPath="DisplayName"
                                  SelectedValuePath="ChoiceValue" SelectedValue="{Binding Invert}"
                                  HorizontalAlignment="Left" MinWidth="150">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource JsmccComboBoxStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HighlightInvert}" Value="False">
                                            <Setter Property="Opacity" Value="0.7" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ModeRowBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Force Center" Style="{StaticResource ModeRowLabel}"/>
                        <CheckBox Grid.Column="1" IsChecked="{Binding ForceCenter}" VerticalAlignment="Center">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox" BasedOn="{StaticResource JsmccToggleStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HighlightForceCenterChanged}" Value="False">
                                            <Setter Property="Opacity" Value="0.7" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel x:Name="SensitivityFieldsPanel">
                <Border Style="{StaticResource ModeRowBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Output Curve" Style="{StaticResource ModeRowLabel}"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding OutputCurveChoices}" DisplayMemberPath="DisplayName"
                                  SelectedValuePath="ChoiceValue" SelectedValue="{Binding OutputCurve}"
                                  HorizontalAlignment="Left" MinWidth="180">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource JsmccComboBoxStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HighlightOutputCurve}" Value="False">
                                            <Setter Property="Opacity" Value="0.7" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ModeRowBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Vertical Scale" Style="{StaticResource ModeRowLabel}"/>
                        <hc:NumericUpDown Grid.Column="1" Minimum="0.0" Maximum="10.0" DecimalPlaces="1" Increment="0.1"
                                          Width="90"
                                          Value="{Binding VerticalScale, FallbackValue='1.0'}">
                            <hc:NumericUpDown.Style>
                                <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource JsmccNumericUpDownStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HighlightVerticalScale}" Value="False">
                                            <Setter Property="Opacity" Value="0.7" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:NumericUpDown.Style>
                        </hc:NumericUpDown>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ModeRowBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Max Output" Style="{StaticResource ModeRowLabel}"/>
                        <CheckBox Grid.Column="1" IsChecked="{Binding MaxOutputEnabled}" VerticalAlignment="Center">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox" BasedOn="{StaticResource JsmccToggleStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HighlightMaxOutputEnabled}" Value="False">
                                            <Setter Property="Opacity" Value="0.7" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ModeRowBorder}"
                        Visibility="{Binding MaxOutputEnabled, Converter={StaticResource Boolean2VisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Max Output Value" Style="{StaticResource ModeRowLabel}"/>
                        <hc:NumericUpDown Grid.Column="1" Minimum="0.0" Maximum="1.0" DecimalPlaces="2"
                                          Width="90"
                                          IsEnabled="{Binding MaxOutputEnabled}"
                                          Value="{Binding MaxOutput}">
                            <hc:NumericUpDown.Style>
                                <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource JsmccNumericUpDownStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HighlightMaxOutput}" Value="False">
                                            <Setter Property="Opacity" Value="0.7" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:NumericUpDown.Style>
                        </hc:NumericUpDown>
                    </Grid>
                </Border>
            </StackPanel>

            <StackPanel x:Name="FilteringFieldsPanel">
                <Border Style="{StaticResource ModeRowBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Dead Zone Type" Style="{StaticResource ModeRowLabel}"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding DeadZoneModesChoices}" DisplayMemberPath="DisplayName"
                                  SelectedValuePath="ChoiceValue" SelectedValue="{Binding DeadZoneType}"
                                  HorizontalAlignment="Left" MinWidth="150">
                            <ComboBox.Style>
                                <Style TargetType="ComboBox" BasedOn="{StaticResource JsmccComboBoxStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HighlightDeadZoneType}" Value="False">
                                            <Setter Property="Opacity" Value="0.7" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ComboBox.Style>
                        </ComboBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ModeRowBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Dead Zone" Style="{StaticResource ModeRowLabel}"/>
                        <TextBox Grid.Column="1" Text="{Binding DeadZone, UpdateSourceTrigger=LostFocus}" Width="80">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource JsmccTextBoxStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HighlightDeadZone}" Value="False">
                                            <Setter Property="Opacity" Value="0.7" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ModeRowBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Anti-Dead Zone" Style="{StaticResource ModeRowLabel}"/>
                        <TextBox Grid.Column="1" Text="{Binding AntiDeadZone, UpdateSourceTrigger=LostFocus}" Width="80">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource JsmccTextBoxStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HighlightAntiDeadZone}" Value="False">
                                            <Setter Property="Opacity" Value="0.7" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ModeRowBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Max Zone" Style="{StaticResource ModeRowLabel}"/>
                        <TextBox Grid.Column="1" Text="{Binding MaxZone, UpdateSourceTrigger=LostFocus}" Width="80">
                            <TextBox.Style>
                                <Style TargetType="TextBox" BasedOn="{StaticResource JsmccTextBoxStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HighlightMaxZone}" Value="False">
                                            <Setter Property="Opacity" Value="0.7" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBox.Style>
                        </TextBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ModeRowBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Square Stick" Style="{StaticResource ModeRowLabel}"/>
                        <CheckBox Grid.Column="1" IsChecked="{Binding SquareStickEnabled}" VerticalAlignment="Center">
                            <CheckBox.Style>
                                <Style TargetType="CheckBox" BasedOn="{StaticResource JsmccToggleStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HighlightSquareStickEnabled}" Value="False">
                                            <Setter Property="Opacity" Value="0.7" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </CheckBox.Style>
                        </CheckBox>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ModeRowBorder}"
                        Visibility="{Binding SquareStickEnabled, Converter={StaticResource Boolean2VisibilityConverter}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Roundness" Style="{StaticResource ModeRowLabel}"/>
                        <hc:NumericUpDown Grid.Column="1" Minimum="1.0" Maximum="10.0" DecimalPlaces="2"
                                          Width="90"
                                          IsEnabled="{Binding SquareStickEnabled}"
                                          Value="{Binding SquareStickRoundness}">
                            <hc:NumericUpDown.Style>
                                <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource JsmccNumericUpDownStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HighlightSquareStickRoundness}" Value="False">
                                            <Setter Property="Opacity" Value="0.7" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:NumericUpDown.Style>
                        </hc:NumericUpDown>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ModeRowBorder}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Smoothing" Style="{StaticResource JsmccLabelText}" FontWeight="Bold" VerticalAlignment="Center"/>
                            <CheckBox Style="{StaticResource JsmccToggleStyle}"
                                      IsChecked="{Binding SmoothingEnabled}"
                                      VerticalAlignment="Center"
                                      Margin="12,0,0,0"/>
                        </StackPanel>

                        <StackPanel IsEnabled="{Binding SmoothingEnabled}">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="1&#x20ac; MinCutoff" Style="{StaticResource ModeRowLabel}"/>
                                <hc:NumericUpDown Grid.Column="1" Minimum="0.0" Maximum="10.0" DecimalPlaces="1" Increment="0.1"
                                                  Width="90"
                                                  Value="{Binding SmoothingMinCutoff, FallbackValue='1.0'}">
                                    <hc:NumericUpDown.Style>
                                        <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource JsmccNumericUpDownStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HighlightSmoothingFilter}" Value="False">
                                                    <Setter Property="Opacity" Value="0.7" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </hc:NumericUpDown.Style>
                                </hc:NumericUpDown>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="1&#x20ac; Beta" Style="{StaticResource ModeRowLabel}"/>
                                <hc:NumericUpDown Grid.Column="1" Minimum="0.0" Maximum="1.0" DecimalPlaces="1" Increment="0.1"
                                                  Width="90"
                                                  Value="{Binding SmoothingBeta, FallbackValue='1.0'}">
                                    <hc:NumericUpDown.Style>
                                        <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource JsmccNumericUpDownStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HighlightSmoothingFilter}" Value="False">
                                                    <Setter Property="Opacity" Value="0.7" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </hc:NumericUpDown.Style>
                                </hc:NumericUpDown>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="AdvancedFieldsPanel">
                <Expander Header="Outer Ring" IsExpanded="False" Margin="0,0,0,6">
                    <StackPanel Margin="12,8,0,0">
                        <Border Style="{StaticResource ModeRowBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Enable" Style="{StaticResource ModeRowLabel}"/>
                                <CheckBox Grid.Column="1" IsChecked="{Binding UseOuterRing}" VerticalAlignment="Center">
                                    <CheckBox.Style>
                                        <Style TargetType="CheckBox" BasedOn="{StaticResource JsmccToggleStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HighlightUseOuterRing}" Value="False">
                                                    <Setter Property="Opacity" Value="0.7" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </CheckBox.Style>
                                </CheckBox>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ModeRowBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Outer Ring Bind" Style="{StaticResource ModeRowLabel}"/>
                                <views:ActionOutputListControl Grid.Column="1" DataContext="{Binding RingBindItem}"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ModeRowBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Outer Ring Invert" Style="{StaticResource ModeRowLabel}"/>
                                <CheckBox Grid.Column="1" IsChecked="{Binding OuterRingInvert}" VerticalAlignment="Center">
                                    <CheckBox.Style>
                                        <Style TargetType="CheckBox" BasedOn="{StaticResource JsmccToggleStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HighlightOuterRingInvert}" Value="False">
                                                    <Setter Property="Opacity" Value="0.7" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </CheckBox.Style>
                                </CheckBox>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ModeRowBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Outer Ring Dead Zone" Style="{StaticResource ModeRowLabel}"/>
                                <TextBox Grid.Column="1" Text="{Binding OuterRingDeadZone, UpdateSourceTrigger=LostFocus}" Width="90">
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource JsmccTextBoxStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HighlightOuterRingDeadZone}" Value="False">
                                                    <Setter Property="Opacity" Value="0.7" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource ModeRowBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Outer Ring Active Range" Style="{StaticResource ModeRowLabel}"/>
                                <ComboBox Grid.Column="1" ItemsSource="{Binding OuterRingRangeChoiceItems}" SelectedValue="{Binding OuterRingRangeChoice}"
                                          DisplayMemberPath="DisplayName" SelectedValuePath="ChoiceValue"
                                          HorizontalAlignment="Left" MinWidth="150">
                                    <ComboBox.Style>
                                        <Style TargetType="ComboBox" BasedOn="{StaticResource JsmccComboBoxStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HighlightOuterRingRangeChoice}" Value="False">
                                                    <Setter Property="Opacity" Value="0.7" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ComboBox.Style>
                                </ComboBox>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Expander>
            </StackPanel>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</UserControl>
