<UserControl x:Class="DS4MapperTest.Views.TouchpadActionPropControls.TouchpadFlickStickPropControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:local="clr-namespace:DS4MapperTest.Views.TouchpadActionPropControls"
             xmlns:shared="clr-namespace:DS4MapperTest.Views.Shared"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel Margin="0,8,0,0">
        <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto">
            <StackPanel>

            <StackPanel x:Name="ExtraFieldsPanel">
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Label Content="Action Name" />
                    <TextBox Text="{Binding Name,UpdateSourceTrigger=LostFocus}" Width="180" Margin="8,0,0,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Hidden" />
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="MovementFieldsPanel">
                <Border Style="{StaticResource JsmccCardBorder}">
                    <StackPanel>
                        <TextBlock Text="Flick Stick" Style="{StaticResource JsmccCardTitle}" Margin="0,0,0,6"/>

                        <Border Style="{StaticResource JsmccSettingRowBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Flick Mode" Style="{StaticResource JsmccLabelText}"/>
                                <ComboBox Grid.Column="1" SelectedIndex="{Binding SelectedSubModeIndex}"
                                          Style="{StaticResource JsmccComboBoxStyle}"
                                          HorizontalAlignment="Left"
                                          MinWidth="180">
                                    <ComboBoxItem>Standard</ComboBoxItem>
                                    <ComboBoxItem>Flick Only</ComboBoxItem>
                                    <ComboBoxItem>Rotate Only</ComboBoxItem>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource JsmccSettingRowBorder}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Flick Threshold" Style="{StaticResource JsmccLabelText}"/>
                                <hc:NumericUpDown Grid.Column="1" Minimum="0" Maximum="1" DecimalPlaces="2" Increment="0.05"
                                                  Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                                  Value="{Binding FlickThreshold, UpdateSourceTrigger=LostFocus}"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource JsmccSettingRowBorder}"
                                Visibility="{Binding ShowFlickSettings, Converter={StaticResource Boolean2VisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Flick Time" Style="{StaticResource JsmccLabelText}"/>
                                <hc:NumericUpDown Grid.Column="1" Minimum="10" Maximum="1000" DecimalPlaces="0" Increment="10"
                                                  Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                                  Value="{Binding FlickTime, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Grid.Column="2" Text="ms" Style="{StaticResource JsmccMutedText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource JsmccSettingRowBorder}"
                                Visibility="{Binding ShowFlickSettings, Converter={StaticResource Boolean2VisibilityConverter}}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Flick Time Exponent" Style="{StaticResource JsmccLabelText}"/>
                                    <hc:NumericUpDown Grid.Column="1" Minimum="0" Maximum="1" DecimalPlaces="2" Increment="0.05"
                                                      Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                                      Value="{Binding FlickTimeExponent, UpdateSourceTrigger=LostFocus}"/>
                                </Grid>
                                <TextBlock Text="Flick Time is always the duration of a 180&#176; flick. At 0, every angle uses it; at 1, smaller flicks take proportionally less time."
                                           Style="{StaticResource JsmccMutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource JsmccSettingRowBorder}"
                                Visibility="{Binding ShowFlickSettings, Converter={StaticResource Boolean2VisibilityConverter}}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Snap Angle" Style="{StaticResource JsmccLabelText}"/>
                                    <ComboBox Grid.Column="1" SelectedIndex="{Binding SelectedSnapAngleIndex}"
                                              Style="{StaticResource JsmccComboBoxStyle}"
                                              HorizontalAlignment="Left"
                                              MinWidth="180">
                                        <ComboBoxItem>Off</ComboBoxItem>
                                        <ComboBoxItem>90&#176; (4 directions)</ComboBoxItem>
                                        <ComboBoxItem>45&#176; (8 directions)</ComboBoxItem>
                                    </ComboBox>
                                </Grid>
                                <Grid Margin="0,6,0,0" IsEnabled="{Binding SnapEnabled}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Snap Strength" Style="{StaticResource JsmccLabelText}"/>
                                    <hc:NumericUpDown Grid.Column="1" Minimum="0" Maximum="1" DecimalPlaces="2" Increment="0.05"
                                                      Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                                      Value="{Binding SnapStrength, UpdateSourceTrigger=LostFocus}"/>
                                </Grid>
                                <TextBlock Text="Snaps each new flick to the nearest of a fixed set of directions. Strength 1 snaps fully, 0 leaves the flick untouched, and values between bias towards the nearest direction. Sweeping a held touch is never snapped."
                                           Style="{StaticResource JsmccMutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource JsmccSettingRowBorder}"
                                Visibility="{Binding ShowFlickSettings, Converter={StaticResource Boolean2VisibilityConverter}}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Front Angle Deadzone" Style="{StaticResource JsmccLabelText}"/>
                                    <hc:NumericUpDown Grid.Column="1" Minimum="0" Maximum="180" DecimalPlaces="0" Increment="1"
                                                      Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                                      Value="{Binding FrontAngleDeadzone, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Column="2" Text="&#176;" Style="{StaticResource JsmccMutedText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="Cancels the initial flick-turn when it lands within this many degrees of forward, so you can push the stick up and start sweeping without an unwanted camera turn first. Does not affect the sweep itself."
                                           Style="{StaticResource JsmccMutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource JsmccSettingRowBorder}"
                                Visibility="{Binding ShowRotationSettings, Converter={StaticResource Boolean2VisibilityConverter}}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Release Dampening" Style="{StaticResource JsmccLabelText}"/>
                                <hc:NumericUpDown Grid.Column="1" Minimum="0" Maximum="10" DecimalPlaces="2" Increment="0.1"
                                                  Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                                  Value="{Binding ReleaseDampeningSpeed, UpdateSourceTrigger=LostFocus}"/>
                            </Grid>
                        </Border>

                        <Border Style="{StaticResource JsmccSettingRowBorder}"
                                Visibility="{Binding ShowRotationSettings, Converter={StaticResource Boolean2VisibilityConverter}}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Sweep Sensitivity" Style="{StaticResource JsmccLabelText}"/>
                                    <hc:NumericUpDown Grid.Column="1" Minimum="0" Maximum="6" DecimalPlaces="4" Increment="0.1"
                                                      ValueFormat="0.0###"
                                                      Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                                      Value="{Binding SweepSensitivity, UpdateSourceTrigger=LostFocus}"/>
                                    <TextBlock Grid.Column="2" Text="x" Style="{StaticResource JsmccMutedText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="Multiplier applied to the continuous sweep rotation as you rotate the stick around its outer edge. It does not affect the initial flick-turn. 1x is a natural 1:1 ratio; 0x disables sweeping."
                                           Style="{StaticResource JsmccMutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource JsmccSettingRowBorder}"
                                Visibility="{Binding ShowRotationSettings, Converter={StaticResource Boolean2VisibilityConverter}}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Sweep Rotation Smoothing" Style="{StaticResource JsmccLabelText}"/>
                                    <hc:NumericUpDown Grid.Column="1" Minimum="-1" Maximum="1" DecimalPlaces="2" Increment="0.01"
                                                      Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                                      Value="{Binding RotateSmoothOverride, UpdateSourceTrigger=LostFocus}"/>
                                </Grid>
                                <TextBlock Text="-1 uses automatic smoothing; 0 turns it off. Positive values override the small-angle threshold."
                                           Style="{StaticResource JsmccMutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="SensitivityFieldsPanel">
                <Border Style="{StaticResource JsmccCardBorder}">
                    <StackPanel>
                        <!-- Calibration block - synced across profile -->
                        <shared:CalibrationModeControl Margin="0"/>

                        <Border Style="{StaticResource JsmccSettingRowBorder}" Margin="0,12,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Multiplier Compensation" Style="{StaticResource JsmccLabelText}"/>
                                <CheckBox Grid.Column="1" IsChecked="{Binding MultiplierCompensation}"
                                          Style="{StaticResource JsmccToggleStyle}" VerticalAlignment="Center"/>
                            </Grid>
                        </Border>
                        <TextBlock Text="Divides out an in-game sensitivity multiplier so flick angles stay accurate."
                                   Style="{StaticResource JsmccMutedText}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,6"/>

                        <Border Style="{StaticResource JsmccSettingRowBorder}"
                                IsEnabled="{Binding MultiplierCompensation}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Acceleration Multiplier" Style="{StaticResource JsmccLabelText}"/>
                                <hc:NumericUpDown Grid.Column="1" Minimum="0.01" Maximum="100" DecimalPlaces="3" Increment="0.01"
                                                  Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                                  Value="{Binding AccelerationMultiplier, UpdateSourceTrigger=LostFocus}"/>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</UserControl>
