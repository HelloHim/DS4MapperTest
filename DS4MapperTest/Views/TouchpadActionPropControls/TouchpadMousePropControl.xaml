<UserControl x:Class="DS4MapperTest.Views.TouchpadActionPropControls.TouchpadMousePropControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:local="clr-namespace:DS4MapperTest.Views.TouchpadActionPropControls"
             xmlns:shared="clr-namespace:DS4MapperTest.Views.Shared"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel Margin="0,8,0,0">
        <ScrollViewer DockPanel.Dock="Top" VerticalScrollBarVisibility="Auto">
            <StackPanel>
            <StackPanel x:Name="ExtraFieldsPanel">
                <StackPanel Orientation="Horizontal">
                    <Label Content="Action Name" />
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" Width="180" Margin="8,0,0,0"
                             ScrollViewer.HorizontalScrollBarVisibility="Hidden">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource TextBoxBaseStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HighlightNameChanged}" Value="False">
                                        <Setter Property="Opacity" Value="0.7" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </StackPanel>
            </StackPanel>

            <StackPanel x:Name="MovementFieldsPanel">
            </StackPanel>

            <StackPanel x:Name="SensitivityFieldsPanel">
                <!-- Calibration block — synced across profile -->
                <shared:CalibrationModeControl />

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Label Content="Swipes per 360° (SC2)" />
                    <hc:NumericUpDown Minimum="0.0" Maximum="100.0" DecimalPlaces="4" Increment="0.001"
                                      Value="{Binding SwipesPer360, FallbackValue='1.0'}" Margin="8,0,0,0">
                        <hc:NumericUpDown.Style>
                            <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource NumericUpDownBaseStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HighlightSwipesPer360}" Value="False">
                                        <Setter Property="Opacity" Value="0.7" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </hc:NumericUpDown.Style>
                    </hc:NumericUpDown>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                    <Label Content="Legacy Sensitivity" ToolTip="Equivalent value in the original arbitrary sensitivity scale" />
                    <hc:NumericUpDown Minimum="0.0" Maximum="100000.0"
                                      Value="{Binding LegacySensitivity, UpdateSourceTrigger=LostFocus}"
                                      DecimalPlaces="4" Width="120" Margin="8,0,0,0"
                                      IsReadOnly="{Binding LegacySensitivityReadOnly}"
                                      PreviewKeyDown="LegacySensNUD_PreviewKeyDown">
                        <hc:NumericUpDown.Style>
                            <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource NumericUpDownBaseStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding LegacySensitivityEditable}" Value="False">
                                        <Setter Property="Opacity" Value="0.6" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </hc:NumericUpDown.Style>
                    </hc:NumericUpDown>
                    <CheckBox Content="Edit" IsChecked="{Binding LegacySensitivityEditable}"
                              VerticalAlignment="Center" Margin="8,0,0,0" />
                </StackPanel>

                <StackPanel Orientation="Vertical" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Opacity" Value="1.0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding VerticalScaleIsAbsoluteMode}" Value="False">
                                        <Setter Property="Opacity" Value="0.4" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <RadioButton GroupName="VerticalSensitivityMode"
                                     IsChecked="{Binding VerticalScaleIsAbsoluteMode, Mode=TwoWay}"
                                     VerticalAlignment="Center" />
                        <Label Content="Vertical Sp360" Margin="4,0,0,0" />
                        <hc:NumericUpDown Minimum="0.0" Maximum="100.0"
                                          DecimalPlaces="4" Increment="0.001"
                                          Value="{Binding VerticalRws, FallbackValue='1.0'}"
                                          IsEnabled="{Binding VerticalScaleIsAbsoluteMode}"
                                          Width="100" Margin="8,0,0,0">
                            <hc:NumericUpDown.Style>
                                <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource NumericUpDownBaseStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HighlightVerticalScale}" Value="False">
                                            <Setter Property="Opacity" Value="0.7" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:NumericUpDown.Style>
                        </hc:NumericUpDown>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Opacity" Value="1.0" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding VerticalScaleIsAbsoluteMode}" Value="True">
                                        <Setter Property="Opacity" Value="0.4" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <RadioButton GroupName="VerticalSensitivityMode"
                                     IsChecked="{Binding VerticalScaleIsMultiplierMode, Mode=TwoWay}"
                                     VerticalAlignment="Center" />
                        <Label Content="Vertical Scale" Margin="4,0,0,0" />
                        <hc:NumericUpDown Minimum="0.0" Maximum="10.0"
                                          DecimalPlaces="4" Increment="0.01"
                                          Value="{Binding VerticalScale, FallbackValue='1.0'}"
                                          IsEnabled="{Binding VerticalScaleIsMultiplierMode}"
                                          Width="100" Margin="8,0,0,0">
                            <hc:NumericUpDown.Style>
                                <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource NumericUpDownBaseStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HighlightVerticalScale}" Value="False">
                                            <Setter Property="Opacity" Value="0.7" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:NumericUpDown.Style>
                        </hc:NumericUpDown>
                    </StackPanel>
                </StackPanel>

                <Border Background="#187F7F7F" BorderBrush="#667F7F7F"
                        BorderThickness="1" CornerRadius="4" Padding="12"
                        Margin="0,8,16,0">
                    <StackPanel>
                        <TextBlock Text="Acceleration" FontWeight="SemiBold"
                                   Foreground="{DynamicResource JsmccTextStrongBrush}"
                                   Margin="4,0,0,4" />

                        <StackPanel Orientation="Horizontal">
                            <Label Content="Acceleration Curve" />
                            <ComboBox ItemsSource="{Binding AccelCurveChoiceItems}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="Choice"
                                      SelectedValue="{Binding AccelCurveChoice}"
                                      MinWidth="200" Margin="8,0,0,0" />
                        </StackPanel>

                        <Expander Header="Advanced Settings" IsExpanded="False"
                                  Margin="4,8,0,0"
                                  Visibility="{Binding AccelCurveUsed, Converter={StaticResource Boolean2VisibilityConverter}}">
                            <StackPanel Margin="12,8,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Min Sens X" />
                            <hc:NumericUpDown Minimum="0.0" Maximum="100.0"
                                              DecimalPlaces="3" Increment="0.1"
                                              Value="{Binding MinAccelXSens}"
                                              Width="100" Margin="8,0,0,0" />
                            <Label Content="Min Sens Y" Margin="16,0,0,0" />
                            <hc:NumericUpDown Minimum="0.0" Maximum="100.0"
                                              DecimalPlaces="3" Increment="0.1"
                                              Value="{Binding MinAccelYSens}"
                                              Width="100" Margin="8,0,0,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Label Content="Max Sens X" />
                            <hc:NumericUpDown Minimum="0.0" Maximum="100.0"
                                              DecimalPlaces="3" Increment="0.1"
                                              Value="{Binding MaxAccelXSens}"
                                              Width="100" Margin="8,0,0,0" />
                            <Label Content="Max Sens Y" Margin="16,0,0,0" />
                            <hc:NumericUpDown Minimum="0.0" Maximum="100.0"
                                              DecimalPlaces="3" Increment="0.1"
                                              Value="{Binding MaxAccelYSens}"
                                              Width="100" Margin="8,0,0,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Label Content="Min Movement Threshold" />
                            <hc:NumericUpDown Minimum="0.0" Maximum="10000.0"
                                              DecimalPlaces="2" Increment="0.5"
                                              Value="{Binding MinAccelThreshold}"
                                              Width="100" Margin="8,0,0,0" />
                            <StackPanel Orientation="Horizontal" Margin="16,0,0,0"
                                        Visibility="{Binding UsesMaxThreshold, Converter={StaticResource Boolean2VisibilityConverter}}">
                                <Label Content="Max Movement Threshold" />
                                <hc:NumericUpDown Minimum="0.0" Maximum="10000.0"
                                                  DecimalPlaces="2" Increment="0.5"
                                                  Value="{Binding MaxAccelThreshold}"
                                                  Width="100" Margin="8,0,0,0" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                    Visibility="{Binding NaturalCurveUsed, Converter={StaticResource Boolean2VisibilityConverter}}">
                            <Label Content="Natural vHalf" />
                            <hc:NumericUpDown Minimum="0.01" Maximum="10000.0"
                                              DecimalPlaces="2" Increment="0.5"
                                              Value="{Binding NaturalVHalf}"
                                              Width="100" Margin="8,0,0,0" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0"
                                    Visibility="{Binding PowerCurveUsed, Converter={StaticResource Boolean2VisibilityConverter}}">
                            <Label Content="Power vRef" />
                            <hc:NumericUpDown Minimum="0.01" Maximum="10000.0"
                                              DecimalPlaces="2" Increment="0.5"
                                              Value="{Binding PowerVRef}"
                                              Width="100" Margin="8,0,0,0" />
                            <Label Content="Power Exponent" Margin="16,0,0,0" />
                            <hc:NumericUpDown Minimum="0.01" Maximum="100.0"
                                              DecimalPlaces="2" Increment="0.1"
                                              Value="{Binding PowerExponent}"
                                              Width="100" Margin="8,0,0,0" />
                        </StackPanel>

                        <Button Content="Reset to Defaults"
                                Command="{Binding ResetAccelerationDefaultsComm}"
                                HorizontalAlignment="Left" Margin="0,8,0,0" />
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </Border>
            </StackPanel>

            <StackPanel x:Name="FilteringFieldsPanel">
                <StackPanel Orientation="Horizontal">
                    <Label Content="Dead Zone" />
                    <TextBox Text="{Binding DeadZone, UpdateSourceTrigger=LostFocus}" Width="100" Margin="8,0,0,0"
                         ToolTip="Expressed as raw delta units">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource TextBoxBaseStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HighlightDeadZone}" Value="False">
                                        <Setter Property="Opacity" Value="0.7" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Label Content="Vertical Dead Zone" />
                    <TextBox Text="{Binding VerticalDeadZone, UpdateSourceTrigger=LostFocus}" Width="100" Margin="8,0,0,0"
                         ToolTip="Suppresses vertical (Y) movement below this threshold. Expressed as raw delta units">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource TextBoxBaseStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HighlightVerticalDeadZone}" Value="False">
                                        <Setter Property="Opacity" Value="0.7" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Label Content="Angle Snapping" />
                    <hc:NumericUpDown Minimum="0.0" Maximum="45.0" DecimalPlaces="1" Increment="0.1"
                                      Value="{Binding TrackpadAngleSnapDegrees, FallbackValue='0.0'}"
                                      Width="100" Margin="8,0,0,0">
                        <hc:NumericUpDown.Style>
                            <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource NumericUpDownBaseStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HighlightTrackpadAngleSnapDegrees}" Value="False">
                                        <Setter Property="Opacity" Value="0.7" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </hc:NumericUpDown.Style>
                    </hc:NumericUpDown>
                    <Label Content="degrees" Margin="2,0,0,0" BorderBrush="{x:Null}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Label Content="Smooth Angle Snapping" />
                    <CheckBox IsChecked="{Binding TrackpadSmoothAngleSnap}" VerticalAlignment="Center"
                              Margin="8,0,0,0" Content="Off / On">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox" BasedOn="{StaticResource CheckBoxBaseStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HighlightTrackpadSmoothAngleSnap}" Value="False">
                                        <Setter Property="Opacity" Value="0.7" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <GroupBox MinWidth="200">
                        <GroupBox.Header>
                            <CheckBox IsChecked="{Binding SmoothingEnabled}"
                                      HorizontalAlignment="Left" HorizontalContentAlignment="Left">
                                Use Smoothing
                            </CheckBox>
                        </GroupBox.Header>

                        <StackPanel IsEnabled="{Binding SmoothingEnabled}">
                            <StackPanel Orientation="Horizontal">
                                <Label Content="Presets" />

                                <ComboBox ItemsSource="{Binding SmoothPresetChoiceItems}" DisplayMemberPath="DisplayName"
                                          SelectedValuePath="Choice" SelectedValue="{Binding SmoothPresetChoice}" MinWidth="100" Margin="8,0,0,0">
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <Label Content="1&#x20ac; MinCutoff" />
                                <hc:NumericUpDown Minimum="0.0" Maximum="10.0" DecimalPlaces="1" Increment="0.1"
                                  Value="{Binding SmoothingMinCutoff,FallbackValue='1.0'}" Margin="8,0,0,0">
                                    <hc:NumericUpDown.Style>
                                        <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource NumericUpDownBaseStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HighlightSmoothingFilter}" Value="False">
                                                    <Setter Property="Opacity" Value="0.7" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </hc:NumericUpDown.Style>
                                </hc:NumericUpDown>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <Label Content="1&#x20ac; Beta" />
                                <hc:NumericUpDown Minimum="0.0" Maximum="1.0" DecimalPlaces="1" Increment="0.1"
                                  Value="{Binding SmoothingBeta,FallbackValue='1.0'}" Margin="8,0,0,0">
                                    <hc:NumericUpDown.Style>
                                        <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource NumericUpDownBaseStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding HighlightSmoothingFilter}" Value="False">
                                                    <Setter Property="Opacity" Value="0.7" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </hc:NumericUpDown.Style>
                                </hc:NumericUpDown>
                            </StackPanel>

                        </StackPanel>
                    </GroupBox>
                </StackPanel>

                <GroupBox Header="Trackpad Stability" MinWidth="360" Margin="0,8,16,0">
                    <StackPanel Margin="8,4,8,8">
                        <TextBlock Text="Filters physical edge and corner jitter before normal deadzone, smoothing, acceleration, and output scaling. Off preserves the old path."
                                   TextWrapping="Wrap" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal">
                            <Label Content="Mode" />
                            <ComboBox ItemsSource="{Binding StabilityModeItems}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="ChoiceValue"
                                      SelectedValue="{Binding StabilityMode}"
                                      MinWidth="120" Margin="8,0,0,0" />
                        </StackPanel>

                        <Expander Header="Advanced Stability Settings"
                                  IsExpanded="{Binding StabilityAdvancedExpanded}" Margin="0,8,0,0">
                            <StackPanel Margin="12,8,0,0">
                                <TextBlock Text="Changing these values can switch the mode to Custom. Matching an existing preset switches the mode back to that preset."
                                           TextWrapping="Wrap" Margin="0,0,0,8" />
                                <StackPanel Orientation="Horizontal">
                                    <Label Content="Touch Start ms"
                                           ToolTip="Suppresses movement briefly after finger-down so unstable first samples cannot twitch the camera." />
                                    <hc:NumericUpDown Minimum="0" Maximum="30" DecimalPlaces="1" Increment="1"
                                                      Value="{Binding StabilityTouchSettleMs}" Width="90" Margin="8,0,0,0" />
                                    <Label Content="Base Noise" Margin="16,0,0,0"
                                           ToolTip="Raw coordinate movement below this floor is treated as touchpad sensor noise." />
                                    <hc:NumericUpDown Minimum="0" Maximum="100" DecimalPlaces="1" Increment="1"
                                                      Value="{Binding StabilityBaseNoiseFloor}" Width="90" Margin="8,0,0,0" />
                                    <Label Content="Exit Mult" Margin="16,0,0,0"
                                           ToolTip="Multiplier for leaving the locked state. Higher values require clearer movement before unlocking." />
                                    <hc:NumericUpDown Minimum="1" Maximum="3" DecimalPlaces="2" Increment="0.1"
                                                      Value="{Binding StabilityHysteresisExitMultiplier}" Width="90" Margin="8,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <CheckBox Content="Edge Guard" IsChecked="{Binding StabilityEdgeGuardEnabled}"
                                              ToolTip="Raises the noise floor near physical trackpad edges and corners." />
                                    <Label Content="Left %" Margin="16,0,0,0"
                                           ToolTip="Width of the left-edge guard zone as a percentage of the pad." />
                                    <hc:NumericUpDown Minimum="0" Maximum="30" DecimalPlaces="1" Increment="1"
                                                      Value="{Binding StabilityLeftEdgePercent}" Width="80" Margin="8,0,0,0" />
                                    <Label Content="Top %" Margin="16,0,0,0"
                                           ToolTip="Height of the top-edge guard zone as a percentage of the pad." />
                                    <hc:NumericUpDown Minimum="0" Maximum="30" DecimalPlaces="1" Increment="1"
                                                      Value="{Binding StabilityTopEdgePercent}" Width="80" Margin="8,0,0,0" />
                                    <Label Content="Top-left x" Margin="16,0,0,0"
                                           ToolTip="Extra noise multiplier when the touch is in the top-left corner." />
                                    <hc:NumericUpDown Minimum="1" Maximum="6" DecimalPlaces="1" Increment="0.1"
                                                      Value="{Binding StabilityTopLeftCornerMultiplier}" Width="80" Margin="8,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <CheckBox Content="Edge Start Gate" IsChecked="{Binding StabilityEdgeStartGateEnabled}"
                                              ToolTip="If a touch starts in an edge zone, hold output at zero until movement is clearly intentional." />
                                    <Label Content="Threshold" Margin="16,0,0,0"
                                           ToolTip="Distance needed to break out of the edge start gate." />
                                    <hc:NumericUpDown Minimum="0" Maximum="300" DecimalPlaces="1" Increment="5"
                                                      Value="{Binding StabilityEdgeStartThreshold}" Width="90" Margin="8,0,0,0" />
                                    <CheckBox Content="Edge Lock" IsChecked="{Binding StabilityEdgeLockEnabled}"
                                              Margin="16,0,0,0"
                                              ToolTip="Relocks quickly when movement pauses inside an edge zone." />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <CheckBox Content="Stationary Hold" IsChecked="{Binding StabilityStationaryHoldEnabled}"
                                              ToolTip="Applies stronger noise suppression after the thumb has been still briefly." />
                                    <Label Content="Detect ms" Margin="16,0,0,0"
                                           ToolTip="Time the thumb must remain quiet before stationary hold activates." />
                                    <hc:NumericUpDown Minimum="0" Maximum="200" DecimalPlaces="1" Increment="5"
                                                      Value="{Binding StabilityStationaryDetectionMs}" Width="90" Margin="8,0,0,0" />
                                    <Label Content="Noise x" Margin="16,0,0,0"
                                           ToolTip="Multiplier applied to the noise floor while stationary hold is active." />
                                    <hc:NumericUpDown Minimum="1" Maximum="4" DecimalPlaces="1" Increment="0.1"
                                                      Value="{Binding StabilityStationaryNoiseMultiplier}" Width="80" Margin="8,0,0,0" />
                                    <Label Content="Breakout" Margin="16,0,0,0"
                                           ToolTip="Movement required to leave stationary hold and resume normal movement." />
                                    <hc:NumericUpDown Minimum="0" Maximum="200" DecimalPlaces="1" Increment="1"
                                                      Value="{Binding StabilityStationaryBreakoutThreshold}" Width="90" Margin="8,0,0,0" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <CheckBox Content="Delta Clamp" IsChecked="{Binding StabilityDeltaClampEnabled}"
                                              ToolTip="Caps abnormal one-frame deltas as a safety net." />
                                    <Label Content="Max Delta" Margin="16,0,0,0"
                                           ToolTip="Maximum allowed per-frame coordinate delta when delta clamp is enabled." />
                                    <hc:NumericUpDown Minimum="10" Maximum="500" DecimalPlaces="1" Increment="10"
                                                      Value="{Binding StabilityMaxDeltaPerFrame}" Width="90" Margin="8,0,0,0" />
                                    <Label Content="Fast Pass" Margin="16,0,0,0"
                                           ToolTip="Movement above this threshold passes through quickly as intentional fast movement." />
                                    <hc:NumericUpDown Minimum="0" Maximum="200" DecimalPlaces="1" Increment="1"
                                                      Value="{Binding StabilityFastPassthroughThreshold}" Width="90" Margin="8,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Expander>
                    </StackPanel>
                </GroupBox>

            </StackPanel>

            <StackPanel x:Name="TrackballFieldsPanel">
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Label Content="Trackball" />
                    <CheckBox IsChecked="{Binding TrackballEnabled}" VerticalAlignment="Center" Margin="8,0,0,0">
                        <CheckBox.Style>
                            <Style TargetType="CheckBox" BasedOn="{StaticResource CheckBoxBaseStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HighlightTrackballEnabled}" Value="False">
                                        <Setter Property="Opacity" Value="0.7" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </CheckBox.Style>
                    </CheckBox>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <Label Content="Trackball Friction" />
                    <TextBox Text="{Binding TrackballFriction, UpdateSourceTrigger=LostFocus}" Width="100" Margin="8,0,0,0">
                        <TextBox.Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource TextBoxBaseStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HighlightTrackballFriction}" Value="False">
                                        <Setter Property="Opacity" Value="0.7" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </StackPanel>
            </StackPanel>

            </StackPanel>
        </ScrollViewer>

    </DockPanel>
</UserControl>
