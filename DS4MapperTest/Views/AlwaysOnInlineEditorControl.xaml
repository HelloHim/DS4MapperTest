<UserControl x:Class="DS4MapperTest.Views.AlwaysOnInlineEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="True">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border Background="{DynamicResource JsmccBg1Brush}"
            BorderBrush="{DynamicResource JsmccAccentBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="10"
            Margin="0,10,0,0">
        <DockPanel LastChildFill="True">
            <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,10">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock x:Name="TitleText"
                               Style="{StaticResource JsmccLabelText}"/>
                    <TextBlock Text="Always-On binding editor"
                               Style="{StaticResource JsmccMutedText}"
                               Margin="0,2,0,0"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Apply"
                            Click="ApplyButton_Click"
                            Style="{StaticResource JsmccButtonStyle}"
                            MinWidth="64"/>
                    <Button Content="Cancel"
                            Click="CancelButton_Click"
                            Style="{StaticResource JsmccButtonStyle}"
                            MinWidth="68"
                            Margin="8,0,0,0"/>
                    <Button Content="Unbind"
                            Click="UnbindButton_Click"
                            Style="{StaticResource JsmccDangerButtonStyle}"
                            MinWidth="72"
                            Margin="8,0,0,0"/>
                </StackPanel>
            </DockPanel>

            <StackPanel DockPanel.Dock="Top"
                        Orientation="Horizontal"
                        Margin="0,0,0,10">
                <TextBlock Text="Action Type"
                           Style="{StaticResource JsmccLabelText}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <ComboBox x:Name="TransformCombo"
                          SelectionChanged="TransformCombo_SelectionChanged"
                          Style="{StaticResource JsmccComboBoxStyle}"
                          MinWidth="160">
                    <ComboBoxItem Content="Unbound"/>
                    <ComboBoxItem Content="Function Button"/>
                </ComboBox>
            </StackPanel>

            <ContentControl x:Name="EditorHost"/>
        </DockPanel>
    </Border>
</UserControl>
