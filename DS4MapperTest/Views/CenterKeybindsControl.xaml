<UserControl x:Class="DS4MapperTest.Views.CenterKeybindsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:DS4MapperTest.Views"
             mc:Ignorable="d"
             d:DesignHeight="520"
             d:DesignWidth="860">
    <views:SharedButtonKeybindsControl
        SectionTitle="Center"
        Description="Regular Press maps to Normal Press. Add Hold, Double, Distance, Start, or Release bindings per system button."
        EmptyText="No center button bindings were found for the current controller."
        CardSubtitle="System button"
        ItemsSource="{Binding CenterButtonBindings}"/>
</UserControl>
