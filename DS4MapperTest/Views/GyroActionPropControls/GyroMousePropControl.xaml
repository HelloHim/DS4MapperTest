<UserControl x:Class="DS4MapperTest.Views.GyroActionPropControls.GyroMousePropControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DS4MapperTest.Views.GyroActionPropControls"
             xmlns:local1="clr-namespace:DS4MapperTest.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel>
        <local1:GyroActionSelectControl x:Name="gyroSelectControl" />

        <Border Style="{StaticResource JsmccSettingRowBorder}" Margin="0,8,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Name" Style="{StaticResource JsmccLabelText}"/>
                <TextBox Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=LostFocus}"
                         Style="{StaticResource JsmccTextBoxStyle}" Width="220" HorizontalAlignment="Left"/>
            </Grid>
        </Border>

        <Border Style="{StaticResource JsmccCardBorder}" Margin="0,12,0,0">
            <StackPanel>
                <TextBlock Text="Activation" Style="{StaticResource JsmccCardTitle}" Margin="0,0,0,6"/>
                <TextBlock Text="Choose which controller buttons arm the gyro, and how they combine."
                           Style="{StaticResource JsmccMutedText}" TextWrapping="Wrap" Margin="0,0,0,8"/>

                <TextBlock Text="Trigger Buttons" Style="{StaticResource JsmccLabelText}" Margin="0,0,0,4"/>
                <ItemsControl ItemsSource="{Binding TriggerButtonItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ToggleButton Content="{Binding DisplayString}"
                                          IsChecked="{Binding Enabled, Mode=TwoWay}"
                                          Style="{StaticResource JsmccChipToggleStyle}"
                                          Margin="0,0,6,6"/>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Border Style="{StaticResource JsmccSettingRowBorder}" Margin="0,6,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Selected Triggers" Style="{StaticResource JsmccLabelText}"/>
                        <TextBlock Grid.Column="1" Text="{Binding GyroTriggerString}" Style="{StaticResource JsmccBodyText}" TextWrapping="Wrap"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource JsmccSettingRowBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Trigger Condition" Style="{StaticResource JsmccLabelText}"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding GyroTriggerCondItems}" DisplayMemberPath="DisplayName"
                                  SelectedValuePath="ChoiceValue" SelectedValue="{Binding GyroTriggerCondChoice}"
                                  Style="{StaticResource JsmccComboBoxStyle}" MinWidth="120"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource JsmccSettingRowBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Trigger Activates (Ratchet)" Style="{StaticResource JsmccLabelText}"/>
                        <CheckBox Grid.Column="1" Style="{StaticResource JsmccToggleStyle}" IsChecked="{Binding GyroTriggerActivates}"/>
                    </Grid>
                </Border>
                <TextBlock Text="When on, the gyro stays active once triggered until the trigger condition is met again."
                           Style="{StaticResource JsmccMutedText}" TextWrapping="Wrap" Margin="0,4,0,0"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
