<UserControl x:Class="DS4MapperTest.Views.GyroActionPropControls.GyroMouseJoystickPropControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:local="clr-namespace:DS4MapperTest.Views.GyroActionPropControls"
             xmlns:local1="clr-namespace:DS4MapperTest.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel>
        <local1:GyroActionSelectControl x:Name="gyroSelectControl" />

        <Border x:Name="activationSettings"
                Style="{StaticResource JsmccCardBorder}"
                Margin="0,12,0,0">
            <StackPanel>
                <Border Style="{StaticResource JsmccSettingRowBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Activation Mode" Style="{StaticResource JsmccLabelText}"/>
                        <ComboBox Grid.Column="1" ItemsSource="{Binding GyroActivationModeItems}" DisplayMemberPath="DisplayName"
                                  SelectedValuePath="ChoiceValue" SelectedValue="{Binding GyroActivationModeChoice}"
                                  Style="{StaticResource JsmccComboBoxStyle}" MinWidth="150"/>
                    </Grid>
                </Border>

                <StackPanel Visibility="{Binding GyroActivationButtonsUsed, Converter={StaticResource Boolean2VisibilityConverter}}">
                    <TextBlock Text="Activation Buttons" Style="{StaticResource JsmccLabelText}" Margin="0,4,0,4"/>
                    <ItemsControl ItemsSource="{Binding ActivationButtonItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Content="{Binding DisplayString}"
                                              IsChecked="{Binding Enabled, Mode=TwoWay}"
                                              Style="{StaticResource JsmccChipToggleStyle}"
                                              Margin="0,0,6,6"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource JsmccSettingRowBorder}" Margin="0,6,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0"
                                       Text="Multiple Gyro Button Behaviour"
                                       Style="{StaticResource JsmccLabelText}"
                                       Margin="0,0,14,0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <RadioButton Content="Any selected"
                                             IsChecked="{Binding GyroTriggerAnySelected, Mode=TwoWay}"
                                             Style="{StaticResource CalibModeToggleStyle}"
                                             Margin="0,0,6,0"/>
                                <RadioButton Content="All selected"
                                             IsChecked="{Binding GyroTriggerAllSelected, Mode=TwoWay}"
                                             Style="{StaticResource CalibModeToggleStyle}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource JsmccSettingRowBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Activation Hold Time" Style="{StaticResource JsmccLabelText}" Margin="0,0,14,0"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <hc:NumericUpDown Minimum="0" Maximum="60000" Increment="10" DecimalPlaces="0" Width="108" Style="{StaticResource JsmccNumericUpDownStyle}" Value="{Binding GyroActivationHoldMs, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Text="ms" Style="{StaticResource JsmccMutedText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
