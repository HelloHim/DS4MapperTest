<UserControl x:Class="DS4MapperTest.Views.StickActionPropControls.StickMousePropControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:local="clr-namespace:DS4MapperTest.Views.StickActionPropControls"
             xmlns:local1="clr-namespace:DS4MapperTest.Views"
             xmlns:shared="clr-namespace:DS4MapperTest.Views.Shared"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="boolVisConv" />
    </UserControl.Resources>
    
    <DockPanel>
        <StackPanel DockPanel.Dock="Top">
            <local1:StickActionSelectControl x:Name="stickSelectControl" DockPanel.Dock="Top" />

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Label Content="Name" />
                <TextBox Text="{Binding Name,UpdateSourceTrigger=LostFocus}" Width="200" Margin="8,0,0,0">
                    <TextBox.Style>
                        <Style TargetType="TextBox" BasedOn="{StaticResource TextBoxBaseStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HighlightName}" Value="False">
                                    <Setter Property="Opacity" Value="0.7" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </StackPanel>

            <shared:CalibrationModeControl Margin="0,8,0,0"/>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Label Content="Joystick Mouse Sensitivity" ToolTip="Sets the camera rotation speed at full stick deflection. Angle calibration keeps the speed consistent across games and in-game sensitivities." />
                <hc:NumericUpDown Minimum="0" Maximum="7200" Value="{Binding DegreesPerSecond}" DecimalPlaces="1"
                                  Increment="10" Width="100" Margin="8,0,0,0">
                    <hc:NumericUpDown.Style>
                        <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource NumericUpDownBaseStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HighlightDegreesPerSecond}" Value="False">
                                    <Setter Property="Opacity" Value="0.7" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </hc:NumericUpDown.Style>
                </hc:NumericUpDown>
                <TextBlock Text="&#176;/s" Margin="8,0,0,0" Foreground="{StaticResource DefaultBrush}" VerticalAlignment="Center" />
            </StackPanel>

            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <RadioButton Grid.Row="0" Grid.Column="0"
                             IsChecked="{Binding VerticalScaleIsMultiplierMode, Mode=TwoWay}"
                             VerticalAlignment="Center" Content="Vertical Scale">
                    <RadioButton.Style>
                        <Style TargetType="RadioButton">
                            <Setter Property="Opacity" Value="1.0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding VerticalScaleIsMultiplierMode}" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HighlightVerticalScale}" Value="False">
                                    <Setter Property="Opacity" Value="0.7" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </RadioButton.Style>
                </RadioButton>
                <hc:NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="0.0" Maximum="10.0" Value="{Binding VerticalScale}" DecimalPlaces="4"
                                  Increment="0.1" Width="100" Margin="8,0,0,0" ValueFormat="0.0###" IsEnabled="{Binding VerticalScaleIsMultiplierMode}">
                    <hc:NumericUpDown.Style>
                        <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource NumericUpDownBaseStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HighlightVerticalScale}" Value="False">
                                    <Setter Property="Opacity" Value="0.7" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </hc:NumericUpDown.Style>
                </hc:NumericUpDown>

                <RadioButton Grid.Row="1" Grid.Column="0" Margin="0,6,0,0"
                             IsChecked="{Binding VerticalScaleIsAbsoluteMode, Mode=TwoWay}"
                             VerticalAlignment="Center" Content="Vertical Sensitivity">
                    <RadioButton.Style>
                        <Style TargetType="RadioButton">
                            <Setter Property="Opacity" Value="1.0"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding VerticalScaleIsAbsoluteMode}" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HighlightVerticalScale}" Value="False">
                                    <Setter Property="Opacity" Value="0.7" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </RadioButton.Style>
                </RadioButton>
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="8,6,0,0" Orientation="Horizontal">
                    <hc:NumericUpDown Minimum="0" Maximum="7200" Value="{Binding VerticalDegreesPerSecond}" DecimalPlaces="1"
                                      Increment="10" Width="100" IsEnabled="{Binding VerticalScaleIsAbsoluteMode}">
                        <hc:NumericUpDown.Style>
                            <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource NumericUpDownBaseStyle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HighlightVerticalScale}" Value="False">
                                        <Setter Property="Opacity" Value="0.7" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </hc:NumericUpDown.Style>
                    </hc:NumericUpDown>
                    <TextBlock Text="&#176;/s" Margin="8,0,0,0" Foreground="{StaticResource DefaultBrush}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Label Content="Dead Zone" ToolTip="Used when Split Axes is off." />
                <hc:NumericUpDown Minimum="0.0" Maximum="1.0" Value="{Binding DeadZone}" DecimalPlaces="2"
                                  Increment="0.05" Width="100" Margin="8,0,0,0">
                    <hc:NumericUpDown.Style>
                        <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource NumericUpDownBaseStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HighlightDeadZone}" Value="False">
                                    <Setter Property="Opacity" Value="0.7" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding SeparateAxisDeadZones}" Value="True">
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Setter Property="Opacity" Value="0.5"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </hc:NumericUpDown.Style>
                </hc:NumericUpDown>
                <Label Content="Split Axes" Margin="16,0,0,0" VerticalAlignment="Center"/>
                <CheckBox IsChecked="{Binding SeparateAxisDeadZones}" VerticalAlignment="Center" Margin="8,0,0,0">
                    <CheckBox.Style>
                        <Style TargetType="CheckBox" BasedOn="{StaticResource CheckBoxBaseStyle}"/>
                    </CheckBox.Style>
                </CheckBox>
            </StackPanel>

            <Grid Margin="0,8,0,0" Visibility="{Binding SeparateAxisDeadZones, Converter={StaticResource boolVisConv}}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Label Grid.Column="0" Content="Horizontal Dead Zone" />
                <hc:NumericUpDown Grid.Column="1" Minimum="0.0" Maximum="1.0" Value="{Binding DeadZoneX}" DecimalPlaces="2"
                                  Increment="0.05" Width="100" Margin="8,0,0,0">
                    <hc:NumericUpDown.Style>
                        <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource NumericUpDownBaseStyle}"/>
                    </hc:NumericUpDown.Style>
                </hc:NumericUpDown>
                <Label Grid.Column="2" Content="Vertical Dead Zone" Margin="16,0,0,0" />
                <hc:NumericUpDown Grid.Column="3" Minimum="0.0" Maximum="1.0" Value="{Binding DeadZoneY}" DecimalPlaces="2"
                                  Increment="0.05" Width="100" Margin="8,0,0,0">
                    <hc:NumericUpDown.Style>
                        <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource NumericUpDownBaseStyle}"/>
                    </hc:NumericUpDown.Style>
                </hc:NumericUpDown>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Label Content="Diagonal Range" />
                <hc:NumericUpDown Minimum="0" Maximum="90" Value="{Binding DiagonalRange}" DecimalPlaces="0"
                                  Increment="1" Width="100" Margin="8,0,0,0">
                    <hc:NumericUpDown.Style>
                        <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource NumericUpDownBaseStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HighlightDiagonalRange}" Value="False">
                                    <Setter Property="Opacity" Value="0.7" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </hc:NumericUpDown.Style>
                </hc:NumericUpDown>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Label Content="Output Curve" />
                <ComboBox ItemsSource="{Binding OutputCurveChoiceItems}" DisplayMemberPath="DisplayName" SelectedValuePath="ChoiceValue"
                          SelectedValue="{Binding OutputCurveChoice}" MinWidth="200" Margin="8,0,0,0">
                    <ComboBox.Style>
                        <Style TargetType="ComboBox" BasedOn="{StaticResource ComboBoxBaseStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HighlightOutputCurveChoice}" Value="False">
                                    <Setter Property="Opacity" Value="0.7" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ComboBox.Style>
                </ComboBox>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Expander ExpandDirection="Down" Header="Delta Mouse" IsExpanded="False">
                    <StackPanel Orientation="Vertical">
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Label Content="Enabled" />
                            <CheckBox IsChecked="{Binding DeltaEnabled}" VerticalAlignment="Center" Margin="8,0,0,0">
                                <CheckBox.Style>
                                    <Style TargetType="CheckBox" BasedOn="{StaticResource CheckBoxBaseStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HighlightDelta}" Value="False">
                                                <Setter Property="Opacity" Value="0.7" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </CheckBox.Style>
                            </CheckBox>
                        </StackPanel>

                        <TextBlock Text="Speeds up mouse output as the stick moves farther from centre."
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,8"/>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Label Content="Multiplier" />
                            <hc:NumericUpDown Minimum="1.0" Maximum="20.0" Value="{Binding DeltaMultiplier}" DecimalPlaces="2"
                                  Increment="1.0" Width="100" Margin="8,0,0,0">
                                <hc:NumericUpDown.Style>
                                    <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource NumericUpDownBaseStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HighlightDelta}" Value="False">
                                                <Setter Property="Opacity" Value="0.7" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </hc:NumericUpDown.Style>
                            </hc:NumericUpDown>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Label Content="Min Travel" />
                            <hc:NumericUpDown Minimum="0.01" Maximum="1.0" Value="{Binding DeltaMinTravel}" DecimalPlaces="2"
                                  Increment="0.1" Width="100" Margin="8,0,0,0">
                                <hc:NumericUpDown.Style>
                                    <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource NumericUpDownBaseStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HighlightDelta}" Value="False">
                                                <Setter Property="Opacity" Value="0.7" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </hc:NumericUpDown.Style>
                            </hc:NumericUpDown>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Label Content="Max Travel" />
                            <hc:NumericUpDown Minimum="0.01" Maximum="1.0" Value="{Binding DeltaMaxTravel}" DecimalPlaces="2"
                                  Increment="0.1" Width="100" Margin="8,0,0,0">
                                <hc:NumericUpDown.Style>
                                    <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource NumericUpDownBaseStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HighlightDelta}" Value="False">
                                                <Setter Property="Opacity" Value="0.7" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </hc:NumericUpDown.Style>
                            </hc:NumericUpDown>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Label Content="Easing Duration" />
                            <hc:NumericUpDown Minimum="0.01" Maximum="10.0" Value="{Binding DeltaEasingDuration}" DecimalPlaces="2"
                                  Increment="0.1" Width="100" Margin="8,0,0,0">
                                <hc:NumericUpDown.Style>
                                    <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource NumericUpDownBaseStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HighlightDelta}" Value="False">
                                                <Setter Property="Opacity" Value="0.7" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </hc:NumericUpDown.Style>
                            </hc:NumericUpDown>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Label Content="Min Factor" />
                            <hc:NumericUpDown Minimum="0.01" Maximum="10.0" Value="{Binding DeltaMinFactor}" DecimalPlaces="2"
                                  Increment="0.1" Width="100" Margin="8,0,0,0">
                                <hc:NumericUpDown.Style>
                                    <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource NumericUpDownBaseStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HighlightDelta}" Value="False">
                                                <Setter Property="Opacity" Value="0.7" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </hc:NumericUpDown.Style>
                            </hc:NumericUpDown>
                        </StackPanel>

                    </StackPanel>

                </Expander>
            </StackPanel>
            

        </StackPanel>
    </DockPanel>
</UserControl>

