<UserControl x:Class="DS4MapperTest.Views.StickActionPropControls.StickFlickStickPropControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:local="clr-namespace:DS4MapperTest.Views.StickActionPropControls"
             xmlns:local1="clr-namespace:DS4MapperTest.Views"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <DockPanel Margin="0,8,0,0">
        <StackPanel DockPanel.Dock="Top">
            <local1:StickActionSelectControl x:Name="stickSelectControl" DockPanel.Dock="Top" />

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Label Content="Name" />
                <TextBox Text="{Binding Name,UpdateSourceTrigger=LostFocus}" Width="200" Margin="8,0,0,0" />
            </StackPanel>

            <!-- Calibration block — synced across profile -->
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Label Content="Real World Calibration" />
                <hc:NumericUpDown Minimum="0.0" Maximum="27777.7778" Value="{Binding RealWorldCalibration}" DecimalPlaces="4"
                                  Increment="0.5" Width="100" Margin="8,0,0,0" VerticalAlignment="Center">
                    <hc:NumericUpDown.Style>
                        <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource NumericUpDownBaseStyle}" />
                    </hc:NumericUpDown.Style>
                </hc:NumericUpDown>

                <ComboBox ItemsSource="{Binding GamePresets}" SelectedItem="{Binding SelectedPreset}"
                          DisplayMemberPath="Name" Width="180" Margin="8,0,0,0" VerticalAlignment="Center" />

                <StackPanel Orientation="Vertical" Margin="16,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <Label Content="Counts / 360°" />
                        <hc:NumericUpDown Minimum="1.0" Maximum="999999.9999" Value="{Binding FullTurnCounts}" DecimalPlaces="4"
                                          Increment="10.0" Width="100" Margin="8,0,0,0">
                        </hc:NumericUpDown>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                        <hc:NumericUpDown Minimum="0.001" Maximum="27777.7778" Value="{Binding CalculatedRWC}" DecimalPlaces="4"
                                          Increment="10.0" Width="100" IsReadOnly="True" HorizontalAlignment="Left">
                        </hc:NumericUpDown>

                        <Label Content="RWC" BorderBrush="{x:Null}" Margin="2,0,0,0" />

                        <Button Content="Copy Test Value" Command="{Binding CopyTestRWCComm}" Margin="16,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Label Content="In Game Sens" />
                <hc:NumericUpDown Minimum="0.001" Maximum="1000000.0" Value="{Binding InGameSens}" DecimalPlaces="3"
                                  Increment="0.01" Width="100" Margin="8,0,0,0">
                    <hc:NumericUpDown.Style>
                        <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource NumericUpDownBaseStyle}" />
                    </hc:NumericUpDown.Style>
                </hc:NumericUpDown>
            </StackPanel>

            <TextBlock Text="Synced across profile" FontSize="11" Foreground="Gray" Margin="0,4,0,0" />

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Label Content="Flick Threshold" />
                <hc:NumericUpDown Minimum="0.0" Maximum="1.0" Value="{Binding FlickThreshold}" DecimalPlaces="2"
      Increment="0.05" Width="100" Margin="8,0,0,0">
                    <hc:NumericUpDown.Style>
                        <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource NumericUpDownBaseStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HighlightFlickThreshold}" Value="False">
                                    <Setter Property="Opacity" Value="0.7" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </hc:NumericUpDown.Style>
                </hc:NumericUpDown>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Label Content="Flick Time" />
                <hc:NumericUpDown Minimum="0" Maximum="2000" Value="{Binding FlickTime}" DecimalPlaces="0"
                                  Increment="50" Width="100" Margin="8,0,0,0">
                    <hc:NumericUpDown.Style>
                        <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource NumericUpDownBaseStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HighlightFlickTime}" Value="False">
                                    <Setter Property="Opacity" Value="0.7" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </hc:NumericUpDown.Style>
                </hc:NumericUpDown>

                <Label Content="ms" Margin="2,0,0,0" BorderBrush="{x:Null}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Label Content="Flick Time Exponent" />
                <hc:NumericUpDown Minimum="0.00" Maximum="1.00" Value="{Binding FlickTimeExponent}" DecimalPlaces="2"
                                  Increment="0.1" Width="100" Margin="8,0,0,0">
                    <hc:NumericUpDown.Style>
                        <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource NumericUpDownBaseStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HighlightFlickTimeExponent}" Value="False">
                                    <Setter Property="Opacity" Value="0.7" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </hc:NumericUpDown.Style>
                </hc:NumericUpDown>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Label Content="Min Angle Threshold" />
                <hc:NumericUpDown Minimum="0.0" Maximum="360.0" Value="{Binding MinAngleThreshold}" DecimalPlaces="2"
Increment="1.0" Width="100" Margin="8,0,0,0">
                    <hc:NumericUpDown.Style>
                        <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource NumericUpDownBaseStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HighlightMinAngleThreshold}" Value="False">
                                    <Setter Property="Opacity" Value="0.7" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </hc:NumericUpDown.Style>
                </hc:NumericUpDown>

                <Label Content="&#xB0;" Margin="2,0,0,0" BorderBrush="{x:Null}" />
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Label Content="Release Dampening Speed" />
                <hc:NumericUpDown Minimum="0.0" Maximum="10.0" Value="{Binding ReleaseDampeningSpeed}" DecimalPlaces="2"
                                  Increment="0.25" Width="100" Margin="8,0,0,0">
                    <hc:NumericUpDown.Style>
                        <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource NumericUpDownBaseStyle}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HighlightReleaseDampeningSpeed}" Value="False">
                                    <Setter Property="Opacity" Value="0.7" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </hc:NumericUpDown.Style>
                </hc:NumericUpDown>

                <Label Content="u/s" Margin="2,0,0,0" BorderBrush="{x:Null}" />
            </StackPanel>

        </StackPanel>
    </DockPanel>
</UserControl>
