<UserControl x:Class="DS4MapperTest.Views.OutputBindingEditorControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:local="clr-namespace:DS4MapperTest.Views"
             xmlns:shared="clr-namespace:DS4MapperTest.Views.Shared"
             mc:Ignorable="d"
             d:DesignHeight="450"
             d:DesignWidth="800">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <Style x:Key="EditorFieldLabel" TargetType="TextBlock" BasedOn="{StaticResource JsmccLabelText}">
            <Setter Property="MinWidth" Value="92"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </UserControl.Resources>

    <DockPanel>
        <Button DockPanel.Dock="Bottom"
                Content="Done"
                Width="100"
                Margin="0,10,0,0"
                HorizontalAlignment="Left"
                Click="Button_Click"
                Style="{StaticResource JsmccButtonStyle}"
                Visibility="{Binding ShowDoneButton, RelativeSource={RelativeSource AncestorType=local:OutputBindingEditorControl}, Converter={StaticResource BoolToVis}}"/>

        <Border DockPanel.Dock="Top"
                Background="{DynamicResource JsmccBgInputBrush}"
                BorderBrush="{DynamicResource JsmccBorderBrush}"
                BorderThickness="1"
                CornerRadius="5"
                Padding="8"
                Margin="0,0,0,8">
            <WrapPanel>
                <TextBlock Text="Output Slot" Style="{StaticResource EditorFieldLabel}"/>
                <ComboBox ItemsSource="{Binding SlotItems}"
                          SelectedIndex="{Binding SelectedSlotItemIndex}"
                          DisplayMemberPath="DisplayName"
                          MinWidth="118"
                          Style="{StaticResource JsmccComboBoxStyle}"
                          Margin="0,0,8,4"/>
                <Button x:Name="addOutputSlot"
                        Content="Add +"
                        Click="AddOutputSlot_Click"
                        Style="{StaticResource JsmccButtonStyle}"
                        MinWidth="70"
                        Margin="0,0,8,4"/>
                <Button x:Name="removeOutputSlot"
                        Content="Remove -"
                        Click="RemoveOutputSlot_Click"
                        IsEnabled="{Binding HasMultipleSlots}"
                        Style="{StaticResource JsmccButtonStyle}"
                        MinWidth="88"
                        Margin="0,0,8,4"/>
                <Button x:Name="unboundBtn"
                        Content="Unbound"
                        Click="UnboundBtn_Click"
                        Style="{StaticResource JsmccButtonStyle}"
                        MinWidth="86"
                        Margin="0,0,8,4"/>
            </WrapPanel>
        </Border>

        <TabControl Style="{StaticResource JsmccPillTabControlStyle}"
                    SelectionChanged="OutputTypeTabControl_SelectionChanged">
            <TabItem Header="Gamepad">
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <TextBlock Text="Output" Style="{StaticResource EditorFieldLabel}"/>
                    <ComboBox ItemsSource="{Binding GamepadComboItems}"
                              SelectedIndex="{Binding SelectedIndex, FallbackValue='0'}"
                              DisplayMemberPath="DisplayName"
                              MinWidth="180"
                              Style="{StaticResource JsmccComboBoxStyle}"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Keyboard">
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <TextBlock Text="Key" Style="{StaticResource EditorFieldLabel}"/>
                    <ComboBox ItemsSource="{Binding KeyboardComboItems}"
                              SelectedIndex="{Binding SelectedKeyboardIndex, FallbackValue='0'}"
                              DisplayMemberPath="DisplayName"
                              MinWidth="180"
                              Style="{StaticResource JsmccComboBoxStyle}"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Mouse Buttons">
                <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                    <TextBlock Text="Button" Style="{StaticResource EditorFieldLabel}"/>
                    <ComboBox ItemsSource="{Binding MouseButtonComboItems}"
                              SelectedIndex="{Binding SelectedMouseButtonIndex, FallbackValue='0'}"
                              DisplayMemberPath="DisplayName"
                              MinWidth="180"
                              Style="{StaticResource JsmccComboBoxStyle}"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Mouse Wheel">
                <StackPanel Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Wheel" Style="{StaticResource EditorFieldLabel}"/>
                        <ComboBox ItemsSource="{Binding MouseWheelButtonComboItems}"
                                  SelectedIndex="{Binding SelectedMouseWheelButtonIndex, FallbackValue='0'}"
                                  DisplayMemberPath="DisplayName"
                                  MinWidth="180"
                                  Style="{StaticResource JsmccComboBoxStyle}"/>
                    </StackPanel>
                    <WrapPanel Margin="0,8,0,0"
                               Visibility="{Binding ShowWheelTickOptions, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Tick Time" Style="{StaticResource EditorFieldLabel}"/>
                        <CheckBox IsChecked="{Binding TickTimeEnabled}"
                                  Style="{StaticResource JsmccToggleStyle}"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,4"/>
                        <hc:NumericUpDown Minimum="0.0"
                                          Maximum="1000.0"
                                          DecimalPlaces="1"
                                          Increment="10"
                                          Value="{Binding TickTime,FallbackValue='100.0'}"
                                          Width="118"
                                          Style="{StaticResource JsmccNumericUpDownStyle}"
                                          Margin="0,0,8,4"/>
                        <TextBlock Text="ms"
                                   Style="{StaticResource JsmccMutedText}"
                                   VerticalAlignment="Center"/>
                    </WrapPanel>
                </StackPanel>
            </TabItem>

            <TabItem Header="Mouse Move">
                <StackPanel Margin="0,10,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Direction" Style="{StaticResource EditorFieldLabel}"/>
                        <ComboBox ItemsSource="{Binding MouseDirComboItems}"
                                  SelectedIndex="{Binding SelectedMouseDirIndex, FallbackValue='0'}"
                                  DisplayMemberPath="DisplayName"
                                  MinWidth="180"
                                  Style="{StaticResource JsmccComboBoxStyle}"/>
                    </StackPanel>
                    <WrapPanel Margin="0,8,0,0"
                               Visibility="{Binding ShowMouseDirOptions, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="Mouse X" Style="{StaticResource EditorFieldLabel}"/>
                        <hc:NumericUpDown Minimum="0.0"
                                          Maximum="1000.0"
                                          DecimalPlaces="0"
                                          Increment="10"
                                          Value="{Binding MouseXSpeed,FallbackValue='50'}"
                                          Width="96"
                                          Style="{StaticResource JsmccNumericUpDownStyle}"
                                          Margin="0,0,8,4"/>
                        <TextBlock Text="{Binding MouseXSpeedOutput, Mode=OneWay, StringFormat='{}{0} pps'}"
                                   Style="{StaticResource JsmccMutedText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,4"/>
                        <TextBlock Text="Mouse Y" Style="{StaticResource EditorFieldLabel}"/>
                        <hc:NumericUpDown Minimum="0.0"
                                          Maximum="1000.0"
                                          DecimalPlaces="0"
                                          Increment="10"
                                          Value="{Binding MouseYSpeed,FallbackValue='50'}"
                                          Width="96"
                                          Style="{StaticResource JsmccNumericUpDownStyle}"
                                          Margin="0,0,8,4"/>
                        <TextBlock Text="{Binding MouseYSpeedOutput, Mode=OneWay, StringFormat='{}{0} pps'}"
                                   Style="{StaticResource JsmccMutedText}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,0,4"/>
                    </WrapPanel>
                </StackPanel>
            </TabItem>

            <TabItem x:Name="flickTurnBindTab"
                     Header="Flick Turn Bind">
                <StackPanel Margin="0,10,0,0">
                    <Border Background="{DynamicResource JsmccBgInputBrush}"
                            BorderBrush="{DynamicResource JsmccBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="8"
                            Margin="0"
                            Visibility="{Binding ShowCameraTurnOptions, Mode=OneWay, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <WrapPanel>
                                <TextBlock Text="Angle" Style="{StaticResource EditorFieldLabel}"/>
                                <hc:NumericUpDown Minimum="-180.0"
                                                  Maximum="180.0"
                                                  DecimalPlaces="1"
                                                  Increment="1.0"
                                                  Value="{Binding CameraTurnAngle, FallbackValue='180.0'}"
                                                  Width="100"
                                                  Style="{StaticResource JsmccNumericUpDownStyle}"
                                                  Margin="0,0,8,4"/>
                                <TextBlock Text="Duration" Style="{StaticResource EditorFieldLabel}"/>
                                <hc:NumericUpDown Minimum="1.0"
                                                  Maximum="10000.0"
                                                  DecimalPlaces="0"
                                                  Increment="10.0"
                                                  Value="{Binding CameraTurnDurationMs, FallbackValue='100.0'}"
                                                  Width="118"
                                                  Style="{StaticResource JsmccNumericUpDownStyle}"
                                                  Margin="0,0,8,4"/>
                                <TextBlock Text="ms"
                                           Style="{StaticResource JsmccMutedText}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,4"/>
                            </WrapPanel>
                            <shared:CalibrationModeControl Margin="0,8,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </TabItem>

            <TabItem Header="Layer Ops">
                <WrapPanel Margin="0,10,0,0">
                    <TextBlock Text="Operation" Style="{StaticResource EditorFieldLabel}"/>
                    <ComboBox ItemsSource="{Binding LayerOperationsComboItems}"
                              SelectedIndex="{Binding SelectedLayerOpsIndex, FallbackValue='0'}"
                              DisplayMemberPath="DisplayName"
                              MinWidth="160"
                              Style="{StaticResource JsmccComboBoxStyle}"
                              Margin="0,0,8,4"/>
                    <ComboBox ItemsSource="{Binding AvailableLayerComboItems}"
                              SelectedIndex="{Binding SelectedLayerChoiceIndex, FallbackValue='0'}"
                              DisplayMemberPath="DisplayName"
                              MinWidth="160"
                              Style="{StaticResource JsmccComboBoxStyle}"
                              Visibility="{Binding ShowAvailableLayers, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                              Margin="0,0,8,4"/>
                    <ComboBox SelectedIndex="{Binding SelectedLayerChangeConditionIndex, FallbackValue='0'}"
                              MinWidth="130"
                              Style="{StaticResource JsmccComboBoxStyle}"
                              Visibility="{Binding ShowLayerChangeConditions, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                              Margin="0,0,8,4">
                        <ComboBoxItem>None</ComboBoxItem>
                        <ComboBoxItem>Pressed</ComboBoxItem>
                        <ComboBoxItem>Released</ComboBoxItem>
                    </ComboBox>
                </WrapPanel>
            </TabItem>

            <TabItem Header="Switch Sets">
                <WrapPanel Margin="0,10,0,0">
                    <TextBlock Text="Set" Style="{StaticResource EditorFieldLabel}"/>
                    <ComboBox ItemsSource="{Binding AvailableSetsComboItems}"
                              SelectedIndex="{Binding SelectedSetChoiceIndex, FallbackValue='0'}"
                              DisplayMemberPath="DisplayName"
                              MinWidth="160"
                              Style="{StaticResource JsmccComboBoxStyle}"
                              Margin="0,0,8,4"/>
                    <ComboBox SelectedIndex="{Binding SelectedSetChangeConditionIndex, FallbackValue='0'}"
                              MinWidth="130"
                              Style="{StaticResource JsmccComboBoxStyle}"
                              Visibility="{Binding ShowAvailableSets, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                              Margin="0,0,8,4">
                        <ComboBoxItem>None</ComboBoxItem>
                        <ComboBoxItem>Pressed</ComboBoxItem>
                        <ComboBoxItem>Released</ComboBoxItem>
                    </ComboBox>
                </WrapPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</UserControl>
