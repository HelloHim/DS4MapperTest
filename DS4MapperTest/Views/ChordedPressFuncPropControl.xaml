<UserControl x:Class="DS4MapperTest.Views.ChordedPressFuncPropControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:DS4MapperTest.Views"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">
    <StackPanel>
        <StackPanel Orientation="Horizontal">
            <Label Content="Name" />
            <TextBox Text="{Binding Name}" Width="100" Margin="8,0,0,0" />
        </StackPanel>
        <local:ButtonActionFuncSelectControl x:Name="funcTypeControl" Margin="0,8,0,0" />
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Label Content="Trigger" />
            <ComboBox ItemsSource="{Binding TriggerItems}"
                      SelectedValue="{Binding TriggerButton}"
                      SelectedValuePath="Code"
                      DisplayMemberPath="DisplayName"
                      MaxDropDownHeight="240"
                      Width="160"
                      Margin="8,0,0,0" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Label Content="Output" />
            <Button Content="{Binding DisplayBind}" Click="Button_Click" Margin="8,0,0,0" />
        </StackPanel>
    </StackPanel>
</UserControl>
