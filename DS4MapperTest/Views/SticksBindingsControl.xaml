<UserControl x:Class="DS4MapperTest.Views.SticksBindingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:DS4MapperTest.Views"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="860">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False">
        <StackPanel Margin="0,0,10,12">
            <views:StickSideBindingsControl DataContext="{Binding LeftStickKeybinds}"/>
            <views:StickSideBindingsControl DataContext="{Binding RightStickKeybinds}"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
