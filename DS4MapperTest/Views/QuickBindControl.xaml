<UserControl x:Class="DS4MapperTest.Views.QuickBindControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             Focusable="False"
             d:DesignWidth="240"
             d:DesignHeight="34">
    <UserControl.Resources>
        <Style x:Key="QuickBindDangerIconButtonStyle"
               TargetType="Button"
               BasedOn="{StaticResource JsmccDangerButtonStyle}">
            <Setter Property="MinWidth" Value="34"/>
            <Setter Property="Padding" Value="6,7"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Button x:Name="BindButton"
                Grid.Row="0"
                Grid.Column="0"
                Content="{Binding DisplayBind}"
                Click="BindButton_Click"
                Style="{StaticResource JsmccOutputButtonStyle}"
                HorizontalAlignment="Stretch"
                ToolTip="Click, then press a key or mouse button"
                AutomationProperties.Name="Current binding, click to set"/>

        <Grid Grid.Row="0"
              Grid.Column="1"
              HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Button x:Name="AdvancedButton"
                    Grid.Column="0"
                    Content="&#x2699;"
                    Click="AdvancedButton_Click"
                    Style="{StaticResource JsmccButtonStyle}"
                    MinWidth="34"
                    Padding="6,7"
                    Margin="6,0,0,0"
                    ToolTip="Configure action"
                    AutomationProperties.Name="Advanced binding options"/>

            <Button x:Name="ClearButton"
                    Grid.Column="1"
                    Content="&#x2715;"
                    Click="ClearButton_Click"
                    Style="{StaticResource QuickBindDangerIconButtonStyle}"
                    ToolTip="Clear binding"
                    AutomationProperties.Name="Clear binding"/>
        </Grid>

        <Button x:Name="AddSubCommandButton"
                Grid.Row="1"
                Grid.Column="0"
                Content="+ Add Sub Command"
                Click="AddSubCommandButton_Click"
                HorizontalAlignment="Stretch"
                Margin="0,6,0,0"
                ToolTip="Add another sub command"
                AutomationProperties.Name="Add sub command">
            <Button.Style>
                <Style TargetType="Button" BasedOn="{StaticResource JsmccButtonStyle}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ShowAddSubCommand}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <Popup x:Name="ConfirmPopup"
               PlacementTarget="{Binding ElementName=BindButton}"
               Placement="Bottom"
               StaysOpen="True"
               AllowsTransparency="True"
               Closed="ConfirmPopup_Closed">
            <Border Style="{StaticResource JsmccPanelBorder}" MaxWidth="260">
                <StackPanel>
                    <TextBlock x:Name="ConfirmText"
                               Style="{StaticResource JsmccBodyText}"
                               TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Cancel"
                                Click="ConfirmCancel_Click"
                                Style="{StaticResource JsmccButtonStyle}"
                                MinWidth="0"
                                Padding="10,6"
                                Margin="0,0,6,0"/>
                        <Button x:Name="ConfirmAdvancedButton"
                                Content="Open Advanced Editor"
                                Click="ConfirmAdvanced_Click"
                                Style="{StaticResource JsmccButtonStyle}"
                                MinWidth="0"
                                Padding="10,6"
                                Margin="0,0,6,0"/>
                        <Button x:Name="ConfirmActionButton"
                                Content="Replace"
                                Click="ConfirmAction_Click"
                                Style="{StaticResource JsmccDangerButtonStyle}"
                                MinWidth="0"
                                Padding="10,6"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
