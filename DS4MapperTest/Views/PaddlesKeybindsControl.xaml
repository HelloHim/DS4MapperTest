<UserControl x:Class="DS4MapperTest.Views.PaddlesKeybindsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="clr-namespace:DS4MapperTest.Views"
             mc:Ignorable="d"
             d:DesignHeight="620"
             d:DesignWidth="860">
    <views:SharedButtonKeybindsControl
        SectionTitle="Paddles"
        Description="Regular Press maps to Normal Press. Add Hold, Start, or Release bindings per rear input."
        EmptyText="No paddle, rear button, or grip bindings were found for the current controller."
        CardSubtitle="Rear input"
        ItemsSource="{Binding PaddleButtonBindings}"/>
</UserControl>
