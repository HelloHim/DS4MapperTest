        <DataTemplate DataType="{x:Type propvm:StickFlickStickPropViewModel}">
            <StackPanel>
                <shared:CalibrationModeControl Margin="0,0,0,6"/>

                <StackPanel Margin="0,6,0,6">
                    <TextBlock Text="Flick Stick" Style="{StaticResource JsmccSectionTitle}"/>
                    <TextBlock Text="Configure the flick, sweep rotation, and optional sensitivity compensation for this stick."
                               Style="{StaticResource JsmccBodyText}"
                               TextWrapping="Wrap"
                               Margin="0,4,0,0"/>
                </StackPanel>

                <Border Style="{StaticResource JsmccCardBorder}">
                    <StackPanel>
