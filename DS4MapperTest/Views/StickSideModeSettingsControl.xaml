<UserControl x:Class="DS4MapperTest.Views.StickSideModeSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:propvm="clr-namespace:DS4MapperTest.ViewModels.StickActionPropViewModels"
             xmlns:shared="clr-namespace:DS4MapperTest.Views.Shared"
             xmlns:views="clr-namespace:DS4MapperTest.Views"
             mc:Ignorable="d"
             d:DesignHeight="720"
             d:DesignWidth="860">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="ModeRowBorder" TargetType="Border" BasedOn="{StaticResource JsmccSettingRowBorder}">
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="AngleCalibrationBorder" TargetType="Border" BasedOn="{StaticResource JsmccSettingRowBorder}">
            <Setter Property="Background" Value="{DynamicResource JsmccBg1Brush}"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <Style x:Key="ModeRowLabel" TargetType="TextBlock" BasedOn="{StaticResource JsmccLabelText}">
            <Setter Property="Width" Value="170"/>
        </Style>

        <Style x:Key="StickControlLabel" TargetType="TextBlock" BasedOn="{StaticResource JsmccLabelText}">
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>

        <Style x:Key="ModeRowGrid" TargetType="Grid">
            <Setter Property="Height" Value="Auto"/>
        </Style>

        <DataTemplate x:Key="CounterMovementReleasePressSection">
            <Border Style="{StaticResource JsmccSettingRowBorder}" Margin="0,12,0,0">
                <StackPanel>
                <TextBlock Text="Counter Movement Release Press" Style="{StaticResource JsmccLabelText}" FontWeight="Bold" Margin="0,0,0,2"/>
                <TextBlock Text="When a digital stick direction is released, the mapper can generate a short press of the opposite direction."
                           Style="{StaticResource JsmccMutedText}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,4"/>

                <Border Style="{StaticResource ModeRowBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Enable Counter Movement Release Press" Style="{StaticResource JsmccLabelText}"/>
                        <CheckBox Grid.Column="1" IsChecked="{Binding CounterMovementReleasePressEnabled}" Style="{StaticResource JsmccToggleStyle}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <StackPanel IsEnabled="{Binding CounterMovementReleasePressEnabled}"
                            Visibility="{Binding CounterMovementReleasePressEnabled, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource ModeRowBorder}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Counter Tap Length Mode" Style="{StaticResource JsmccLabelText}"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding TapLengthModeItems}"
                                          DisplayMemberPath="DisplayName"
                                          SelectedValuePath="ChoiceValue"
                                          SelectedValue="{Binding OppositeTapLengthMode}"
                                          Style="{StaticResource JsmccComboBoxStyle}"
                                          HorizontalAlignment="Left"
                                          MinWidth="220"/>
                            </Grid>
                            <TextBlock Text="{Binding OppositeTapLengthModeDescription}"
                                       Style="{StaticResource JsmccMutedText}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ModeRowBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="260"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Counter Tap Length Preset" Style="{StaticResource JsmccLabelText}"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding TapLengthPresetItems}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="ChoiceValue"
                                      SelectedValue="{Binding TapLengthPreset}"
                                      Style="{StaticResource JsmccComboBoxStyle}"
                                      HorizontalAlignment="Left"
                                      MinWidth="150"
                                      ToolTip="Custom uses the values below. CS2 sets the fixed duration to 84ms with 7% variance (equivalent to a 78-90ms range) and leaves everything else, including the start delay, unchanged."/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource ModeRowBorder}"
                            Visibility="{Binding ShowFixedModeFields, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Counter Tap Length" Style="{StaticResource JsmccLabelText}"/>
                                <hc:NumericUpDown Grid.Column="1" Minimum="10" Maximum="150" DecimalPlaces="0" Increment="1"
                                                  Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                                  Value="{Binding OppositeTapLengthMs, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Grid.Column="2" Text="ms" Style="{StaticResource JsmccLabelText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="Uses the same total duration for every qualifying release."
                                       Style="{StaticResource JsmccMutedText}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ModeRowBorder}"
                            Visibility="{Binding ShowWaitVariancePercentageModeFields, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Counter Tap Length" Style="{StaticResource JsmccLabelText}"/>
                                <hc:NumericUpDown Grid.Column="1" Minimum="10" Maximum="150" DecimalPlaces="0" Increment="1"
                                                  Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                                  Value="{Binding OppositeTapLengthMs, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Grid.Column="2" Text="ms" Style="{StaticResource JsmccLabelText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Wait Variance Percentage" Style="{StaticResource JsmccLabelText}"/>
                                <hc:NumericUpDown Grid.Column="1" Minimum="0" Maximum="100" DecimalPlaces="0" Increment="1"
                                                  Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                                  Value="{Binding OppositeTapLengthVariancePercent, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Grid.Column="2" Text="%" Style="{StaticResource JsmccLabelText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="Sets the percentage range below and above the fixed tap length. Final boundaries are rounded down to whole milliseconds."
                                       Style="{StaticResource JsmccMutedText}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ModeRowBorder}"
                            Visibility="{Binding ShowMinimumAndMaximumModeFields, Converter={StaticResource BoolToVis}}">
                        <StackPanel>
                            <TextBlock Text="Counter Tap Length Variance" Style="{StaticResource JsmccLabelText}" Margin="0,0,0,4"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Minimum" Style="{StaticResource JsmccLabelText}"/>
                                <hc:NumericUpDown Grid.Column="1" Minimum="10" Maximum="150" DecimalPlaces="0" Increment="1"
                                                  Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                                  Value="{Binding OppositeTapLengthMinimumMs, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Grid.Column="2" Text="ms" Style="{StaticResource JsmccLabelText}" Margin="6,0,12,0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="Maximum" Style="{StaticResource JsmccLabelText}"/>
                                <hc:NumericUpDown Grid.Column="4" Minimum="10" Maximum="150" DecimalPlaces="0" Increment="1"
                                                  Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                                  Value="{Binding OppositeTapLengthMaximumMs, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Grid.Column="5" Text="ms" Style="{StaticResource JsmccLabelText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="Selects a total duration at random from the specified inclusive range. On each qualifying release, one value is picked at random from this range and used as the complete window for that release."
                                       Style="{StaticResource JsmccMutedText}"
                                       TextWrapping="Wrap"
                                       Margin="0,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Expander Header="Advanced Settings" IsExpanded="False" Margin="0,0,0,6">
                        <StackPanel Margin="12,8,0,0">
                            <Border Style="{StaticResource ModeRowBorder}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="260"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Counter Tap Start Delay Mode" Style="{StaticResource JsmccLabelText}"/>
                                        <ComboBox Grid.Column="1"
                                                  ItemsSource="{Binding StartDelayModeItems}"
                                                  DisplayMemberPath="DisplayName"
                                                  SelectedValuePath="ChoiceValue"
                                                  SelectedValue="{Binding OppositeTapStartDelayMode}"
                                                  Style="{StaticResource JsmccComboBoxStyle}"
                                                  HorizontalAlignment="Left"
                                                  MinWidth="220"/>
                                    </Grid>
                                    <TextBlock Text="{Binding OppositeTapStartDelayModeDescription}"
                                               Style="{StaticResource JsmccMutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ModeRowBorder}"
                                    Visibility="{Binding ShowStartDelayFixedModeFields, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="260"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Counter Tap Start Delay" Style="{StaticResource JsmccLabelText}"/>
                                        <hc:NumericUpDown Grid.Column="1" Minimum="0" Maximum="150" DecimalPlaces="0" Increment="1"
                                                          Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                                          Value="{Binding OppositeTapStartDelayMs, UpdateSourceTrigger=LostFocus}"/>
                                        <TextBlock Grid.Column="2" Text="ms" Style="{StaticResource JsmccLabelText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="Sets a fixed neutral delay before the generated opposite press begins."
                                               Style="{StaticResource JsmccMutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ModeRowBorder}"
                                    Visibility="{Binding ShowStartDelayWaitVariancePercentageModeFields, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="260"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Counter Tap Start Delay" Style="{StaticResource JsmccLabelText}"/>
                                        <hc:NumericUpDown Grid.Column="1" Minimum="0" Maximum="150" DecimalPlaces="0" Increment="1"
                                                          Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                                          Value="{Binding OppositeTapStartDelayMs, UpdateSourceTrigger=LostFocus}"/>
                                        <TextBlock Grid.Column="2" Text="ms" Style="{StaticResource JsmccLabelText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="260"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Wait Variance Percentage" Style="{StaticResource JsmccLabelText}"/>
                                        <hc:NumericUpDown Grid.Column="1" Minimum="0" Maximum="100" DecimalPlaces="0" Increment="1"
                                                          Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                                          Value="{Binding OppositeTapStartDelayVariancePercent, UpdateSourceTrigger=LostFocus}"/>
                                        <TextBlock Grid.Column="2" Text="%" Style="{StaticResource JsmccLabelText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="Sets the percentage range below and above the fixed start delay. Final boundaries are rounded down to whole milliseconds."
                                               Style="{StaticResource JsmccMutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ModeRowBorder}"
                                    Visibility="{Binding ShowStartDelayMinimumAndMaximumModeFields, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="Counter Tap Start Delay Variance" Style="{StaticResource JsmccLabelText}" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Minimum" Style="{StaticResource JsmccLabelText}"/>
                                        <hc:NumericUpDown Grid.Column="1" Minimum="0" Maximum="150" DecimalPlaces="0" Increment="1"
                                                          Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                                          Value="{Binding OppositeTapStartDelayMinimumMs, UpdateSourceTrigger=LostFocus}"/>
                                        <TextBlock Grid.Column="2" Text="ms" Style="{StaticResource JsmccLabelText}" Margin="6,0,12,0" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="Maximum" Style="{StaticResource JsmccLabelText}"/>
                                        <hc:NumericUpDown Grid.Column="4" Minimum="0" Maximum="150" DecimalPlaces="0" Increment="1"
                                                          Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                                          Value="{Binding OppositeTapStartDelayMaximumMs, UpdateSourceTrigger=LostFocus}"/>
                                        <TextBlock Grid.Column="5" Text="ms" Style="{StaticResource JsmccLabelText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="Sets the minimum and maximum neutral delay before the generated opposite press begins. The start delay is included within the selected tap-length window above: it is subtracted from the opposite-direction hold time, so the complete action never runs longer than the selected duration."
                                               Style="{StaticResource JsmccMutedText}"
                                               TextWrapping="Wrap"
                                               Margin="0,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ModeRowBorder}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Minimum Hold Time" Style="{StaticResource JsmccLabelText}"/>
                                        <hc:NumericUpDown Grid.Column="1" Minimum="0" Maximum="300" DecimalPlaces="0" Increment="1"
                                                          Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                                          Value="{Binding CounterMovementMinimumHoldMs, UpdateSourceTrigger=LostFocus}"/>
                                        <TextBlock Grid.Column="2" Text="ms" Style="{StaticResource JsmccLabelText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="Controls how long a digital direction must stay active before Counter Movement Release Press is eligible."
                                               Style="{StaticResource JsmccMutedText}"
                                               TextWrapping="Wrap"
                                               Margin="170,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ModeRowBorder}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Required Stick Deflection" Style="{StaticResource JsmccLabelText}"/>
                                        <hc:NumericUpDown Grid.Column="1" Minimum="0" Maximum="100" DecimalPlaces="0" Increment="1"
                                                          Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                                          Value="{Binding RequiredStickDeflectionThresholdPercent, UpdateSourceTrigger=LostFocus}"/>
                                        <TextBlock Grid.Column="2" Text="%" Style="{StaticResource JsmccLabelText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="Controls how far the stick must move before Counter Movement Release Press is armed. Set to 0% to arm whenever a digital direction activates."
                                               Style="{StaticResource JsmccMutedText}"
                                               TextWrapping="Wrap"
                                               Margin="170,4,0,0"/>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource ModeRowBorder}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="260"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="Use Arrow Keys for Counter-Movement Presses" Style="{StaticResource JsmccLabelText}" TextWrapping="Wrap"/>
                                        <CheckBox Grid.Column="1" IsChecked="{Binding UseArrowKeysForCounterMovementPresses}"
                                                  Style="{StaticResource JsmccToggleStyle}" VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBlock Text="When enabled, generated counter-movement presses use the arrow keys instead of the normal directional binds."
                                               Style="{StaticResource JsmccMutedText}"
                                               TextWrapping="Wrap"
                                               Margin="260,4,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Expander>
                </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="{x:Type propvm:StickNoActionPropViewModel}">
            <TextBlock Text="No additional settings for this mode."
                       Style="{StaticResource JsmccBodyText}"
                       TextWrapping="Wrap"/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type propvm:StickTranslatePropViewModel}">
            <StackPanel>
                <Border Style="{StaticResource ModeRowBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Output Stick" Style="{StaticResource JsmccLabelText}"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding OutputStickHolder.OutputStickItems}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedIndex="{Binding OutputStickIndex}"
                                  Style="{StaticResource JsmccComboBoxStyle}"
                                  HorizontalAlignment="Left"
                                  MinWidth="180"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ModeRowBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Dead Zone Type" Style="{StaticResource JsmccLabelText}"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding DeadZoneModesChoices}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="ChoiceValue"
                                  SelectedValue="{Binding DeadZoneType}"
                                  Style="{StaticResource JsmccComboBoxStyle}"
                                  HorizontalAlignment="Left"
                                  MinWidth="150"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ModeRowBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Dead Zone" Style="{StaticResource JsmccLabelText}"/>
                        <TextBox Grid.Column="1" Text="{Binding DeadZone, UpdateSourceTrigger=LostFocus}" Style="{StaticResource JsmccTextBoxStyle}" Width="80"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ModeRowBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Anti-Dead Zone" Style="{StaticResource JsmccLabelText}"/>
                        <TextBox Grid.Column="1" Text="{Binding AntiDeadZone, UpdateSourceTrigger=LostFocus}" Style="{StaticResource JsmccTextBoxStyle}" Width="80"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ModeRowBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Max Zone" Style="{StaticResource JsmccLabelText}"/>
                        <TextBox Grid.Column="1" Text="{Binding MaxZone, UpdateSourceTrigger=LostFocus}" Style="{StaticResource JsmccTextBoxStyle}" Width="80"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ModeRowBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Output Curve" Style="{StaticResource JsmccLabelText}"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding OutputCurveChoices}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="ChoiceValue"
                                  SelectedValue="{Binding OutputCurve}"
                                  Style="{StaticResource JsmccComboBoxStyle}"
                                  HorizontalAlignment="Left"
                                  MinWidth="180"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ModeRowBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Vertical Scale" Style="{StaticResource JsmccLabelText}"/>
                        <hc:NumericUpDown Grid.Column="1" Minimum="0" Maximum="10" DecimalPlaces="2" Increment="0.05"
                                          Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                          Value="{Binding VerticalScale, UpdateSourceTrigger=LostFocus}"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ModeRowBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Rotation" Style="{StaticResource JsmccLabelText}"/>
                        <hc:NumericUpDown Grid.Column="1" Minimum="-180" Maximum="180" DecimalPlaces="0" Increment="1"
                                          Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                          Value="{Binding Rotation, UpdateSourceTrigger=LostFocus}"
                                          HorizontalAlignment="Left"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ModeRowBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Invert" Style="{StaticResource JsmccLabelText}"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding InvertItems}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="ChoiceValue"
                                  SelectedValue="{Binding Invert}"
                                  Style="{StaticResource JsmccComboBoxStyle}"
                                  HorizontalAlignment="Left"
                                  MinWidth="150"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ModeRowBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Max Output" Style="{StaticResource JsmccLabelText}"/>
                        <CheckBox Grid.Column="1" IsChecked="{Binding MaxOutputEnabled}" Style="{StaticResource JsmccToggleStyle}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ModeRowBorder}"
                        Visibility="{Binding MaxOutputEnabled, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Max Output Value" Style="{StaticResource JsmccLabelText}"/>
                        <hc:NumericUpDown Grid.Column="1" Minimum="0" Maximum="1" DecimalPlaces="2" Increment="0.05"
                                          Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                          Value="{Binding MaxOutput, UpdateSourceTrigger=LostFocus}"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ModeRowBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Square Stick" Style="{StaticResource JsmccLabelText}"/>
                        <CheckBox Grid.Column="1" IsChecked="{Binding SquareStickEnabled}" Style="{StaticResource JsmccToggleStyle}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ModeRowBorder}"
                        Visibility="{Binding SquareStickEnabled, Converter={StaticResource BoolToVis}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Roundness" Style="{StaticResource JsmccLabelText}"/>
                        <TextBox Grid.Column="1" Text="{Binding SquareStickRoundness, UpdateSourceTrigger=LostFocus}"
                                 Width="80" Style="{StaticResource JsmccTextBoxStyle}"/>
                    </Grid>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type propvm:StickPadActionPropViewModel}">
            <StackPanel>
                <Border Style="{StaticResource ModeRowBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Directional Pad Layout" Style="{StaticResource JsmccLabelText}"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding PadModeItems}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedIndex="{Binding SelectedPadModeIndex}"
                                  Style="{StaticResource JsmccComboBoxStyle}"
                                  HorizontalAlignment="Left"
                                  MinWidth="180"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ModeRowBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Dead Zone Type" Style="{StaticResource JsmccLabelText}"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding DeadZoneModesChoices}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="ChoiceValue"
                                  SelectedValue="{Binding DeadZoneType}"
                                  Style="{StaticResource JsmccComboBoxStyle}"
                                  HorizontalAlignment="Left"
                                  MinWidth="150"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ModeRowBorder}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Dead Zone" Style="{StaticResource JsmccLabelText}" ToolTip="Used when Split Axes is off."/>
                            <TextBox Grid.Column="1" Text="{Binding DeadZone, UpdateSourceTrigger=LostFocus}" Width="80" ToolTip="Used when Split Axes is off.">
                                <TextBox.Style>
                                    <Style TargetType="TextBox" BasedOn="{StaticResource JsmccTextBoxStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SeparateAxisDeadZones}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBox.Style>
                            </TextBox>
                        </Grid>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Split Axes" Style="{StaticResource JsmccLabelText}"/>
                            <CheckBox Grid.Column="1" IsChecked="{Binding SeparateAxisDeadZones}" Style="{StaticResource JsmccToggleStyle}" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,6,0,0" Visibility="{Binding SeparateAxisDeadZones, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Horizontal Dead Zone" Style="{StaticResource JsmccLabelText}"/>
                            <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding DeadZoneX, UpdateSourceTrigger=LostFocus}" Style="{StaticResource JsmccTextBoxStyle}" Width="80"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,6,0,0" Text="Vertical Dead Zone" Style="{StaticResource JsmccLabelText}"/>
                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Text="{Binding DeadZoneY, UpdateSourceTrigger=LostFocus}" Style="{StaticResource JsmccTextBoxStyle}" Width="80"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ModeRowBorder}" Visibility="{Binding ShowDiagonalZoneWidth, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Diagonal Range" Style="{StaticResource JsmccLabelText}"/>
                        <hc:NumericUpDown Grid.Column="1" Minimum="0" Maximum="90" DecimalPlaces="0" Increment="1"
                                          Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                          Value="{Binding DiagonalRange, UpdateSourceTrigger=LostFocus}"
                                          HorizontalAlignment="Left"/>
                    </Grid>
                    <TextBlock Text="Controls the angle assigned to each diagonal zone. Lower values favour cardinal directions; higher values make diagonals easier to enter."
                               Style="{StaticResource JsmccMutedText}"
                               TextWrapping="Wrap"
                               Margin="170,6,0,0"/>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ModeRowBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Rotation" Style="{StaticResource JsmccLabelText}"/>
                        <hc:NumericUpDown Grid.Column="1" Minimum="-180" Maximum="180" DecimalPlaces="0" Increment="1"
                                          Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                          Value="{Binding Rotation, UpdateSourceTrigger=LostFocus}"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ModeRowBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Binding Presets" Style="{StaticResource JsmccLabelText}"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding ActionPresetChoicesItems}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="ChoiceValue"
                                  SelectedValue="{Binding ActionPresetChoice}"
                                  Style="{StaticResource JsmccComboBoxStyle}"
                                  HorizontalAlignment="Left"
                                  MinWidth="150"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ModeRowBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Directional Binds"
                                       Style="{StaticResource JsmccLabelText}"/>
                            <TextBlock Text="Quick bind"
                                       Style="{StaticResource JsmccMutedText}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <ItemsControl ItemsSource="{Binding CardinalDirectionItems}"
                                          Visibility="{Binding ShowCardinalPad, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ModeRowBorder}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               Style="{StaticResource JsmccLabelText}"/>
                                                    <TextBlock Text="{Binding Subtitle}"
                                                               Style="{StaticResource JsmccMutedText}"
                                                               Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <views:ActionOutputListControl Grid.Column="1"
                                                                               Grid.ColumnSpan="2"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding DiagonalDirectionItems}"
                                          Visibility="{Binding ShowDiagonalPad, Converter={StaticResource BoolToVis}}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ModeRowBorder}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               Style="{StaticResource JsmccLabelText}"/>
                                                    <TextBlock Text="{Binding Subtitle}"
                                                               Style="{StaticResource JsmccMutedText}"
                                                               Margin="0,3,0,0"/>
                                                </StackPanel>
                                                <views:ActionOutputListControl Grid.Column="1"
                                                                               Grid.ColumnSpan="2"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>

                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CounterMovementReleasePressSection}"/>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type propvm:StickMousePropViewModel}">
            <StackPanel>
                <shared:CalibrationModeControl Margin="0,0,0,6"/>

                <Border Style="{StaticResource ModeRowBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Joystick Mouse Sensitivity" Style="{StaticResource JsmccLabelText}"
                                   ToolTip="Sets the camera rotation speed at full stick deflection. Angle calibration keeps the speed consistent across games and in-game sensitivities."/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <hc:NumericUpDown Minimum="0" Maximum="7200" DecimalPlaces="1" Increment="10"
                                          Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                          Value="{Binding DegreesPerSecond, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Text="&#176;/s" Style="{StaticResource JsmccMutedText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ModeRowBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <RadioButton Grid.Row="0" Grid.Column="0"
                                     IsChecked="{Binding VerticalScaleIsMultiplierMode, Mode=TwoWay}"
                                     VerticalAlignment="Center" Content="Vertical Scale"
                                     Foreground="{DynamicResource JsmccTextMidBrush}">
                            <RadioButton.Style>
                                <Style TargetType="RadioButton">
                                    <Setter Property="Opacity" Value="1.0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VerticalScaleIsMultiplierMode}" Value="False">
                                            <Setter Property="Opacity" Value="0.5"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </RadioButton.Style>
                        </RadioButton>
                        <hc:NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="0.0" Maximum="10.0" DecimalPlaces="4" Increment="0.1"
                                          Width="90" HorizontalAlignment="Left" IsEnabled="{Binding VerticalScaleIsMultiplierMode}"
                                          ValueFormat="0.0###"
                                          Value="{Binding VerticalScale, UpdateSourceTrigger=LostFocus}">
                            <hc:NumericUpDown.Style>
                                <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource JsmccNumericUpDownStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VerticalScaleIsMultiplierMode}" Value="False">
                                            <Setter Property="Opacity" Value="0.5"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </hc:NumericUpDown.Style>
                        </hc:NumericUpDown>

                        <RadioButton Grid.Row="1" Grid.Column="0" Margin="0,6,0,0"
                                     IsChecked="{Binding VerticalScaleIsAbsoluteMode, Mode=TwoWay}"
                                     VerticalAlignment="Center" Content="Vertical Sensitivity"
                                     Foreground="{DynamicResource JsmccTextMidBrush}">
                            <RadioButton.Style>
                                <Style TargetType="RadioButton">
                                    <Setter Property="Opacity" Value="1.0"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding VerticalScaleIsAbsoluteMode}" Value="False">
                                            <Setter Property="Opacity" Value="0.5"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </RadioButton.Style>
                        </RadioButton>
                        <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Orientation="Horizontal">
                            <hc:NumericUpDown Minimum="0" Maximum="7200" DecimalPlaces="1" Increment="10"
                                              Width="90" IsEnabled="{Binding VerticalScaleIsAbsoluteMode}"
                                              Value="{Binding VerticalDegreesPerSecond, UpdateSourceTrigger=LostFocus}">
                                <hc:NumericUpDown.Style>
                                    <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource JsmccNumericUpDownStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding VerticalScaleIsAbsoluteMode}" Value="False">
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </hc:NumericUpDown.Style>
                            </hc:NumericUpDown>
                            <TextBlock Text="&#176;/s" Style="{StaticResource JsmccMutedText}" Margin="6,6,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ModeRowBorder}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Dead Zone" Style="{StaticResource JsmccLabelText}" ToolTip="Used when Split Axes is off."/>
                            <hc:NumericUpDown Grid.Column="1" Minimum="0" Maximum="1" DecimalPlaces="2" Increment="0.02"
                                              Width="90" Value="{Binding DeadZone, UpdateSourceTrigger=LostFocus}">
                                <hc:NumericUpDown.Style>
                                    <Style TargetType="hc:NumericUpDown" BasedOn="{StaticResource JsmccNumericUpDownStyle}">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SeparateAxisDeadZones}" Value="True">
                                                <Setter Property="IsEnabled" Value="False"/>
                                                <Setter Property="Opacity" Value="0.5"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </hc:NumericUpDown.Style>
                            </hc:NumericUpDown>
                        </Grid>

                        <Grid Margin="0,6,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Split Axes" Style="{StaticResource JsmccLabelText}"/>
                            <CheckBox Grid.Column="1" IsChecked="{Binding SeparateAxisDeadZones}" Style="{StaticResource JsmccToggleStyle}" VerticalAlignment="Center"/>
                        </Grid>

                        <Grid Margin="0,6,0,0" Visibility="{Binding SeparateAxisDeadZones, Converter={StaticResource BoolToVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Horizontal Dead Zone" Style="{StaticResource JsmccLabelText}"/>
                            <hc:NumericUpDown Grid.Row="0" Grid.Column="1" Minimum="0" Maximum="1" DecimalPlaces="2" Increment="0.02"
                                              Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                              Value="{Binding DeadZoneX, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Margin="0,6,0,0" Text="Vertical Dead Zone" Style="{StaticResource JsmccLabelText}"/>
                            <hc:NumericUpDown Grid.Row="1" Grid.Column="1" Margin="0,6,0,0" Minimum="0" Maximum="1" DecimalPlaces="2" Increment="0.02"
                                              Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                              Value="{Binding DeadZoneY, UpdateSourceTrigger=LostFocus}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ModeRowBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Diagonal Range" Style="{StaticResource JsmccLabelText}"/>
                        <hc:NumericUpDown Grid.Column="1" Minimum="0" Maximum="90" DecimalPlaces="0" Increment="1"
                                          Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                          Value="{Binding DiagonalRange, UpdateSourceTrigger=LostFocus}"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ModeRowBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Output Curve" Style="{StaticResource JsmccLabelText}"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding OutputCurveChoiceItems}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="ChoiceValue"
                                  SelectedValue="{Binding OutputCurveChoice}"
                                  Style="{StaticResource JsmccComboBoxStyle}"
                                  HorizontalAlignment="Left"
                                  MinWidth="180"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource ModeRowBorder}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Delta Acceleration" Style="{StaticResource JsmccLabelText}"/>
                            <CheckBox Grid.Column="1" IsChecked="{Binding DeltaEnabled}" Style="{StaticResource JsmccToggleStyle}" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="Speeds up mouse output as the stick moves farther from centre."
                                   Style="{StaticResource JsmccBodyText}"
                                   TextWrapping="Wrap"
                                   Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <StackPanel Visibility="{Binding DeltaEnabled, Converter={StaticResource BoolToVis}}">
                    <Border Style="{StaticResource ModeRowBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Multiplier" Style="{StaticResource JsmccLabelText}"/>
                            <hc:NumericUpDown Grid.Column="1" Minimum="0" Maximum="20" DecimalPlaces="2" Increment="0.1"
                                              Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                              Value="{Binding DeltaMultiplier, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Grid.Column="2" Text="Min Factor" Style="{StaticResource JsmccLabelText}"/>
                            <hc:NumericUpDown Grid.Column="3" Minimum="0" Maximum="1" DecimalPlaces="2" Increment="0.05"
                                              Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                              Value="{Binding DeltaMinFactor, UpdateSourceTrigger=LostFocus}"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource ModeRowBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Min Travel" Style="{StaticResource JsmccLabelText}"/>
                            <hc:NumericUpDown Grid.Column="1" Minimum="0" Maximum="1" DecimalPlaces="2" Increment="0.02"
                                              Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                              Value="{Binding DeltaMinTravel, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Grid.Column="2" Text="Max Travel" Style="{StaticResource JsmccLabelText}"/>
                            <hc:NumericUpDown Grid.Column="3" Minimum="0" Maximum="1" DecimalPlaces="2" Increment="0.02"
                                              Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                              Value="{Binding DeltaMaxTravel, UpdateSourceTrigger=LostFocus}"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource ModeRowBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Easing Duration" Style="{StaticResource JsmccLabelText}"/>
                            <hc:NumericUpDown Grid.Column="1" Minimum="0" Maximum="5000" DecimalPlaces="0" Increment="10"
                                              Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                              Value="{Binding DeltaEasingDuration, UpdateSourceTrigger=LostFocus}"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <Border Style="{StaticResource ModeRowBorder}" Margin="0,12,0,0">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                            <TextBlock Text="Multiplier Compensation" Style="{StaticResource JsmccLabelText}" FontWeight="Bold" VerticalAlignment="Center"/>
                            <CheckBox Style="{StaticResource JsmccToggleStyle}" IsChecked="{Binding MultiplierCompensation}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                        </StackPanel>
                        <TextBlock Text="Divides your output by this amount to compensate for a third-party acceleration or multiplier tool. Enter the exact multiplier that tool applies to your mouse input."
                                   Style="{StaticResource JsmccMutedText}"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,4"/>

                        <StackPanel IsEnabled="{Binding MultiplierCompensation}">
                            <Border Style="{StaticResource ModeRowBorder}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Horizontal Multiplier" Style="{StaticResource JsmccLabelText}"/>
                                    <hc:NumericUpDown Grid.Column="1" Minimum="0.01" Maximum="100.0" DecimalPlaces="3" Increment="0.01"
                                                      Width="110" Style="{StaticResource JsmccNumericUpDownStyle}"
                                                      Value="{Binding AccelerationMultiplier}"/>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource ModeRowBorder}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Opacity" Value="1.0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding VerticalAccelerationIsAbsoluteMode}" Value="False">
                                                        <Setter Property="Opacity" Value="0.5"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <RadioButton GroupName="VerticalAccelerationMode"
                                                     IsChecked="{Binding VerticalAccelerationIsAbsoluteMode, Mode=TwoWay}"
                                                     VerticalAlignment="Center" Width="190" Content="Vertical Multiplier"
                                                     Foreground="{DynamicResource JsmccTextMidBrush}"/>
                                        <hc:NumericUpDown Minimum="0.01" Maximum="100.0" DecimalPlaces="3" Increment="0.01"
                                                          Width="110" Style="{StaticResource JsmccNumericUpDownStyle}"
                                                          IsEnabled="{Binding VerticalAccelerationIsAbsoluteMode}"
                                                          Value="{Binding VerticalAccelerationMultiplier}"/>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Setter Property="Opacity" Value="1.0"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding VerticalAccelerationIsScaleMode}" Value="False">
                                                        <Setter Property="Opacity" Value="0.5"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>
                                        <RadioButton GroupName="VerticalAccelerationMode"
                                                     IsChecked="{Binding VerticalAccelerationIsScaleMode, Mode=TwoWay}"
                                                     VerticalAlignment="Center" Width="190" Content="Vertical Scale"
                                                     Foreground="{DynamicResource JsmccTextMidBrush}"/>
                                        <hc:NumericUpDown Minimum="0.01" Maximum="100.0" DecimalPlaces="3" Increment="0.01"
                                                          Width="110" Style="{StaticResource JsmccNumericUpDownStyle}"
                                                          IsEnabled="{Binding VerticalAccelerationIsScaleMode}"
                                                          Value="{Binding VerticalAccelerationScale}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource ModeRowBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,12,0">
                            <TextBlock Text="Directional Binds"
                                       Style="{StaticResource JsmccLabelText}"/>
                            <TextBlock Text="Quick bind"
                                       Style="{StaticResource JsmccMutedText}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>
                        <ItemsControl Grid.Column="1"
                                      ItemsSource="{Binding CardinalDirectionItems}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ModeRowBorder}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="120"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0" Margin="0,0,12,0">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           Style="{StaticResource JsmccLabelText}"/>
                                                <TextBlock Text="{Binding Subtitle}"
                                                           Style="{StaticResource JsmccMutedText}"
                                                           Margin="0,3,0,0"/>
                                            </StackPanel>
                                            <views:ActionOutputListControl Grid.Column="1"
                                                                           Grid.ColumnSpan="2"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type propvm:StickCircularPropViewModel}">
            <StackPanel>
                <Border Style="{StaticResource ModeRowBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="Auto"/>
