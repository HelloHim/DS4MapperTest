<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- JSMCC dark theme tokens -->
    <Color x:Key="JsmccBg0Color">#161618</Color>
    <Color x:Key="JsmccBg1Color">#25262B</Color>
    <Color x:Key="JsmccBg15Color">#232327</Color>
    <Color x:Key="JsmccBg2Color">#1E1E20</Color>
    <Color x:Key="JsmccBgCardColor">#111111</Color>
    <Color x:Key="JsmccBgRowColor">#1E1E20</Color>
    <Color x:Key="JsmccBgFieldGroupColor">#111111</Color>
    <Color x:Key="JsmccBgButtonHoverColor">#23252B</Color>
    <Color x:Key="JsmccBgPrimaryColor">#262933</Color>
    <Color x:Key="JsmccBgInputColor">#111111</Color>
    <Color x:Key="JsmccTextStrongColor">#E8ECF3</Color>
    <Color x:Key="JsmccTextMidColor">#BCC2CC</Color>
    <Color x:Key="JsmccTextMutedColor">#8F949E</Color>
    <Color x:Key="JsmccBorderColor">#2A2C33</Color>
    <Color x:Key="JsmccBorderStrongColor">#343741</Color>
    <Color x:Key="JsmccAccentColor">#6FA7FF</Color>
    <Color x:Key="JsmccTelemetryGreenColor">#9FE5C2</Color>

    <Color x:Key="JsmccWarningBgColor">#1FFFB74D</Color>
    <Color x:Key="JsmccWarningBorderColor">#66FFB74D</Color>
    <Color x:Key="JsmccWarningTextColor">#FFFFD28A</Color>
    <Color x:Key="JsmccDangerBgColor">#33EF4444</Color>
    <Color x:Key="JsmccDangerBorderColor">#CCEF4444</Color>
    <Color x:Key="JsmccDangerTextColor">#FFFF8A8A</Color>
    <Color x:Key="JsmccSuccessBgColor">#1F6FD5B3</Color>
    <Color x:Key="JsmccSuccessBorderColor">#666FD5B3</Color>
    <Color x:Key="JsmccSuccessTextColor">#FFA9FFE2</Color>

    <Color x:Key="JsmccToastSuccessBgColor">#13382F</Color>
    <Color x:Key="JsmccToastSuccessBorderColor">#60D7B5</Color>
    <Color x:Key="JsmccToastSuccessTextColor">#CAFCEE</Color>
    <Color x:Key="JsmccToastWarningBgColor">#3A2B10</Color>
    <Color x:Key="JsmccToastWarningBorderColor">#F1B355</Color>
    <Color x:Key="JsmccToastWarningTextColor">#FFE1AE</Color>
    <Color x:Key="JsmccToastErrorBgColor">#3A1818</Color>
    <Color x:Key="JsmccToastErrorBorderColor">#F28A8A</Color>
    <Color x:Key="JsmccToastErrorTextColor">#FFD6D6</Color>

    <Color x:Key="JsmccTouchpadGridBgColor">#121212</Color>
    <Color x:Key="JsmccTouchpadGridBorderColor">#2C2C2C</Color>
    <Color x:Key="JsmccTouchpadGridCellBgColor">#151515</Color>
    <Color x:Key="JsmccTouchpadGridCellBorderColor">#2F2F2F</Color>
    <Color x:Key="JsmccTouchpadGridMutedColor">#B0B0B0</Color>
    <Color x:Key="JsmccTouchpadGridHintColor">#CFCFCF</Color>
    <Color x:Key="JsmccTouchpadGridLimitColor">#BBBBBB</Color>

    <!-- Theme toggle switch, accent mixed ~30% into hover background -->
    <Color x:Key="JsmccToggleOnTrackColor">#3A4C6B</Color>

    <SolidColorBrush x:Key="JsmccBg0Brush" Color="{StaticResource JsmccBg0Color}"/>
    <SolidColorBrush x:Key="JsmccBg1Brush" Color="{StaticResource JsmccBg1Color}"/>
    <SolidColorBrush x:Key="JsmccBg15Brush" Color="{StaticResource JsmccBg15Color}"/>
    <SolidColorBrush x:Key="JsmccBg2Brush" Color="{StaticResource JsmccBg2Color}"/>
    <SolidColorBrush x:Key="JsmccBgCardBrush" Color="{StaticResource JsmccBgCardColor}"/>
    <SolidColorBrush x:Key="JsmccBgRowBrush" Color="{StaticResource JsmccBgRowColor}"/>
    <SolidColorBrush x:Key="JsmccBgFieldGroupBrush" Color="{StaticResource JsmccBgFieldGroupColor}"/>
    <SolidColorBrush x:Key="JsmccBgButtonHoverBrush" Color="{StaticResource JsmccBgButtonHoverColor}"/>
    <SolidColorBrush x:Key="JsmccBgPrimaryBrush" Color="{StaticResource JsmccBgPrimaryColor}"/>
    <SolidColorBrush x:Key="JsmccBgInputBrush" Color="{StaticResource JsmccBgInputColor}"/>
    <SolidColorBrush x:Key="JsmccTextStrongBrush" Color="{StaticResource JsmccTextStrongColor}"/>
    <SolidColorBrush x:Key="JsmccTextMidBrush" Color="{StaticResource JsmccTextMidColor}"/>
    <SolidColorBrush x:Key="JsmccTextMutedBrush" Color="{StaticResource JsmccTextMutedColor}"/>
    <SolidColorBrush x:Key="JsmccBorderBrush" Color="{StaticResource JsmccBorderColor}"/>
    <SolidColorBrush x:Key="JsmccBorderStrongBrush" Color="{StaticResource JsmccBorderStrongColor}"/>
    <SolidColorBrush x:Key="JsmccAccentBrush" Color="{StaticResource JsmccAccentColor}"/>
    <SolidColorBrush x:Key="JsmccTelemetryGreenBrush" Color="{StaticResource JsmccTelemetryGreenColor}"/>

    <SolidColorBrush x:Key="JsmccWarningBgBrush" Color="{StaticResource JsmccWarningBgColor}"/>
    <SolidColorBrush x:Key="JsmccWarningBorderBrush" Color="{StaticResource JsmccWarningBorderColor}"/>
    <SolidColorBrush x:Key="JsmccWarningTextBrush" Color="{StaticResource JsmccWarningTextColor}"/>
    <SolidColorBrush x:Key="JsmccDangerBgBrush" Color="{StaticResource JsmccDangerBgColor}"/>
    <SolidColorBrush x:Key="JsmccDangerBorderBrush" Color="{StaticResource JsmccDangerBorderColor}"/>
    <SolidColorBrush x:Key="JsmccDangerTextBrush" Color="{StaticResource JsmccDangerTextColor}"/>
    <SolidColorBrush x:Key="JsmccSuccessBgBrush" Color="{StaticResource JsmccSuccessBgColor}"/>
    <SolidColorBrush x:Key="JsmccSuccessBorderBrush" Color="{StaticResource JsmccSuccessBorderColor}"/>
    <SolidColorBrush x:Key="JsmccSuccessTextBrush" Color="{StaticResource JsmccSuccessTextColor}"/>

    <SolidColorBrush x:Key="JsmccToastSuccessBgBrush" Color="{StaticResource JsmccToastSuccessBgColor}"/>
    <SolidColorBrush x:Key="JsmccToastSuccessBorderBrush" Color="{StaticResource JsmccToastSuccessBorderColor}"/>
    <SolidColorBrush x:Key="JsmccToastSuccessTextBrush" Color="{StaticResource JsmccToastSuccessTextColor}"/>
    <SolidColorBrush x:Key="JsmccToastWarningBgBrush" Color="{StaticResource JsmccToastWarningBgColor}"/>
    <SolidColorBrush x:Key="JsmccToastWarningBorderBrush" Color="{StaticResource JsmccToastWarningBorderColor}"/>
    <SolidColorBrush x:Key="JsmccToastWarningTextBrush" Color="{StaticResource JsmccToastWarningTextColor}"/>
    <SolidColorBrush x:Key="JsmccToastErrorBgBrush" Color="{StaticResource JsmccToastErrorBgColor}"/>
    <SolidColorBrush x:Key="JsmccToastErrorBorderBrush" Color="{StaticResource JsmccToastErrorBorderColor}"/>
    <SolidColorBrush x:Key="JsmccToastErrorTextBrush" Color="{StaticResource JsmccToastErrorTextColor}"/>

    <SolidColorBrush x:Key="JsmccTouchpadGridBgBrush" Color="{StaticResource JsmccTouchpadGridBgColor}"/>
    <SolidColorBrush x:Key="JsmccTouchpadGridBorderBrush" Color="{StaticResource JsmccTouchpadGridBorderColor}"/>
    <SolidColorBrush x:Key="JsmccTouchpadGridCellBgBrush" Color="{StaticResource JsmccTouchpadGridCellBgColor}"/>
    <SolidColorBrush x:Key="JsmccTouchpadGridCellBorderBrush" Color="{StaticResource JsmccTouchpadGridCellBorderColor}"/>
    <SolidColorBrush x:Key="JsmccTouchpadGridMutedBrush" Color="{StaticResource JsmccTouchpadGridMutedColor}"/>
    <SolidColorBrush x:Key="JsmccTouchpadGridHintBrush" Color="{StaticResource JsmccTouchpadGridHintColor}"/>
    <SolidColorBrush x:Key="JsmccTouchpadGridLimitBrush" Color="{StaticResource JsmccTouchpadGridLimitColor}"/>

    <SolidColorBrush x:Key="JsmccToggleOnTrackBrush" Color="{StaticResource JsmccToggleOnTrackColor}"/>

    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource JsmccAccentColor}"/>
    <SolidColorBrush x:Key="LightPrimaryBrush" Color="{StaticResource JsmccBgPrimaryColor}"/>
    <SolidColorBrush x:Key="DarkPrimaryBrush" Color="{StaticResource JsmccAccentColor}"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource JsmccTextStrongColor}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource JsmccTextMidColor}"/>
    <SolidColorBrush x:Key="ThirdlyTextBrush" Color="{StaticResource JsmccTextMutedColor}"/>
    <SolidColorBrush x:Key="ReverseTextBrush" Color="{StaticResource JsmccBg2Color}"/>
    <SolidColorBrush x:Key="TextIconBrush" Color="{StaticResource JsmccTextStrongColor}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource JsmccBorderColor}"/>
    <SolidColorBrush x:Key="SecondaryBorderBrush" Color="{StaticResource JsmccBorderStrongColor}"/>
    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource JsmccBg0Color}"/>
    <SolidColorBrush x:Key="RegionBrush" Color="{StaticResource JsmccBg2Color}"/>
    <SolidColorBrush x:Key="SecondaryRegionBrush" Color="{StaticResource JsmccBgInputColor}"/>
    <SolidColorBrush x:Key="ThirdlyRegionBrush" Color="{StaticResource JsmccBgButtonHoverColor}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource JsmccAccentColor}"/>
</ResourceDictionary>
