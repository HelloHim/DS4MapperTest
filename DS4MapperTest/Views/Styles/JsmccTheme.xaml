<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:hc="https://handyorg.github.io/handycontrol">

    <Color x:Key="JsmccBg0Color">#161618</Color>
    <Color x:Key="JsmccBg1Color">#25262B</Color>
    <Color x:Key="JsmccBg15Color">#232327</Color>
    <Color x:Key="JsmccBg2Color">#1E1E20</Color>
    <Color x:Key="JsmccBgButtonHoverColor">#23252B</Color>
    <Color x:Key="JsmccBgPrimaryColor">#262933</Color>
    <Color x:Key="JsmccBgInputColor">#111111</Color>
    <Color x:Key="JsmccTextStrongColor">#E8ECF3</Color>
    <Color x:Key="JsmccTextMidColor">#BCC2CC</Color>
    <Color x:Key="JsmccTextMutedColor">#8F949E</Color>
    <Color x:Key="JsmccBorderColor">#2A2C33</Color>
    <Color x:Key="JsmccBorderStrongColor">#343741</Color>
    <Color x:Key="JsmccAccentColor">#6FA7FF</Color>
    <Color x:Key="JsmccDangerBgColor">#22303838</Color>
    <Color x:Key="JsmccDangerBorderColor">#99FF786F</Color>
    <Color x:Key="JsmccDangerTextColor">#FFFFB7AF</Color>

    <SolidColorBrush x:Key="JsmccBg0Brush" Color="{StaticResource JsmccBg0Color}"/>
    <SolidColorBrush x:Key="JsmccBg1Brush" Color="{StaticResource JsmccBg1Color}"/>
    <SolidColorBrush x:Key="JsmccBg15Brush" Color="{StaticResource JsmccBg15Color}"/>
    <SolidColorBrush x:Key="JsmccBg2Brush" Color="{StaticResource JsmccBg2Color}"/>
    <SolidColorBrush x:Key="JsmccBgButtonHoverBrush" Color="{StaticResource JsmccBgButtonHoverColor}"/>
    <SolidColorBrush x:Key="JsmccBgPrimaryBrush" Color="{StaticResource JsmccBgPrimaryColor}"/>
    <SolidColorBrush x:Key="JsmccBgInputBrush" Color="{StaticResource JsmccBgInputColor}"/>
    <SolidColorBrush x:Key="JsmccTextStrongBrush" Color="{StaticResource JsmccTextStrongColor}"/>
    <SolidColorBrush x:Key="JsmccTextMidBrush" Color="{StaticResource JsmccTextMidColor}"/>
    <SolidColorBrush x:Key="JsmccTextMutedBrush" Color="{StaticResource JsmccTextMutedColor}"/>
    <SolidColorBrush x:Key="JsmccBorderBrush" Color="{StaticResource JsmccBorderColor}"/>
    <SolidColorBrush x:Key="JsmccBorderStrongBrush" Color="{StaticResource JsmccBorderStrongColor}"/>
    <SolidColorBrush x:Key="JsmccAccentBrush" Color="{StaticResource JsmccAccentColor}"/>
    <SolidColorBrush x:Key="JsmccDangerBgBrush" Color="{StaticResource JsmccDangerBgColor}"/>
    <SolidColorBrush x:Key="JsmccDangerBorderBrush" Color="{StaticResource JsmccDangerBorderColor}"/>
    <SolidColorBrush x:Key="JsmccDangerTextBrush" Color="{StaticResource JsmccDangerTextColor}"/>

    <Thickness x:Key="JsmccShellPadding">28,12,28,16</Thickness>
    <Thickness x:Key="JsmccCardPadding">20</Thickness>
    <CornerRadius x:Key="JsmccCardRadius">6</CornerRadius>
    <CornerRadius x:Key="JsmccControlRadius">6</CornerRadius>
    <CornerRadius x:Key="JsmccButtonRadius">8</CornerRadius>
    <CornerRadius x:Key="JsmccTabRadius">6</CornerRadius>
    <CornerRadius x:Key="JsmccPillRadius">999</CornerRadius>

    <Style x:Key="JsmccPageTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource JsmccTextStrongBrush}"/>
        <Setter Property="FontSize" Value="22"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,0,0,4"/>
    </Style>

    <Style x:Key="JsmccSectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource JsmccTextStrongBrush}"/>
        <Setter Property="FontSize" Value="17"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="JsmccCardTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource JsmccTextStrongBrush}"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="JsmccBodyText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource JsmccTextMidBrush}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style x:Key="JsmccMutedText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource JsmccTextMutedBrush}"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style x:Key="JsmccLabelText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource JsmccTextMidBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style x:Key="JsmccPanelBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource JsmccBg2Brush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource JsmccBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource JsmccCardRadius}"/>
        <Setter Property="Padding" Value="8"/>
        <Setter Property="SnapsToDevicePixels" Value="True"/>
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect ShadowDepth="0" BlurRadius="12" Color="Black" Opacity="0.35"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="JsmccCardBorder" TargetType="Border" BasedOn="{StaticResource JsmccPanelBorder}">
        <Setter Property="Background" Value="{StaticResource JsmccBgInputBrush}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="Margin" Value="0,0,0,6"/>
        <Setter Property="Effect" Value="{x:Null}"/>
    </Style>

    <Style x:Key="JsmccSettingRowBorder" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource JsmccBg2Brush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource JsmccBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="{StaticResource JsmccCardRadius}"/>
        <Setter Property="Padding" Value="10,8"/>
        <Setter Property="Margin" Value="0,4,0,0"/>
    </Style>

    <Style x:Key="JsmccButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource JsmccBgInputBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource JsmccBorderBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource JsmccTextStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource JsmccButtonRadius}">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource JsmccBgButtonHoverBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource JsmccBorderStrongBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource JsmccBgPrimaryBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource JsmccAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="JsmccPrimaryButtonStyle" TargetType="Button" BasedOn="{StaticResource JsmccButtonStyle}">
        <Setter Property="Background" Value="{StaticResource JsmccBgPrimaryBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource JsmccAccentBrush}"/>
    </Style>

    <Style x:Key="JsmccDangerButtonStyle" TargetType="Button" BasedOn="{StaticResource JsmccButtonStyle}">
        <Setter Property="Background" Value="{StaticResource JsmccDangerBgBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource JsmccDangerBorderBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource JsmccDangerTextBrush}"/>
    </Style>

    <Style x:Key="JsmccOutputButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="{StaticResource JsmccBgInputBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource JsmccBorderBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource JsmccTextStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="MinWidth" Value="80"/>
        <Setter Property="MaxWidth" Value="160"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource JsmccControlRadius}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource JsmccBgButtonHoverBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource JsmccBorderStrongBrush}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource JsmccBgPrimaryBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource JsmccAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                            <Setter Property="Cursor" Value="Arrow"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="JsmccNavButtonStyle" TargetType="RadioButton">
        <Setter Property="Background" Value="{StaticResource JsmccBgInputBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource JsmccBorderBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource JsmccTextStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="13,10"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource JsmccButtonRadius}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource JsmccBgButtonHoverBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource JsmccBorderStrongBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource JsmccBgButtonHoverBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource JsmccAccentBrush}"/>
                            <Setter Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="JsmccPillTabItemStyle" TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource JsmccTextStrongBrush}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Margin" Value="0,0,8,8"/>
        <Setter Property="MinWidth" Value="68"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="Chrome"
                            Background="{StaticResource JsmccBgInputBrush}"
                            BorderBrush="{StaticResource JsmccBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource JsmccTabRadius}">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource JsmccBgButtonHoverBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource JsmccBorderStrongBrush}"/>
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource JsmccBgButtonHoverBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource JsmccAccentBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="JsmccPillTabControlStyle" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="ItemContainerStyle" Value="{StaticResource JsmccPillTabItemStyle}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top"
                                   Orientation="Horizontal"
                                   IsItemsHost="True"
                                   Margin="0,0,0,4"
                                   KeyboardNavigation.TabIndex="1"/>
                        <ContentPresenter ContentSource="SelectedContent"
                                          KeyboardNavigation.TabIndex="2"/>
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="JsmccComboBoxStyle" TargetType="ComboBox" BasedOn="{StaticResource ComboBoxBaseStyle}">
        <Setter Property="Background" Value="{StaticResource JsmccBgInputBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource JsmccTextStrongBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource JsmccBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,5"/>
        <Setter Property="MinHeight" Value="34"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="JsmccTextBoxStyle" TargetType="TextBox" BasedOn="{StaticResource TextBoxBaseStyle}">
        <Setter Property="Background" Value="{StaticResource JsmccBgInputBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource JsmccTextStrongBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource JsmccBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="MinHeight" Value="32"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="JsmccNumericUpDownStyle" TargetType="hc:NumericUpDown" BasedOn="{StaticResource NumericUpDownBaseStyle}">
        <Setter Property="Background" Value="{StaticResource JsmccBgInputBrush}"/>
        <Setter Property="Foreground" Value="{StaticResource JsmccTextStrongBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource JsmccBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MinHeight" Value="30"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style x:Key="JsmccToggleStyle" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource JsmccTextStrongBrush}"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="40" Height="22">
                        <Border x:Name="Track"
                                Background="{StaticResource JsmccBgButtonHoverBrush}"
                                BorderBrush="{StaticResource JsmccBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource JsmccPillRadius}"/>
                        <Ellipse x:Name="Thumb"
                                 Width="17"
                                 Height="17"
                                 HorizontalAlignment="Left"
                                 Margin="3,0,0,0"
                                 Fill="{StaticResource JsmccBg2Brush}"
                                 Stroke="{StaticResource JsmccBorderBrush}"
                                 StrokeThickness="1"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Track" Property="Background" Value="{StaticResource JsmccAccentBrush}"/>
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource JsmccAccentBrush}"/>
                            <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                            <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                            <Setter TargetName="Thumb" Property="Stroke" Value="{StaticResource JsmccAccentBrush}"/>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Track" Property="BorderBrush" Value="{StaticResource JsmccBorderStrongBrush}"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="CalibModeToggleStyle" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource JsmccTextStrongBrush}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Chrome"
                            Background="{StaticResource JsmccBgInputBrush}"
                            BorderBrush="{StaticResource JsmccBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="{StaticResource JsmccControlRadius}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource JsmccBgButtonHoverBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource JsmccBorderStrongBrush}"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource JsmccBgButtonHoverBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource JsmccAccentBrush}"/>
                            <Setter Property="BorderThickness" Value="2"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{StaticResource JsmccBg2Brush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource JsmccBorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{StaticResource JsmccTextStrongBrush}"/>
        <Setter Property="Background" Value="{StaticResource JsmccBg2Brush}"/>
        <Setter Property="Padding" Value="12,8"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style TargetType="ScrollViewer">
        <Setter Property="PanningMode" Value="VerticalFirst"/>
    </Style>
</ResourceDictionary>
