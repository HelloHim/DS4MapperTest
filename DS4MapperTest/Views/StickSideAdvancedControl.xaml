<UserControl x:Class="DS4MapperTest.Views.StickSideAdvancedControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:propvm="clr-namespace:DS4MapperTest.ViewModels.StickActionPropViewModels"
             xmlns:converters="clr-namespace:DS4MapperTest.Converters"
             mc:Ignorable="d"
             d:DesignHeight="420"
             d:DesignWidth="860">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <converters:InvertBoolToVisibilityConverter x:Key="InvertBoolToVis"/>

        <Style x:Key="ModeRowBorder" TargetType="Border" BasedOn="{StaticResource JsmccSettingRowBorder}">
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <DataTemplate x:Key="CounterMovementReleasePressSection">
            <StackPanel>
                <TextBlock Text="Counter Movement Release Press" Style="{StaticResource JsmccLabelText}" FontWeight="Bold" Margin="0,0,0,2"/>
                <TextBlock Text="When a digital stick direction is released, the mapper can generate a short press of the opposite direction. This can reduce residual movement caused by the physical stick returning towards its centre."
                           Style="{StaticResource JsmccMutedText}"
                           TextWrapping="Wrap"
                           Margin="0,0,0,4"/>

                <Border Style="{StaticResource ModeRowBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Enable Counter Movement Release Press" Style="{StaticResource JsmccLabelText}"/>
                        <CheckBox Grid.Column="1" IsChecked="{Binding CounterMovementReleasePressEnabled}" Style="{StaticResource JsmccToggleStyle}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <StackPanel IsEnabled="{Binding CounterMovementReleasePressEnabled}">
                    <Border Style="{StaticResource ModeRowBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Tap Length Preset" Style="{StaticResource JsmccLabelText}"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding TapLengthPresetItems}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedValuePath="ChoiceValue"
                                      SelectedValue="{Binding TapLengthPreset}"
                                      Style="{StaticResource JsmccComboBoxStyle}"
                                      HorizontalAlignment="Left"
                                      MinWidth="150"
                                      ToolTip="Custom uses the Opposite Tap Length Variance values below. CS2 sets the tap-length range to 75-120ms and leaves everything else, including the start delay, unchanged."/>
                        </Grid>
                    </Border>

                    <TextBlock Text="Opposite Tap Length Variance" Style="{StaticResource JsmccLabelText}" Margin="0,10,0,4"
                               ToolTip="Sets the minimum and maximum total duration from the original-direction release until the generated opposite press ends."/>
                    <Border Style="{StaticResource ModeRowBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Minimum" Style="{StaticResource JsmccLabelText}"/>
                            <hc:NumericUpDown Grid.Column="1" Minimum="10" Maximum="150" DecimalPlaces="0" Increment="1"
                                              Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                              Value="{Binding OppositeTapLengthMinimumMs, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Grid.Column="2" Text="Maximum" Style="{StaticResource JsmccLabelText}"/>
                            <hc:NumericUpDown Grid.Column="3" Minimum="10" Maximum="150" DecimalPlaces="0" Increment="1"
                                              Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                              Value="{Binding OppositeTapLengthMaximumMs, UpdateSourceTrigger=LostFocus}"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="Opposite Tap Start Delay" Style="{StaticResource JsmccLabelText}" Margin="0,10,0,4"
                               ToolTip="Sets the minimum and maximum neutral delay before the generated opposite press begins."/>
                    <Border Style="{StaticResource ModeRowBorder}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="170"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Minimum" Style="{StaticResource JsmccLabelText}"/>
                            <hc:NumericUpDown Grid.Column="1" Minimum="0" Maximum="150" DecimalPlaces="0" Increment="1"
                                              Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                              Value="{Binding OppositeTapStartDelayMinimumMs, UpdateSourceTrigger=LostFocus}"/>
                            <TextBlock Grid.Column="2" Text="Maximum" Style="{StaticResource JsmccLabelText}"/>
                            <hc:NumericUpDown Grid.Column="3" Minimum="0" Maximum="150" DecimalPlaces="0" Increment="1"
                                              Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                              Value="{Binding OppositeTapStartDelayMaximumMs, UpdateSourceTrigger=LostFocus}"/>
                        </Grid>
                    </Border>

                    <TextBlock Text="The start delay is included within the selected tap-length window. The selected delay is subtracted from the opposite-direction hold time so the complete action does not exceed the selected duration."
                               Style="{StaticResource JsmccMutedText}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="Advanced" Style="{StaticResource JsmccLabelText}" FontWeight="Bold" Margin="0,6,0,4"/>

                    <Border Style="{StaticResource ModeRowBorder}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Minimum Hold Time" Style="{StaticResource JsmccLabelText}"/>
                                <hc:NumericUpDown Grid.Column="1" Minimum="0" Maximum="300" DecimalPlaces="0" Increment="1"
                                                  Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                                  Value="{Binding BrakeMinimumHoldMs, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Grid.Column="2" Text="ms" Style="{StaticResource JsmccLabelText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="Controls how long a digital direction must stay active before Counter Movement Release Press is eligible."
                                       Style="{StaticResource JsmccMutedText}"
                                       TextWrapping="Wrap"
                                       Margin="170,4,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource ModeRowBorder}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="170"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Digital Arming Threshold" Style="{StaticResource JsmccLabelText}"/>
                                <hc:NumericUpDown Grid.Column="1" Minimum="0" Maximum="100" DecimalPlaces="0" Increment="1"
                                                  Width="90" Style="{StaticResource JsmccNumericUpDownStyle}"
                                                  Value="{Binding BrakeArmingThresholdPercent, UpdateSourceTrigger=LostFocus}"/>
                                <TextBlock Grid.Column="2" Text="%" Style="{StaticResource JsmccLabelText}" Margin="6,0,0,0" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="Controls how far the stick must move before Counter Movement Release Press is armed. Set to 0% to arm whenever a digital direction activates."
                                       Style="{StaticResource JsmccMutedText}"
                                       TextWrapping="Wrap"
                                       Margin="170,4,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="{x:Type propvm:StickPadActionPropViewModel}">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CounterMovementReleasePressSection}"/>
        </DataTemplate>

        <DataTemplate DataType="{x:Type propvm:StickAnalogEmulationPropViewModel}">
            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource CounterMovementReleasePressSection}"/>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <StackPanel Margin="0,0,0,6">
            <TextBlock Text="{Binding SideLabel}" Style="{StaticResource JsmccSectionTitle}"/>
            <TextBlock Text="Mode-specific advanced options for this stick appear here when the selected stick mode has any."
                       Style="{StaticResource JsmccBodyText}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Border Style="{StaticResource JsmccCardBorder}" Margin="0,0,0,18">
            <StackPanel>
                <ContentControl Content="{Binding SettingsViewModel}"
                                Visibility="{Binding IsPadMode, Converter={StaticResource BoolToVis}}"/>

                <TextBlock Text="{Binding AdvancedPlaceholderText}"
                           Style="{StaticResource JsmccBodyText}"
                           TextWrapping="Wrap"
                           Visibility="{Binding IsPadMode, Converter={StaticResource InvertBoolToVis}}"/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
