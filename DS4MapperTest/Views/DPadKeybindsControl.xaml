<UserControl x:Class="DS4MapperTest.Views.DPadKeybindsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:views="clr-namespace:DS4MapperTest.Views"
             mc:Ignorable="d"
             d:DesignHeight="760"
             d:DesignWidth="860">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="DPadControlLabel" TargetType="TextBlock" BasedOn="{StaticResource JsmccLabelText}">
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </UserControl.Resources>

    <StackPanel DataContext="{Binding DPadKeybinds}">
        <StackPanel Margin="0,0,0,6">
            <TextBlock Text="D-Pad" Style="{StaticResource JsmccSectionTitle}"/>
            <TextBlock Text="Choose whether this D-Pad uses direction bindings, translates to controller D-Pad output, or stays disabled."
                       Style="{StaticResource JsmccBodyText}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Border Style="{StaticResource JsmccCardBorder}"
                Visibility="{Binding ShowDPadEmptyState, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="No D-Pad binding available" Style="{StaticResource JsmccCardTitle}"/>
                <TextBlock Text="This controller does not expose a D-Pad binding in the current profile."
                           Style="{StaticResource JsmccMutedText}"
                           TextWrapping="Wrap"
                           Margin="0,3,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel Visibility="{Binding HasDPadBindings, Converter={StaticResource BoolToVis}}">
            <Border Style="{StaticResource JsmccCardBorder}">
                <StackPanel>
                    <TextBlock Text="D-Pad Mode" Style="{StaticResource JsmccCardTitle}"/>
                    <Border Style="{StaticResource JsmccSettingRowBorder}" Margin="0,8,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="Mode"
                                       Style="{StaticResource JsmccLabelText}"
                                       VerticalAlignment="Center"/>
                            <ComboBox Grid.Column="1"
                                      ItemsSource="{Binding TopLevelModeItems}"
                                      DisplayMemberPath="DisplayName"
                                      SelectedIndex="{Binding SelectedTopLevelModeIndex}"
                                      Style="{StaticResource JsmccComboBoxStyle}"
                                      Width="180"/>
                            <TextBlock Grid.Column="2"
                                       Text="{Binding ModeHelperText}"
                                       Style="{StaticResource JsmccMutedText}"
                                       TextWrapping="Wrap"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0"/>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource JsmccCardBorder}"
                    Visibility="{Binding IsTranslate, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="Translate Settings" Style="{StaticResource JsmccCardTitle}"/>
                <TextBlock Text="D-Pad is set to Translate. These settings use the existing DS4MapperTest DPadTranslate action."
                           Style="{StaticResource JsmccMutedText}"
                           TextWrapping="Wrap"
                           Margin="0,3,0,8"/>

                <Border Style="{StaticResource JsmccSettingRowBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Name"
                                   Style="{StaticResource JsmccLabelText}"
                                   VerticalAlignment="Center"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding TranslateName, UpdateSourceTrigger=LostFocus}"
                                 Style="{StaticResource JsmccTextBoxStyle}"
                                 Width="220"
                                 HorizontalAlignment="Left"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource JsmccSettingRowBorder}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   Text="Output D-Pad"
                                   Style="{StaticResource JsmccLabelText}"
                                   VerticalAlignment="Center"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding OutputDPadItems}"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValuePath="Code"
                                  SelectedValue="{Binding TranslateOutputDPad}"
                                  Style="{StaticResource JsmccComboBoxStyle}"
                                  Width="180"
                                  HorizontalAlignment="Left"/>
                    </Grid>
                </Border>
            </StackPanel>
            </Border>

            <Border Style="{StaticResource JsmccCardBorder}"
                    Visibility="{Binding IsNoAction, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="No Action" Style="{StaticResource JsmccCardTitle}"/>
                <TextBlock Text="D-Pad is set to No Action. Direction bindings are disabled for this D-Pad mode."
                           Style="{StaticResource JsmccMutedText}"
                           TextWrapping="Wrap"
                           Margin="0,3,0,0"/>
            </StackPanel>
            </Border>

            <Border Style="{StaticResource JsmccCardBorder}"
                    Visibility="{Binding IsActionPad, Converter={StaticResource BoolToVis}}">
            <StackPanel>
                <TextBlock Text="Action Pad Direction Mode" Style="{StaticResource JsmccCardTitle}"/>
                <TextBlock Text="Controls how diagonal D-Pad presses are resolved into the direction bindings."
                           Style="{StaticResource JsmccMutedText}"
                           TextWrapping="Wrap"
                           Margin="0,3,0,8"/>
                <ComboBox ItemsSource="{Binding PadModeItems}"
                          DisplayMemberPath="DisplayName"
                          SelectedIndex="{Binding SelectedPadModeIndex}"
                          Style="{StaticResource JsmccComboBoxStyle}"
                          Width="220"
                          HorizontalAlignment="Left"/>
            </StackPanel>
            </Border>

            <ItemsControl ItemsSource="{Binding Directions}"
                          Visibility="{Binding IsActionPad, Converter={StaticResource BoolToVis}}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource JsmccCardBorder}">
                        <DockPanel LastChildFill="True">
                            <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,2">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="{Binding DisplayName}"
                                               Style="{StaticResource JsmccCardTitle}"/>
                                    <TextBlock Text="Action Pad direction"
                                               Style="{StaticResource JsmccMutedText}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>

                                <Button DockPanel.Dock="Right"
                                        Content="Add Extra Binding"
                                        Click="AddExtraBindingButton_Click"
                                        Style="{StaticResource JsmccButtonStyle}">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Hold Press"
                                                      Tag="Hold"
                                                      IsEnabled="{Binding PlacementTarget.DataContext.CanAddHoldPress, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      Click="AddExtraBindingMenuItem_Click"/>
                                            <MenuItem Header="Double Press"
                                                      Tag="Double"
                                                      IsEnabled="{Binding PlacementTarget.DataContext.CanAddDoublePress, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      Click="AddExtraBindingMenuItem_Click"/>
                                            <MenuItem Header="Distance"
                                                      Tag="Distance"
                                                      IsEnabled="{Binding PlacementTarget.DataContext.CanAddDistancePress, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      Click="AddExtraBindingMenuItem_Click"/>
                                            <MenuItem Header="Start Press"
                                                      Tag="Start"
                                                      IsEnabled="{Binding PlacementTarget.DataContext.CanAddStartPress, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      Click="AddExtraBindingMenuItem_Click"/>
                                            <MenuItem Header="Release Press"
                                                      Tag="Release"
                                                      IsEnabled="{Binding PlacementTarget.DataContext.CanAddReleasePress, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      Click="AddExtraBindingMenuItem_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </DockPanel>

                            <ItemsControl ItemsSource="{Binding FunctionItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource JsmccSettingRowBorder}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               Style="{StaticResource JsmccLabelText}"/>
                                                    <TextBlock Text="Press behaviour"
                                                               Style="{StaticResource JsmccMutedText}"
                                                               Margin="0,3,0,0"/>
                                                </StackPanel>

                                                <views:QuickBindControl Grid.Row="0"
                                                                        Grid.Column="1"/>

                                                <StackPanel Grid.Row="0"
                                                            Grid.Column="2"
                                                            Orientation="Horizontal"
                                                            HorizontalAlignment="Right"
                                                            Margin="10,0,0,0">
                                                    <Button Content="Remove"
                                                            Tag="{Binding}"
                                                            Click="RemoveBinding_Click"
                                                            Style="{StaticResource JsmccDangerButtonStyle}"
                                                            MinWidth="76"
                                                            Margin="8,0,0,0"
                                                            Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>

                                                <WrapPanel Grid.Row="1"
                                                           Grid.Column="0"
                                                           Grid.ColumnSpan="3"
                                                           Margin="0,6,0,0">
                                                    <Border Background="{DynamicResource JsmccBgInputBrush}"
                                                            BorderBrush="{DynamicResource JsmccBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="6,4"
                                                            Margin="0,0,8,4"
                                                            Visibility="{Binding SupportsToggle, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Toggle" Style="{StaticResource DPadControlLabel}"/>
                                                            <CheckBox IsChecked="{Binding ToggleEnabled}"
                                                                      Style="{StaticResource JsmccToggleStyle}"
                                                                      VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="{DynamicResource JsmccBgInputBrush}"
                                                            BorderBrush="{DynamicResource JsmccBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="6,4"
                                                            Margin="0,0,8,4"
                                                            Visibility="{Binding SupportsTurbo, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Turbo" Style="{StaticResource DPadControlLabel}"/>
                                                            <CheckBox IsChecked="{Binding TurboEnabled}"
                                                                      Style="{StaticResource JsmccToggleStyle}"
                                                                      VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="{DynamicResource JsmccBgInputBrush}"
                                                            BorderBrush="{DynamicResource JsmccBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="6,4"
                                                            Margin="0,0,8,4"
                                                            Visibility="{Binding IsTurboEnabled, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Repeat Time" Style="{StaticResource DPadControlLabel}"/>
                                                            <hc:NumericUpDown Minimum="0"
                                                                              Maximum="60000"
                                                                              DecimalPlaces="0"
                                                                              Increment="10"
                                                                              Width="108"
                                                                              Style="{StaticResource JsmccNumericUpDownStyle}"
                                                                              Value="{Binding TurboDurationMs, UpdateSourceTrigger=LostFocus}"
                                                                              ValueFormat="0 ms"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="{DynamicResource JsmccBgInputBrush}"
                                                            BorderBrush="{DynamicResource JsmccBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="6,4"
                                                            Margin="0,0,8,4"
                                                            Visibility="{Binding SupportsFireDelay, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Fire Delay" Style="{StaticResource DPadControlLabel}"/>
                                                            <hc:NumericUpDown Minimum="0"
                                                                              Maximum="60000"
                                                                              DecimalPlaces="0"
                                                                              Increment="10"
                                                                              Width="108"
                                                                              Style="{StaticResource JsmccNumericUpDownStyle}"
                                                                              Value="{Binding FireDelayMs, UpdateSourceTrigger=LostFocus}"
                                                                              ValueFormat="0 ms"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="{DynamicResource JsmccBgInputBrush}"
                                                            BorderBrush="{DynamicResource JsmccBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="6,4"
                                                            Margin="0,0,8,4"
                                                            Visibility="{Binding SupportsHoldTime, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Hold Time" Style="{StaticResource DPadControlLabel}"/>
                                                            <hc:NumericUpDown Minimum="0"
                                                                              Maximum="60000"
                                                                              DecimalPlaces="0"
                                                                              Increment="10"
                                                                              Width="108"
                                                                              Style="{StaticResource JsmccNumericUpDownStyle}"
                                                                              Value="{Binding HoldMs, UpdateSourceTrigger=LostFocus}"
                                                                              ValueFormat="0 ms"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="{DynamicResource JsmccBgInputBrush}"
                                                            BorderBrush="{DynamicResource JsmccBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="6,4"
                                                            Margin="0,0,8,4"
                                                            Visibility="{Binding SupportsTapWindow, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Tap Window" Style="{StaticResource DPadControlLabel}"/>
                                                            <hc:NumericUpDown Minimum="0"
                                                                              Maximum="60000"
                                                                              DecimalPlaces="0"
                                                                              Increment="10"
                                                                              Width="108"
                                                                              Style="{StaticResource JsmccNumericUpDownStyle}"
                                                                              Value="{Binding TapWindowMs, UpdateSourceTrigger=LostFocus}"
                                                                              ValueFormat="0 ms"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="{DynamicResource JsmccBgInputBrush}"
                                                            BorderBrush="{DynamicResource JsmccBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="6,4"
                                                            Margin="0,0,8,4"
                                                            Visibility="{Binding SupportsDistanceOptions, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Name" Style="{StaticResource DPadControlLabel}"/>
                                                            <TextBox Text="{Binding DistanceName, UpdateSourceTrigger=LostFocus}"
                                                                     Width="128"
                                                                     Style="{StaticResource JsmccTextBoxStyle}"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="{DynamicResource JsmccBgInputBrush}"
                                                            BorderBrush="{DynamicResource JsmccBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="6,4"
                                                            Margin="0,0,8,4"
                                                            Visibility="{Binding SupportsDistanceOptions, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Distance" Style="{StaticResource DPadControlLabel}"/>
                                                            <hc:NumericUpDown Minimum="0.0"
                                                                              Maximum="1.0"
                                                                              DecimalPlaces="1"
                                                                              Increment="0.1"
                                                                              Width="108"
                                                                              Style="{StaticResource JsmccNumericUpDownStyle}"
                                                                              Value="{Binding DistanceValue, UpdateSourceTrigger=LostFocus}"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="{DynamicResource JsmccBgInputBrush}"
                                                            BorderBrush="{DynamicResource JsmccBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="6,4"
                                                            Margin="0,0,8,4"
                                                            Visibility="{Binding SupportsReleaseOptions, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Min Duration" Style="{StaticResource DPadControlLabel}"/>
                                                            <TextBox Text="{Binding ReleaseDurationMs, UpdateSourceTrigger=LostFocus}"
                                                                     Width="72"
                                                                     Style="{StaticResource JsmccTextBoxStyle}"/>
                                                            <TextBlock Text="ms"
                                                                       Style="{StaticResource JsmccMutedText}"
                                                                       Margin="6,0,0,0"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="{DynamicResource JsmccBgInputBrush}"
                                                            BorderBrush="{DynamicResource JsmccBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="6,4"
                                                            Margin="0,0,8,4"
                                                            Visibility="{Binding SupportsReleaseOptions, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="End Delay" Style="{StaticResource DPadControlLabel}"/>
                                                            <TextBox Text="{Binding ReleaseDelayMs, UpdateSourceTrigger=LostFocus}"
                                                                     Width="72"
                                                                     Style="{StaticResource JsmccTextBoxStyle}"/>
                                                            <TextBlock Text="ms"
                                                                       Style="{StaticResource JsmccMutedText}"
                                                                       Margin="6,0,0,0"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="{DynamicResource JsmccBgInputBrush}"
                                                            BorderBrush="{DynamicResource JsmccBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="6,4"
                                                            Margin="0,0,8,4"
                                                            Visibility="{Binding SupportsReleaseOptions, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Interruptible" Style="{StaticResource DPadControlLabel}"/>
                                                            <CheckBox IsChecked="{Binding ReleaseInterruptable}"
                                                                      Style="{StaticResource JsmccToggleStyle}"
                                                                      VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </WrapPanel>

                                                <ContentControl x:Name="InlineEditorHost"
                                                                Grid.Row="2"
                                                                Grid.Column="0"
                                                                Grid.ColumnSpan="3"
                                                                Visibility="Collapsed"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </StackPanel>
</UserControl>
