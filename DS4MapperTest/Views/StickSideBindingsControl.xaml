<UserControl x:Class="DS4MapperTest.Views.StickSideBindingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d"
             d:DesignHeight="620"
             d:DesignWidth="860">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="StickControlLabel" TargetType="TextBlock" BasedOn="{StaticResource JsmccLabelText}">
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </UserControl.Resources>

    <StackPanel Margin="0,0,0,18">
        <StackPanel Margin="0,0,0,6">
            <TextBlock Text="{Binding SideLabel}" Style="{StaticResource JsmccSectionTitle}"/>
            <TextBlock Text="Stick click is always available. Additional bindings below depend on the current stick mode."
                       Style="{StaticResource JsmccBodyText}"
                       TextWrapping="Wrap"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <Border Style="{StaticResource JsmccCardBorder}" DataContext="{Binding ClickBindingItem}">
            <DockPanel LastChildFill="True">
                <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,2">
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="{Binding DisplayName}"
                                   Style="{StaticResource JsmccCardTitle}"/>
                        <TextBlock Text="Stick click button"
                                   Style="{StaticResource JsmccMutedText}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <Button DockPanel.Dock="Right"
                            Content="Add Extra Binding"
                            Click="ClickAddExtraBindingButton_Click"
                            Style="{StaticResource JsmccButtonStyle}">
                        <Button.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Hold Press"
                                          Tag="Hold"
                                          IsEnabled="{Binding PlacementTarget.DataContext.CanAddHoldPress, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          Click="ClickAddExtraBindingMenuItem_Click"/>
                                <MenuItem Header="Double Press"
                                          Tag="Double"
                                          IsEnabled="{Binding PlacementTarget.DataContext.CanAddDoublePress, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          Click="ClickAddExtraBindingMenuItem_Click"/>
                                <MenuItem Header="Distance"
                                          Tag="Distance"
                                          IsEnabled="{Binding PlacementTarget.DataContext.CanAddDistancePress, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          Click="ClickAddExtraBindingMenuItem_Click"/>
                                <MenuItem Header="Start Press"
                                          Tag="Start"
                                          IsEnabled="{Binding PlacementTarget.DataContext.CanAddStartPress, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          Click="ClickAddExtraBindingMenuItem_Click"/>
                                <MenuItem Header="Release Press"
                                          Tag="Release"
                                          IsEnabled="{Binding PlacementTarget.DataContext.CanAddReleasePress, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                          Click="ClickAddExtraBindingMenuItem_Click"/>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                </DockPanel>

                <ItemsControl ItemsSource="{Binding FunctionItems}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource JsmccSettingRowBorder}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                                        <TextBlock Text="{Binding DisplayName}"
                                                   Style="{StaticResource JsmccLabelText}"/>
                                        <TextBlock Text="Press behaviour"
                                                   Style="{StaticResource JsmccMutedText}"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>

                                    <Button Grid.Row="0"
                                            Grid.Column="1"
                                            Content="{Binding DisplayBind}"
                                            Tag="{Binding}"
                                            Click="ClickEditBinding_Click"
                                            Style="{StaticResource JsmccOutputButtonStyle}"
                                            ToolTip="Edit binding output"/>

                                    <StackPanel Grid.Row="0"
                                                Grid.Column="2"
                                                Orientation="Horizontal"
                                                HorizontalAlignment="Right"
                                                Margin="10,0,0,0">
                                        <Button Content="Edit"
                                                Tag="{Binding}"
                                                Click="ClickEditBinding_Click"
                                                Style="{StaticResource JsmccButtonStyle}"
                                                MinWidth="58"/>
                                        <Button Content="Remove"
                                                Tag="{Binding}"
                                                Click="ClickRemoveBinding_Click"
                                                Style="{StaticResource JsmccDangerButtonStyle}"
                                                MinWidth="76"
                                                Margin="8,0,0,0"
                                                Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}"/>
                                    </StackPanel>

                                    <WrapPanel Grid.Row="1"
                                               Grid.Column="0"
                                               Grid.ColumnSpan="3"
                                               Margin="0,6,0,0">
                                        <Border Background="{DynamicResource JsmccBgInputBrush}"
                                                BorderBrush="{DynamicResource JsmccBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="6,4"
                                                Margin="0,0,8,4"
                                                Visibility="{Binding SupportsToggle, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Toggle" Style="{StaticResource StickControlLabel}"/>
                                                <CheckBox IsChecked="{Binding ToggleEnabled}"
                                                          Style="{StaticResource JsmccToggleStyle}"
                                                          VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="{DynamicResource JsmccBgInputBrush}"
                                                BorderBrush="{DynamicResource JsmccBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="6,4"
                                                Margin="0,0,8,4"
                                                Visibility="{Binding SupportsTurbo, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Turbo" Style="{StaticResource StickControlLabel}"/>
                                                <CheckBox IsChecked="{Binding TurboEnabled}"
                                                          Style="{StaticResource JsmccToggleStyle}"
                                                          VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="{DynamicResource JsmccBgInputBrush}"
                                                BorderBrush="{DynamicResource JsmccBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="6,4"
                                                Margin="0,0,8,4"
                                                Visibility="{Binding IsTurboEnabled, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Repeat Time" Style="{StaticResource StickControlLabel}"/>
                                                <hc:NumericUpDown Minimum="0"
                                                                  Maximum="60000"
                                                                  DecimalPlaces="0"
                                                                  Increment="10"
                                                                  Width="108"
                                                                  Style="{StaticResource JsmccNumericUpDownStyle}"
                                                                  Value="{Binding TurboDurationMs, UpdateSourceTrigger=LostFocus}"
                                                                  ValueFormat="0 ms"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="{DynamicResource JsmccBgInputBrush}"
                                                BorderBrush="{DynamicResource JsmccBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="6,4"
                                                Margin="0,0,8,4"
                                                Visibility="{Binding SupportsFireDelay, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Fire Delay" Style="{StaticResource StickControlLabel}"/>
                                                <hc:NumericUpDown Minimum="0"
                                                                  Maximum="60000"
                                                                  DecimalPlaces="0"
                                                                  Increment="10"
                                                                  Width="108"
                                                                  Style="{StaticResource JsmccNumericUpDownStyle}"
                                                                  Value="{Binding FireDelayMs, UpdateSourceTrigger=LostFocus}"
                                                                  ValueFormat="0 ms"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="{DynamicResource JsmccBgInputBrush}"
                                                BorderBrush="{DynamicResource JsmccBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="6,4"
                                                Margin="0,0,8,4"
                                                Visibility="{Binding SupportsHoldTime, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Hold Time" Style="{StaticResource StickControlLabel}"/>
                                                <hc:NumericUpDown Minimum="0"
                                                                  Maximum="60000"
                                                                  DecimalPlaces="0"
                                                                  Increment="10"
                                                                  Width="108"
                                                                  Style="{StaticResource JsmccNumericUpDownStyle}"
                                                                  Value="{Binding HoldMs, UpdateSourceTrigger=LostFocus}"
                                                                  ValueFormat="0 ms"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="{DynamicResource JsmccBgInputBrush}"
                                                BorderBrush="{DynamicResource JsmccBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="6,4"
                                                Margin="0,0,8,4"
                                                Visibility="{Binding SupportsDistanceOptions, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Name" Style="{StaticResource StickControlLabel}"/>
                                                <TextBox Text="{Binding DistanceName, UpdateSourceTrigger=LostFocus}"
                                                         Width="128"
                                                         Style="{StaticResource JsmccTextBoxStyle}"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="{DynamicResource JsmccBgInputBrush}"
                                                BorderBrush="{DynamicResource JsmccBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="6,4"
                                                Margin="0,0,8,4"
                                                Visibility="{Binding SupportsDistanceOptions, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Distance" Style="{StaticResource StickControlLabel}"/>
                                                <hc:NumericUpDown Minimum="0.0"
                                                                  Maximum="1.0"
                                                                  DecimalPlaces="1"
                                                                  Increment="0.1"
                                                                  Width="108"
                                                                  Style="{StaticResource JsmccNumericUpDownStyle}"
                                                                  Value="{Binding DistanceValue, UpdateSourceTrigger=LostFocus}"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="{DynamicResource JsmccBgInputBrush}"
                                                BorderBrush="{DynamicResource JsmccBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="6,4"
                                                Margin="0,0,8,4"
                                                Visibility="{Binding SupportsReleaseOptions, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Min Duration" Style="{StaticResource StickControlLabel}"/>
                                                <TextBox Text="{Binding ReleaseDurationMs, UpdateSourceTrigger=LostFocus}"
                                                         Width="72"
                                                         Style="{StaticResource JsmccTextBoxStyle}"/>
                                                <TextBlock Text="ms"
                                                           Style="{StaticResource JsmccMutedText}"
                                                           Margin="6,0,0,0"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="{DynamicResource JsmccBgInputBrush}"
                                                BorderBrush="{DynamicResource JsmccBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="6,4"
                                                Margin="0,0,8,4"
                                                Visibility="{Binding SupportsReleaseOptions, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="End Delay" Style="{StaticResource StickControlLabel}"/>
                                                <TextBox Text="{Binding ReleaseDelayMs, UpdateSourceTrigger=LostFocus}"
                                                         Width="72"
                                                         Style="{StaticResource JsmccTextBoxStyle}"/>
                                                <TextBlock Text="ms"
                                                           Style="{StaticResource JsmccMutedText}"
                                                           Margin="6,0,0,0"
                                                           VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>

                                        <Border Background="{DynamicResource JsmccBgInputBrush}"
                                                BorderBrush="{DynamicResource JsmccBorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="6,4"
                                                Margin="0,0,8,4"
                                                Visibility="{Binding SupportsReleaseOptions, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Interruptible" Style="{StaticResource StickControlLabel}"/>
                                                <CheckBox IsChecked="{Binding ReleaseInterruptable}"
                                                          Style="{StaticResource JsmccToggleStyle}"
                                                          VerticalAlignment="Center"/>
                                            </StackPanel>
                                        </Border>
                                    </WrapPanel>

                                    <ContentControl x:Name="InlineEditorHost"
                                                    Grid.Row="2"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="3"
                                                    Visibility="Collapsed"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </Border>

        <TextBlock Text="Mode Bindings"
                   Style="{StaticResource JsmccSectionTitle}"
                   Margin="0,12,0,4"/>

        <Border>
            <Border.Style>
                <Style TargetType="Border" BasedOn="{StaticResource JsmccCardBorder}">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasExtraBindings}" Value="False">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="No additional bindings for this mode."
                       Style="{StaticResource JsmccBodyText}"
                       TextWrapping="Wrap"/>
        </Border>

        <ItemsControl ItemsSource="{Binding ExtraBindings}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource JsmccCardBorder}">
                        <DockPanel LastChildFill="True">
                            <DockPanel DockPanel.Dock="Top" LastChildFill="False" Margin="0,0,0,2">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="{Binding DisplayName}"
                                               Style="{StaticResource JsmccCardTitle}"/>
                                    <TextBlock Text="Stick mode binding"
                                               Style="{StaticResource JsmccMutedText}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>

                                <Button DockPanel.Dock="Right"
                                        Content="Add Extra Binding"
                                        Click="ExtraAddExtraBindingButton_Click"
                                        Style="{StaticResource JsmccButtonStyle}">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Hold Press"
                                                      Tag="Hold"
                                                      IsEnabled="{Binding PlacementTarget.DataContext.CanAddHoldPress, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      Click="ExtraAddExtraBindingMenuItem_Click"/>
                                            <MenuItem Header="Double Press"
                                                      Tag="Double"
                                                      IsEnabled="{Binding PlacementTarget.DataContext.CanAddDoublePress, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      Click="ExtraAddExtraBindingMenuItem_Click"/>
                                            <MenuItem Header="Distance"
                                                      Tag="Distance"
                                                      IsEnabled="{Binding PlacementTarget.DataContext.CanAddDistancePress, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      Click="ExtraAddExtraBindingMenuItem_Click"/>
                                            <MenuItem Header="Start Press"
                                                      Tag="Start"
                                                      IsEnabled="{Binding PlacementTarget.DataContext.CanAddStartPress, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      Click="ExtraAddExtraBindingMenuItem_Click"/>
                                            <MenuItem Header="Release Press"
                                                      Tag="Release"
                                                      IsEnabled="{Binding PlacementTarget.DataContext.CanAddReleasePress, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      Click="ExtraAddExtraBindingMenuItem_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </DockPanel>

                            <ItemsControl ItemsSource="{Binding FunctionItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource JsmccSettingRowBorder}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="160"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               Style="{StaticResource JsmccLabelText}"/>
                                                    <TextBlock Text="Press behaviour"
                                                               Style="{StaticResource JsmccMutedText}"
                                                               Margin="0,3,0,0"/>
                                                </StackPanel>

                                                <Button Grid.Row="0"
                                                        Grid.Column="1"
                                                        Content="{Binding DisplayBind}"
                                                        Tag="{Binding}"
                                                        Click="ExtraEditBinding_Click"
                                                        Style="{StaticResource JsmccOutputButtonStyle}"
                                                        ToolTip="Edit binding output"/>

                                                <StackPanel Grid.Row="0"
                                                            Grid.Column="2"
                                                            Orientation="Horizontal"
                                                            HorizontalAlignment="Right"
                                                            Margin="10,0,0,0">
                                                    <Button Content="Edit"
                                                            Tag="{Binding}"
                                                            Click="ExtraEditBinding_Click"
                                                            Style="{StaticResource JsmccButtonStyle}"
                                                            MinWidth="58"/>
                                                    <Button Content="Remove"
                                                            Tag="{Binding}"
                                                            Click="ExtraRemoveBinding_Click"
                                                            Style="{StaticResource JsmccDangerButtonStyle}"
                                                            MinWidth="76"
                                                            Margin="8,0,0,0"
                                                            Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>

                                                <WrapPanel Grid.Row="1"
                                                           Grid.Column="0"
                                                           Grid.ColumnSpan="3"
                                                           Margin="0,6,0,0">
                                                    <Border Background="{DynamicResource JsmccBgInputBrush}"
                                                            BorderBrush="{DynamicResource JsmccBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="6,4"
                                                            Margin="0,0,8,4"
                                                            Visibility="{Binding SupportsToggle, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Toggle" Style="{StaticResource StickControlLabel}"/>
                                                            <CheckBox IsChecked="{Binding ToggleEnabled}"
                                                                      Style="{StaticResource JsmccToggleStyle}"
                                                                      VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="{DynamicResource JsmccBgInputBrush}"
                                                            BorderBrush="{DynamicResource JsmccBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="6,4"
                                                            Margin="0,0,8,4"
                                                            Visibility="{Binding SupportsTurbo, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Turbo" Style="{StaticResource StickControlLabel}"/>
                                                            <CheckBox IsChecked="{Binding TurboEnabled}"
                                                                      Style="{StaticResource JsmccToggleStyle}"
                                                                      VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="{DynamicResource JsmccBgInputBrush}"
                                                            BorderBrush="{DynamicResource JsmccBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="6,4"
                                                            Margin="0,0,8,4"
                                                            Visibility="{Binding IsTurboEnabled, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Repeat Time" Style="{StaticResource StickControlLabel}"/>
                                                            <hc:NumericUpDown Minimum="0"
                                                                              Maximum="60000"
                                                                              DecimalPlaces="0"
                                                                              Increment="10"
                                                                              Width="108"
                                                                              Style="{StaticResource JsmccNumericUpDownStyle}"
                                                                              Value="{Binding TurboDurationMs, UpdateSourceTrigger=LostFocus}"
                                                                              ValueFormat="0 ms"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="{DynamicResource JsmccBgInputBrush}"
                                                            BorderBrush="{DynamicResource JsmccBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="6,4"
                                                            Margin="0,0,8,4"
                                                            Visibility="{Binding SupportsFireDelay, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Fire Delay" Style="{StaticResource StickControlLabel}"/>
                                                            <hc:NumericUpDown Minimum="0"
                                                                              Maximum="60000"
                                                                              DecimalPlaces="0"
                                                                              Increment="10"
                                                                              Width="108"
                                                                              Style="{StaticResource JsmccNumericUpDownStyle}"
                                                                              Value="{Binding FireDelayMs, UpdateSourceTrigger=LostFocus}"
                                                                              ValueFormat="0 ms"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="{DynamicResource JsmccBgInputBrush}"
                                                            BorderBrush="{DynamicResource JsmccBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="6,4"
                                                            Margin="0,0,8,4"
                                                            Visibility="{Binding SupportsHoldTime, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Hold Time" Style="{StaticResource StickControlLabel}"/>
                                                            <hc:NumericUpDown Minimum="0"
                                                                              Maximum="60000"
                                                                              DecimalPlaces="0"
                                                                              Increment="10"
                                                                              Width="108"
                                                                              Style="{StaticResource JsmccNumericUpDownStyle}"
                                                                              Value="{Binding HoldMs, UpdateSourceTrigger=LostFocus}"
                                                                              ValueFormat="0 ms"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="{DynamicResource JsmccBgInputBrush}"
                                                            BorderBrush="{DynamicResource JsmccBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="6,4"
                                                            Margin="0,0,8,4"
                                                            Visibility="{Binding SupportsDistanceOptions, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Name" Style="{StaticResource StickControlLabel}"/>
                                                            <TextBox Text="{Binding DistanceName, UpdateSourceTrigger=LostFocus}"
                                                                     Width="128"
                                                                     Style="{StaticResource JsmccTextBoxStyle}"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="{DynamicResource JsmccBgInputBrush}"
                                                            BorderBrush="{DynamicResource JsmccBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="6,4"
                                                            Margin="0,0,8,4"
                                                            Visibility="{Binding SupportsDistanceOptions, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Distance" Style="{StaticResource StickControlLabel}"/>
                                                            <hc:NumericUpDown Minimum="0.0"
                                                                              Maximum="1.0"
                                                                              DecimalPlaces="1"
                                                                              Increment="0.1"
                                                                              Width="108"
                                                                              Style="{StaticResource JsmccNumericUpDownStyle}"
                                                                              Value="{Binding DistanceValue, UpdateSourceTrigger=LostFocus}"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="{DynamicResource JsmccBgInputBrush}"
                                                            BorderBrush="{DynamicResource JsmccBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="6,4"
                                                            Margin="0,0,8,4"
                                                            Visibility="{Binding SupportsReleaseOptions, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Min Duration" Style="{StaticResource StickControlLabel}"/>
                                                            <TextBox Text="{Binding ReleaseDurationMs, UpdateSourceTrigger=LostFocus}"
                                                                     Width="72"
                                                                     Style="{StaticResource JsmccTextBoxStyle}"/>
                                                            <TextBlock Text="ms"
                                                                       Style="{StaticResource JsmccMutedText}"
                                                                       Margin="6,0,0,0"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="{DynamicResource JsmccBgInputBrush}"
                                                            BorderBrush="{DynamicResource JsmccBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="6,4"
                                                            Margin="0,0,8,4"
                                                            Visibility="{Binding SupportsReleaseOptions, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="End Delay" Style="{StaticResource StickControlLabel}"/>
                                                            <TextBox Text="{Binding ReleaseDelayMs, UpdateSourceTrigger=LostFocus}"
                                                                     Width="72"
                                                                     Style="{StaticResource JsmccTextBoxStyle}"/>
                                                            <TextBlock Text="ms"
                                                                       Style="{StaticResource JsmccMutedText}"
                                                                       Margin="6,0,0,0"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="{DynamicResource JsmccBgInputBrush}"
                                                            BorderBrush="{DynamicResource JsmccBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="6,4"
                                                            Margin="0,0,8,4"
                                                            Visibility="{Binding SupportsReleaseOptions, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Interruptible" Style="{StaticResource StickControlLabel}"/>
                                                            <CheckBox IsChecked="{Binding ReleaseInterruptable}"
                                                                      Style="{StaticResource JsmccToggleStyle}"
                                                                      VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </WrapPanel>

                                                <ContentControl x:Name="InlineEditorHost"
                                                                Grid.Row="2"
                                                                Grid.Column="0"
                                                                Grid.ColumnSpan="3"
                                                                Visibility="Collapsed"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </DockPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
