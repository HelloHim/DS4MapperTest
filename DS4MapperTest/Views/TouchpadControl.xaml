<UserControl x:Class="DS4MapperTest.Views.TouchpadControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             mc:Ignorable="d"
             d:DesignHeight="560"
             d:DesignWidth="860">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="TouchpadInlineCard" TargetType="Border" BasedOn="{StaticResource JsmccCardBorder}">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <DataTemplate x:Key="TouchpadBindingTemplate">
            <Border Style="{StaticResource TouchpadInlineCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="{Binding DisplayName}"
                                   Style="{StaticResource JsmccCardTitle}"/>
                        <TextBlock Text="{Binding BindingName}"
                                   Style="{StaticResource JsmccMutedText}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,14,0">
                        <TextBlock Text="Mode"
                                   Style="{StaticResource JsmccMutedText}"
                                   Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding AvailableActionOptions}"
                                  SelectedValuePath="Index"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValue="{Binding SelectedActionIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource ComboBoxBaseStyle}"
                                  MinWidth="180"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="{Binding BindingStatus}"
                                   Style="{StaticResource JsmccBodyText}"
                                   TextWrapping="Wrap"/>
                        <ContentControl Tag="Bindings"
                                        DataContext="{Binding}"
                                        Loaded="InlineSettingsHost_Loaded"
                                        Margin="0,10,0,0"/>
                    </StackPanel>

                    <Border Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="3"
                            Style="{StaticResource JsmccSettingRowBorder}"
                            Margin="0,10,0,0"
                            Visibility="{Binding HasTouchpadClickBinding, Converter={StaticResource BoolToVis}}">
                        <StackPanel DataContext="{Binding TouchpadClickBinding}">
                            <DockPanel LastChildFill="False" Margin="0,0,0,2">
                                <StackPanel DockPanel.Dock="Left">
                                    <TextBlock Text="{Binding DisplayName}"
                                               Style="{StaticResource JsmccLabelText}"/>
                                    <TextBlock Text="{Binding Subtitle}"
                                               Style="{StaticResource JsmccMutedText}"
                                               Margin="0,3,0,0"/>
                                </StackPanel>

                                <Button DockPanel.Dock="Right"
                                        Content="Add Extra Binding"
                                        Click="TouchpadClickAddExtraBindingButton_Click"
                                        Style="{StaticResource JsmccButtonStyle}">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Hold Press"
                                                      Tag="Hold"
                                                      IsEnabled="{Binding PlacementTarget.DataContext.CanAddHoldPress, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      Click="TouchpadClickAddExtraBindingMenuItem_Click"/>
                                            <MenuItem Header="Double Press"
                                                      Tag="Double"
                                                      IsEnabled="{Binding PlacementTarget.DataContext.CanAddDoublePress, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      Click="TouchpadClickAddExtraBindingMenuItem_Click"/>
                                            <MenuItem Header="Distance"
                                                      Tag="Distance"
                                                      IsEnabled="{Binding PlacementTarget.DataContext.CanAddDistancePress, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      Click="TouchpadClickAddExtraBindingMenuItem_Click"/>
                                            <MenuItem Header="Start Press"
                                                      Tag="Start"
                                                      IsEnabled="{Binding PlacementTarget.DataContext.CanAddStartPress, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      Click="TouchpadClickAddExtraBindingMenuItem_Click"/>
                                            <MenuItem Header="Release Press"
                                                      Tag="Release"
                                                      IsEnabled="{Binding PlacementTarget.DataContext.CanAddReleasePress, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                                      Click="TouchpadClickAddExtraBindingMenuItem_Click"/>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </Button>
                            </DockPanel>

                            <ItemsControl ItemsSource="{Binding FunctionItems}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource JsmccSettingRowBorder}">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="150"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,12,0">
                                                    <TextBlock Text="{Binding DisplayName}"
                                                               Style="{StaticResource JsmccLabelText}"/>
                                                    <TextBlock Text="Press behaviour"
                                                               Style="{StaticResource JsmccMutedText}"
                                                               Margin="0,3,0,0"/>
                                                </StackPanel>

                                                <Button Grid.Row="0"
                                                        Grid.Column="1"
                                                        Content="{Binding DisplayBind}"
                                                        Tag="{Binding}"
                                                        Click="TouchpadClickEditBinding_Click"
                                                        Style="{StaticResource JsmccOutputButtonStyle}"
                                                        ToolTip="Edit binding output"/>

                                                <StackPanel Grid.Row="0"
                                                            Grid.Column="2"
                                                            Orientation="Horizontal"
                                                            HorizontalAlignment="Right"
                                                            Margin="10,0,0,0">
                                                    <Button Content="Edit"
                                                            Tag="{Binding}"
                                                            Click="TouchpadClickEditBinding_Click"
                                                            Style="{StaticResource JsmccButtonStyle}"
                                                            MinWidth="58"/>
                                                    <Button Content="Remove"
                                                            Tag="{Binding}"
                                                            Click="TouchpadClickRemoveBinding_Click"
                                                            Style="{StaticResource JsmccDangerButtonStyle}"
                                                            MinWidth="76"
                                                            Margin="8,0,0,0"
                                                            Visibility="{Binding CanRemove, Converter={StaticResource BoolToVis}}"/>
                                                </StackPanel>

                                                <WrapPanel Grid.Row="1"
                                                           Grid.Column="0"
                                                           Grid.ColumnSpan="3"
                                                           Margin="0,6,0,0">
                                                    <Border Background="{DynamicResource JsmccBgInputBrush}"
                                                            BorderBrush="{DynamicResource JsmccBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="6,4"
                                                            Margin="0,0,8,4"
                                                            Visibility="{Binding SupportsToggle, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Toggle" Style="{StaticResource JsmccLabelText}" Margin="0,0,8,0"/>
                                                            <CheckBox IsChecked="{Binding ToggleEnabled}"
                                                                      Style="{StaticResource JsmccToggleStyle}"
                                                                      VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="{DynamicResource JsmccBgInputBrush}"
                                                            BorderBrush="{DynamicResource JsmccBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="6,4"
                                                            Margin="0,0,8,4"
                                                            Visibility="{Binding SupportsTurbo, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Turbo" Style="{StaticResource JsmccLabelText}" Margin="0,0,8,0"/>
                                                            <CheckBox IsChecked="{Binding TurboEnabled}"
                                                                      Style="{StaticResource JsmccToggleStyle}"
                                                                      VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="{DynamicResource JsmccBgInputBrush}"
                                                            BorderBrush="{DynamicResource JsmccBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="6,4"
                                                            Margin="0,0,8,4"
                                                            Visibility="{Binding IsTurboEnabled, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Repeat Time" Style="{StaticResource JsmccLabelText}" Margin="0,0,8,0"/>
                                                            <hc:NumericUpDown Minimum="0"
                                                                              Maximum="60000"
                                                                              DecimalPlaces="0"
                                                                              Increment="10"
                                                                              Width="108"
                                                                              Style="{StaticResource JsmccNumericUpDownStyle}"
                                                                              Value="{Binding TurboDurationMs, UpdateSourceTrigger=LostFocus}"
                                                                              ValueFormat="0 ms"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="{DynamicResource JsmccBgInputBrush}"
                                                            BorderBrush="{DynamicResource JsmccBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="6,4"
                                                            Margin="0,0,8,4"
                                                            Visibility="{Binding SupportsFireDelay, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Fire Delay" Style="{StaticResource JsmccLabelText}" Margin="0,0,8,0"/>
                                                            <hc:NumericUpDown Minimum="0"
                                                                              Maximum="60000"
                                                                              DecimalPlaces="0"
                                                                              Increment="10"
                                                                              Width="108"
                                                                              Style="{StaticResource JsmccNumericUpDownStyle}"
                                                                              Value="{Binding FireDelayMs, UpdateSourceTrigger=LostFocus}"
                                                                              ValueFormat="0 ms"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="{DynamicResource JsmccBgInputBrush}"
                                                            BorderBrush="{DynamicResource JsmccBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="6,4"
                                                            Margin="0,0,8,4"
                                                            Visibility="{Binding SupportsHoldTime, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Hold Time" Style="{StaticResource JsmccLabelText}" Margin="0,0,8,0"/>
                                                            <hc:NumericUpDown Minimum="0"
                                                                              Maximum="60000"
                                                                              DecimalPlaces="0"
                                                                              Increment="10"
                                                                              Width="108"
                                                                              Style="{StaticResource JsmccNumericUpDownStyle}"
                                                                              Value="{Binding HoldMs, UpdateSourceTrigger=LostFocus}"
                                                                              ValueFormat="0 ms"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="{DynamicResource JsmccBgInputBrush}"
                                                            BorderBrush="{DynamicResource JsmccBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="6,4"
                                                            Margin="0,0,8,4"
                                                            Visibility="{Binding SupportsTapWindow, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Tap Window" Style="{StaticResource JsmccLabelText}" Margin="0,0,8,0"/>
                                                            <hc:NumericUpDown Minimum="0"
                                                                              Maximum="60000"
                                                                              DecimalPlaces="0"
                                                                              Increment="10"
                                                                              Width="108"
                                                                              Style="{StaticResource JsmccNumericUpDownStyle}"
                                                                              Value="{Binding TapWindowMs, UpdateSourceTrigger=LostFocus}"
                                                                              ValueFormat="0 ms"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="{DynamicResource JsmccBgInputBrush}"
                                                            BorderBrush="{DynamicResource JsmccBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="6,4"
                                                            Margin="0,0,8,4"
                                                            Visibility="{Binding SupportsDistanceOptions, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Name" Style="{StaticResource JsmccLabelText}" Margin="0,0,8,0"/>
                                                            <TextBox Text="{Binding DistanceName, UpdateSourceTrigger=LostFocus}"
                                                                     Width="128"
                                                                     Style="{StaticResource JsmccTextBoxStyle}"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="{DynamicResource JsmccBgInputBrush}"
                                                            BorderBrush="{DynamicResource JsmccBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="6,4"
                                                            Margin="0,0,8,4"
                                                            Visibility="{Binding SupportsDistanceOptions, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Distance" Style="{StaticResource JsmccLabelText}" Margin="0,0,8,0"/>
                                                            <hc:NumericUpDown Minimum="0.0"
                                                                              Maximum="1.0"
                                                                              DecimalPlaces="1"
                                                                              Increment="0.1"
                                                                              Width="108"
                                                                              Style="{StaticResource JsmccNumericUpDownStyle}"
                                                                              Value="{Binding DistanceValue, UpdateSourceTrigger=LostFocus}"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="{DynamicResource JsmccBgInputBrush}"
                                                            BorderBrush="{DynamicResource JsmccBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="6,4"
                                                            Margin="0,0,8,4"
                                                            Visibility="{Binding SupportsReleaseOptions, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Min Duration" Style="{StaticResource JsmccLabelText}" Margin="0,0,8,0"/>
                                                            <TextBox Text="{Binding ReleaseDurationMs, UpdateSourceTrigger=LostFocus}"
                                                                     Width="72"
                                                                     Style="{StaticResource JsmccTextBoxStyle}"/>
                                                            <TextBlock Text="ms"
                                                                       Style="{StaticResource JsmccMutedText}"
                                                                       Margin="6,0,0,0"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="{DynamicResource JsmccBgInputBrush}"
                                                            BorderBrush="{DynamicResource JsmccBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="6,4"
                                                            Margin="0,0,8,4"
                                                            Visibility="{Binding SupportsReleaseOptions, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="End Delay" Style="{StaticResource JsmccLabelText}" Margin="0,0,8,0"/>
                                                            <TextBox Text="{Binding ReleaseDelayMs, UpdateSourceTrigger=LostFocus}"
                                                                     Width="72"
                                                                     Style="{StaticResource JsmccTextBoxStyle}"/>
                                                            <TextBlock Text="ms"
                                                                       Style="{StaticResource JsmccMutedText}"
                                                                       Margin="6,0,0,0"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <Border Background="{DynamicResource JsmccBgInputBrush}"
                                                            BorderBrush="{DynamicResource JsmccBorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="6,4"
                                                            Margin="0,0,8,4"
                                                            Visibility="{Binding SupportsReleaseOptions, Converter={StaticResource BoolToVis}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="Interruptible" Style="{StaticResource JsmccLabelText}" Margin="0,0,8,0"/>
                                                            <CheckBox IsChecked="{Binding ReleaseInterruptable}"
                                                                      Style="{StaticResource JsmccToggleStyle}"
                                                                      VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                </WrapPanel>

                                                <ContentControl x:Name="InlineEditorHost"
                                                                Grid.Row="2"
                                                                Grid.Column="0"
                                                                Grid.ColumnSpan="3"
                                                                Visibility="Collapsed"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TouchpadSectionTemplate">
            <Border Style="{StaticResource TouchpadInlineCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding DisplayName}"
                                       Style="{StaticResource JsmccCardTitle}"/>
                            <TextBlock Text="{Binding ActionDisplayName}"
                                       Style="{StaticResource JsmccMutedText}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>

                        <ContentControl Grid.Column="1"
                                        Tag="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=Tag}"
                                        DataContext="{Binding}"
                                        Loaded="InlineSettingsHost_Loaded"/>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False">
        <TabControl Style="{StaticResource JsmccPillTabControlStyle}">
            <TabItem Header="Bindings">
                <StackPanel>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="Bindings" Style="{StaticResource JsmccSectionTitle}"/>
                        <TextBlock Text="Choose the touchpad mode for each input exposed by the current controller."
                                   Style="{StaticResource JsmccBodyText}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource TouchpadInlineCard}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TouchpadBindings.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="No supported touchpad binding inputs are available for this controller."
                                   Style="{StaticResource JsmccBodyText}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <ItemsControl ItemsSource="{Binding TouchpadBindings}"
                                  ItemTemplate="{StaticResource TouchpadBindingTemplate}"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Mouse &amp; Movement">
                <StackPanel>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="Mouse &amp; Movement" Style="{StaticResource JsmccSectionTitle}"/>
                        <TextBlock Text="Movement settings are shown per touchpad input when that input uses a movement mode."
                                   Style="{StaticResource JsmccBodyText}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding TouchpadBindings}"
                                  ItemTemplate="{StaticResource TouchpadSectionTemplate}"
                                  Tag="MouseMovement"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Sensitivity &amp; Calibration">
                <StackPanel>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="Sensitivity &amp; Calibration" Style="{StaticResource JsmccSectionTitle}"/>
                        <TextBlock Text="Calibration, base and vertical sensitivity, and acceleration curve settings are shown per touchpad input when the selected mode supports them."
                                   Style="{StaticResource JsmccBodyText}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding TouchpadBindings}"
                                  ItemTemplate="{StaticResource TouchpadSectionTemplate}"
                                  Tag="SensitivityCalibration"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Filtering &amp; Stabilisation">
                <StackPanel>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="Filtering &amp; Stabilisation" Style="{StaticResource JsmccSectionTitle}"/>
                        <TextBlock Text="Deadzone, angle snapping, jitter compensation, and smoothing settings are shown per touchpad input when the selected mode supports them."
                                   Style="{StaticResource JsmccBodyText}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding TouchpadBindings}"
                                  ItemTemplate="{StaticResource TouchpadSectionTemplate}"
                                  Tag="FilteringStabilisation"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Zones &amp; Gestures">
                <StackPanel>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="Zones &amp; Gestures" Style="{StaticResource JsmccSectionTitle}"/>
                        <TextBlock Text="Zone and gesture settings are shown per touchpad input when the selected mode supports them."
                                   Style="{StaticResource JsmccBodyText}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding TouchpadBindings}"
                                  ItemTemplate="{StaticResource TouchpadSectionTemplate}"
                                  Tag="ZonesGestures"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Trackball &amp; Scroll">
                <StackPanel>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="Trackball &amp; Scroll" Style="{StaticResource JsmccSectionTitle}"/>
                        <TextBlock Text="Touchpad trackball and scroll settings are shown per touchpad input when available."
                                   Style="{StaticResource JsmccBodyText}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding TouchpadBindings}"
                                  ItemTemplate="{StaticResource TouchpadSectionTemplate}"
                                  Tag="TrackballScroll"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Advanced">
                <StackPanel>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="Advanced" Style="{StaticResource JsmccSectionTitle}"/>
                        <TextBlock Text="Mode-specific DS4MapperTest options appear here when the selected touchpad mode has advanced settings."
                                   Style="{StaticResource JsmccBodyText}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Style="{StaticResource TouchpadInlineCard}"
                            DataContext="{Binding SteamPadRotation}">
                        <Border.Visibility>
                            <Binding Path="DataContext.HasSteamPadRotation"
                                     RelativeSource="{RelativeSource AncestorType=UserControl}"
                                     Converter="{StaticResource BoolToVis}"/>
                        </Border.Visibility>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Steam Controller Pad Rotation"
                                           Style="{StaticResource JsmccCardTitle}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="Adjusts the physical pad rotation used by Steam Controller touchpads."
                                           Style="{StaticResource JsmccMutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <Border Style="{StaticResource JsmccSettingRowBorder}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="112"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Left Pad Rotation"
                                                   Style="{StaticResource JsmccLabelText}"
                                                   VerticalAlignment="Center"/>
                                        <Slider Grid.Column="1"
                                                Minimum="-180"
                                                Maximum="180"
                                                Value="{Binding LeftPadRotation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Margin="8,0,12,0"
                                                VerticalAlignment="Center"/>
                                        <hc:NumericUpDown Grid.Column="2"
                                                          Minimum="-180"
                                                          Maximum="180"
                                                          DecimalPlaces="0"
                                                          Increment="1"
                                                          Value="{Binding LeftPadRotation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource JsmccNumericUpDownStyle}"
                                                          ValueFormat="0 deg"/>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource JsmccSettingRowBorder}" Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="112"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Right Pad Rotation"
                                                   Style="{StaticResource JsmccLabelText}"
                                                   VerticalAlignment="Center"/>
                                        <Slider Grid.Column="1"
                                                Minimum="-180"
                                                Maximum="180"
                                                Value="{Binding RightPadRotation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Margin="8,0,12,0"
                                                VerticalAlignment="Center"/>
                                        <hc:NumericUpDown Grid.Column="2"
                                                          Minimum="-180"
                                                          Maximum="180"
                                                          DecimalPlaces="0"
                                                          Increment="1"
                                                          Value="{Binding RightPadRotation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource JsmccNumericUpDownStyle}"
                                                          ValueFormat="0 deg"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding TouchpadBindings}"
                                  ItemTemplate="{StaticResource TouchpadSectionTemplate}"
                                  Tag="Advanced"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </ScrollViewer>
</UserControl>
