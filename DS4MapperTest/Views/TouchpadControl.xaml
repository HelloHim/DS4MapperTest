<UserControl x:Class="DS4MapperTest.Views.TouchpadControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:views="clr-namespace:DS4MapperTest.Views"
             mc:Ignorable="d"
             d:DesignHeight="560"
             d:DesignWidth="860">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="TouchpadInlineCard" TargetType="Border" BasedOn="{StaticResource JsmccCardBorder}">
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <DataTemplate x:Key="TouchpadBindingTemplate">
            <Border Style="{StaticResource TouchpadInlineCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="470"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="{Binding DisplayName}"
                                   Style="{StaticResource JsmccCardTitle}"/>
                        <TextBlock Text="{Binding BindingName}"
                                   Style="{StaticResource JsmccMutedText}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,14,0">
                        <TextBlock Text="Mode"
                                   Style="{StaticResource JsmccMutedText}"
                                   Margin="0,0,0,4"/>
                        <ComboBox ItemsSource="{Binding AvailableActionOptions}"
                                  SelectedValuePath="Index"
                                  DisplayMemberPath="DisplayName"
                                  SelectedValue="{Binding SelectedActionIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{StaticResource ComboBoxBaseStyle}"
                                  MinWidth="180"/>
                        <ContentControl Tag="Extra"
                                        DataContext="{Binding}"
                                        Loaded="InlineSettingsHost_Loaded"
                                        Margin="0,10,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Row="0" Grid.Column="2">
                        <TextBlock Text="{Binding BindingStatus}"
                                   Style="{StaticResource JsmccBodyText}"
                                   TextWrapping="Wrap"
                                   MaxWidth="360"
                                   HorizontalAlignment="Left"/>
                        <ContentControl Tag="Bindings"
                                        DataContext="{Binding}"
                                        Loaded="InlineSettingsHost_Loaded"
                                        Margin="0,10,0,0"/>
                    </StackPanel>

                </Grid>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TouchpadSectionTemplate">
            <Border Style="{StaticResource TouchpadInlineCard}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding DisplayName}"
                                       Style="{StaticResource JsmccCardTitle}"/>
                            <TextBlock Text="{Binding ActionDisplayName}"
                                       Style="{StaticResource JsmccMutedText}"
                                       Margin="0,3,0,0"/>
                        </StackPanel>

                        <ContentControl Grid.Column="1"
                                        Tag="{Binding RelativeSource={RelativeSource AncestorType=ItemsControl}, Path=Tag}"
                                        DataContext="{Binding}"
                                        Loaded="InlineSettingsHost_Loaded"/>
                    </Grid>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="TouchpadAdvancedSectionTemplate">
            <Border Style="{StaticResource TouchpadInlineCard}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="{Binding DisplayName}"
                                   Style="{StaticResource JsmccCardTitle}"/>
                        <TextBlock Text="{Binding ActionDisplayName}"
                                   Style="{StaticResource JsmccMutedText}"
                                   Margin="0,3,0,0"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding AdvancedTouchpadSettingsEmptyMessage}"
                                   Style="{StaticResource JsmccBodyText}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding ShowAdvancedTouchpadSettingsEmptyMessage, Converter={StaticResource BoolToVis}}"/>

                        <ContentControl Tag="FilteringStabilisation"
                                        DataContext="{Binding}"
                                        Loaded="InlineSettingsHost_Loaded"
                                        Visibility="{Binding IsFilteringStabilisationAction, Converter={StaticResource BoolToVis}}"
                                        Margin="0,0,0,10"/>

                        <ContentControl Tag="ZonesGestures"
                                        DataContext="{Binding}"
                                        Loaded="InlineSettingsHost_Loaded"
                                        Visibility="{Binding IsZoneGestureAction, Converter={StaticResource BoolToVis}}"
                                        Margin="0,0,0,10"/>

                        <ContentControl Tag="TrackballScroll"
                                        DataContext="{Binding}"
                                        Loaded="InlineSettingsHost_Loaded"
                                        Visibility="{Binding IsTrackballScrollAction, Converter={StaticResource BoolToVis}}"
                                        Margin="0,0,0,10"/>

                        <ContentControl Tag="Advanced"
                                        DataContext="{Binding}"
                                        Loaded="InlineSettingsHost_Loaded"
                                        Visibility="{Binding IsAdvancedAction, Converter={StaticResource BoolToVis}}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False">
        <TabControl Style="{StaticResource JsmccPillTabControlStyle}">
            <TabItem Header="Touchpad Keybinds">
                <StackPanel>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="Touchpad Keybinds" Style="{StaticResource JsmccSectionTitle}"/>
                        <TextBlock Text="Touch and click bindings for this touchpad. These are always available, regardless of the mode chosen in Mode."
                                   Style="{StaticResource JsmccBodyText}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <views:SharedButtonKeybindsControl
                        SectionTitle="Touch &amp; Click"
                        Description="Physical touchpad touch and click inputs exposed by the current controller."
                        EmptyText="No touchpad touch or click bindings were found for this controller."
                        CardSubtitle="Touchpad input"
                        ItemsSource="{Binding TouchpadButtonBindings}"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Mode">
                <StackPanel>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="Mode" Style="{StaticResource JsmccSectionTitle}"/>
                        <TextBlock Text="Choose the touchpad mode for each input exposed by the current controller, and give it a custom name."
                                   Style="{StaticResource JsmccBodyText}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <Border>
                        <Border.Style>
                            <Style TargetType="Border" BasedOn="{StaticResource TouchpadInlineCard}">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding TouchpadBindings.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <TextBlock Text="No supported touchpad binding inputs are available for this controller."
                                   Style="{StaticResource JsmccBodyText}"
                                   TextWrapping="Wrap"/>
                    </Border>

                    <ItemsControl ItemsSource="{Binding TouchpadBindings}"
                                  ItemTemplate="{StaticResource TouchpadBindingTemplate}"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Mouse &amp; Movement">
                <StackPanel>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="Mouse &amp; Movement" Style="{StaticResource JsmccSectionTitle}"/>
                        <TextBlock Text="Movement settings are shown per touchpad input when that input uses a movement mode."
                                   Style="{StaticResource JsmccBodyText}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding TouchpadBindings}"
                                  ItemTemplate="{StaticResource TouchpadSectionTemplate}"
                                  Tag="MouseMovement"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Sensitivity &amp; Calibration">
                <StackPanel>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="Sensitivity &amp; Calibration" Style="{StaticResource JsmccSectionTitle}"/>
                        <TextBlock Text="Calibration, base and vertical sensitivity, and acceleration curve settings are shown per touchpad input when the selected mode supports them."
                                   Style="{StaticResource JsmccBodyText}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding TouchpadBindings}"
                                  ItemTemplate="{StaticResource TouchpadSectionTemplate}"
                                  Tag="SensitivityCalibration"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Mode Settings">
                <StackPanel>
                    <StackPanel Margin="0,0,0,6">
                        <TextBlock Text="Mode Settings" Style="{StaticResource JsmccSectionTitle}"/>
                        <TextBlock Text="Filtering, zone and gesture, trackball and scroll, and other advanced settings are shown per touchpad input, based on what the selected mode supports."
                                   Style="{StaticResource JsmccBodyText}"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                    <Border Style="{StaticResource TouchpadInlineCard}"
                            DataContext="{Binding SteamPadRotation}">
                        <Border.Visibility>
                            <Binding Path="DataContext.HasSteamPadRotation"
                                     RelativeSource="{RelativeSource AncestorType=UserControl}"
                                     Converter="{StaticResource BoolToVis}"/>
                        </Border.Visibility>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="220"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <TextBlock Text="Steam Controller Pad Rotation"
                                           Style="{StaticResource JsmccCardTitle}"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="Adjusts the physical pad rotation used by Steam Controller touchpads."
                                           Style="{StaticResource JsmccMutedText}"
                                           TextWrapping="Wrap"
                                           Margin="0,3,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1">
                                <Border Style="{StaticResource JsmccSettingRowBorder}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="112"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Left Pad Rotation (deg)"
                                                   Style="{StaticResource JsmccLabelText}"
                                                   VerticalAlignment="Center"/>
                                        <Slider Grid.Column="1"
                                                Minimum="-180"
                                                Maximum="180"
                                                Value="{Binding LeftPadRotation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Margin="8,0,12,0"
                                                VerticalAlignment="Center"/>
                                        <hc:NumericUpDown Grid.Column="2"
                                                          Minimum="-180"
                                                          Maximum="180"
                                                          DecimalPlaces="0"
                                                          Increment="1"
                                                          Value="{Binding LeftPadRotation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource JsmccNumericUpDownStyle}"/>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource JsmccSettingRowBorder}" Margin="0,8,0,0">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="140"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="112"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0"
                                                   Text="Right Pad Rotation (deg)"
                                                   Style="{StaticResource JsmccLabelText}"
                                                   VerticalAlignment="Center"/>
                                        <Slider Grid.Column="1"
                                                Minimum="-180"
                                                Maximum="180"
                                                Value="{Binding RightPadRotation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Margin="8,0,12,0"
                                                VerticalAlignment="Center"/>
                                        <hc:NumericUpDown Grid.Column="2"
                                                          Minimum="-180"
                                                          Maximum="180"
                                                          DecimalPlaces="0"
                                                          Increment="1"
                                                          Value="{Binding RightPadRotation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource JsmccNumericUpDownStyle}"/>
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ItemsControl ItemsSource="{Binding TouchpadBindings}"
                                  ItemTemplate="{StaticResource TouchpadAdvancedSectionTemplate}"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </ScrollViewer>
</UserControl>
