<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <Nullable>disable</Nullable>
    <UseWPF>true</UseWPF>
    <Platforms>x64</Platforms>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <EnableNETAnalyzers>False</EnableNETAnalyzers>
    <RunAnalyzersDuringLiveAnalysis>False</RunAnalyzersDuringLiveAnalysis>
    <!-- Server GC gives every core its own heap and collection thread and
         trades pause length for throughput. This app is a latency sensitive
         background process that runs alongside games, so it wants the
         opposite: short pauses and no extra threads competing for the cores
         the game is using. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <AssemblyVersion>1.0.0</AssemblyVersion>
    <FileVersion>1.0.0</FileVersion>
    <Version>1.0.0-beta</Version>
    <ApplicationIcon>images\DS4MapperTestAppIcon.ico</ApplicationIcon>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <Configurations>Debug;Release;Debug Tests;Release Tests</Configurations>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <DefineConstants>$(DefineConstants);WIN64;DS4MAPPER_DEV_APPDATA</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug Tests|x64'">
    <DefineConstants>$(DefineConstants);WIN64;MAKE_TESTS;DS4MAPPER_DEV_APPDATA</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <DefineConstants>$(DefineConstants);WIN64</DefineConstants>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release Tests|x64'">
    <DefineConstants>$(DefineConstants);WIN64;MAKE_TESTS</DefineConstants>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="libs\x64\**" Condition="'$(Platform)' != 'x64'" />
    <None Remove="libs\x86\**" Condition="'$(Platform)' != 'x86'" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets the unit test project call a small number of internal test
         hooks (e.g. Mapper.AcquireSharedMouseButton/ReleaseSharedMouseButton)
         directly instead of widening them to public. -->
    <InternalsVisibleTo Include="DS4MapperUnitTests" />
  </ItemGroup>

  <!-- Apparently the None tags are needed as well as the Resource tags.
       Without the None, app slowdown occurs for me. Why?!!! -->
  <ItemGroup>
    <None Remove="images\circle-info-solid.png" />
    <None Remove="images\gamepad-solid.png" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="images\circle-info-solid.png" />
    <Resource Include="images\gamepad-solid.png" />
  </ItemGroup>
  
  <ItemGroup>
    <PackageReference Include="HandyControl" Version="3.5.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NLog" Version="6.1.3" />
    <PackageReference Include="SDL3-CS" Version="3.4.14.1" />
    <PackageReference Include="SDL3-CS.Windows" Version="3.4.14.1" />
    <PackageReference Include="WpfScreenHelper" Version="2.1.1" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="FakerInputWrapper">
      <HintPath>libs\$(Platform)\FakerInputWrapper\FakerInputWrapper.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Update="libs\$(Platform)\FakerInputWrapper\FakerInputDll.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>FakerInputDll.dll</Link>
    </None>
    <None Update="libs\$(Platform)\VIIPER\libVIIPER.dll">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>libVIIPER.dll</Link>
    </None>
    <None Update="NLog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <EmbeddedResource Include="..\template_profiles\**\*">
      <Link>template_profiles\%(RecursiveDir)%(Filename)%(Extension)</Link>
    </EmbeddedResource>
  </ItemGroup>

  <Target Name="RemoveLegacyTemplateProfilesOutput" AfterTargets="Build">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -Command &quot;Remove-Item -LiteralPath '$(TargetDir)template_profiles' -Recurse -Force -ErrorAction SilentlyContinue&quot;"
          Condition="Exists('$(TargetDir)template_profiles')" />
  </Target>

  <PropertyGroup>
    <Sdl3WindowsNativePath>$(NuGetPackageRoot)sdl3-cs.windows\3.4.14.1\runtimes\win-x64\native\SDL3.dll</Sdl3WindowsNativePath>
  </PropertyGroup>

  <Target Name="CopySdl3WindowsNativeLibrary" AfterTargets="Build"
          Condition="'$(Platform)' == 'x64' and Exists('$(Sdl3WindowsNativePath)')">
    <Copy SourceFiles="$(Sdl3WindowsNativePath)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopySdl3WindowsNativeLibraryOnPublish" AfterTargets="Publish"
          Condition="'$(Platform)' == 'x64' and '$(PublishDir)' != '' and Exists('$(Sdl3WindowsNativePath)')">
    <Copy SourceFiles="$(Sdl3WindowsNativePath)"
          DestinationFolder="$(PublishDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
