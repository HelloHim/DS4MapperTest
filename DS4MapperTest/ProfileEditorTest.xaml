<Window x:Class="DS4MapperTest.ProfileEditorTest"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:views="clr-namespace:DS4MapperTest.Views"
        mc:Ignorable="d"
        Title="DS4Mapper - Profile Editor"
        Height="720" Width="1100"
        MinHeight="600" MinWidth="900"
        Closed="Window_Closed">

    <Window.Background>
        <SolidColorBrush Color="{DynamicResource RegionColor}"/>
    </Window.Background>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="NavTabStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="20,13,16,13"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="3,0,0,0"
                                BorderBrush="Transparent">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ItemSelectBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PlaceholderHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="PlaceholderSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        </Style>
        <Style x:Key="PlaceholderNote" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Foreground" Value="{DynamicResource ThirdlyTextBrush}"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Border DockPanel.Dock="Top"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource BorderBrush}"
                Padding="16,10">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Profile:"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="12"
                               Margin="0,0,8,0"/>
                    <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=LostFocus}"
                             Width="220"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="Save"
                            Click="SaveProfileButton_Click"
                            Style="{StaticResource ButtonPrimary}"
                            Padding="16,6"
                            Margin="0,0,8,0"/>
                    <Button Content="Save &amp; Close"
                            Click="SaveProfileAndCloseButton_Click"
                            Padding="16,6"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid DockPanel.Dock="Top" Visibility="Collapsed">
            <hc:ColorPicker x:Name="ColorPicker"
                            SelectedColorChanged="ColorPicker_SelectedColorChanged"/>
            <hc:ColorPicker x:Name="ColorPickerBattery"
                            SelectedColorChanged="ColorPickerBattery_SelectedColorChanged"/>
            <hc:ColorPicker x:Name="ColorPickerPulse"
                            SelectedColorChanged="ColorPickerPulse_SelectedColorChanged"/>
        </Grid>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource BorderBrush}">
                <StackPanel Margin="0,8,0,0">
                    <RadioButton x:Name="navGyroSensitivity"
                                 GroupName="MainNav"
                                 Content="Gyro &amp; Sensitivity"
                                 Style="{StaticResource NavTabStyle}"
                                 IsChecked="True"/>
                    <RadioButton x:Name="navKeybinds"
                                 GroupName="MainNav"
                                 Content="Keybinds"
                                 Style="{StaticResource NavTabStyle}"/>
                    <RadioButton x:Name="navTrackpad"
                                 GroupName="MainNav"
                                 Content="Trackpad"
                                 Style="{StaticResource NavTabStyle}"/>
                    <RadioButton x:Name="navSticks"
                                 GroupName="MainNav"
                                 Content="Sticks"
                                 Style="{StaticResource NavTabStyle}"/>
                    <RadioButton x:Name="navOther"
                                 GroupName="MainNav"
                                 Content="Other"
                                 Style="{StaticResource NavTabStyle}"/>
                </StackPanel>
            </Border>

            <Grid Grid.Column="1">
                <Border Padding="28,24"
                        Visibility="{Binding IsChecked, ElementName=navGyroSensitivity, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Gyro &amp; Sensitivity" Style="{StaticResource PlaceholderHeading}"/>
                        <TextBlock Text="Configure gyro behaviour, sensitivity, and curve settings."
                                   Style="{StaticResource PlaceholderSub}"/>
                        <Separator Margin="0,16,0,16"/>
                        <TextBlock Text="Settings are not wired in this phase." Style="{StaticResource PlaceholderNote}"/>
                    </StackPanel>
                </Border>

                <Border Padding="28,24"
                        Visibility="{Binding IsChecked, ElementName=navKeybinds, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Keybinds" Style="{StaticResource PlaceholderHeading}"/>
                            <TextBlock Text="Map controller buttons to keyboard, mouse, and gamepad outputs."
                                       Style="{StaticResource PlaceholderSub}"/>
                        </StackPanel>

                        <TabControl Margin="0,16,0,0">
                            <TabItem Header="Face">
                                <views:FaceKeybindsControl Margin="0,16,0,0"/>
                            </TabItem>
                            <TabItem Header="D-Pad">
                                <StackPanel Margin="0,16,0,0">
                                    <TextBlock Text="D-Pad" Style="{StaticResource PlaceholderHeading}"/>
                                    <TextBlock Text="Placeholder only. Controls are not wired in this phase."
                                               Style="{StaticResource PlaceholderNote}"/>
                                </StackPanel>
                            </TabItem>
                            <TabItem Header="Bumpers">
                                <views:BumpersKeybindsControl Margin="0,16,0,0"/>
                            </TabItem>
                            <TabItem Header="Triggers">
                                <StackPanel Margin="0,16,0,0">
                                    <TextBlock Text="Triggers" Style="{StaticResource PlaceholderHeading}"/>
                                    <TextBlock Text="Placeholder only. Controls are not wired in this phase."
                                               Style="{StaticResource PlaceholderNote}"/>
                                </StackPanel>
                            </TabItem>
                            <TabItem Header="Center">
                                <StackPanel Margin="0,16,0,0">
                                    <TextBlock Text="Center" Style="{StaticResource PlaceholderHeading}"/>
                                    <TextBlock Text="Placeholder only. Controls are not wired in this phase."
                                               Style="{StaticResource PlaceholderNote}"/>
                                </StackPanel>
                            </TabItem>
                            <TabItem Header="Paddles">
                                <StackPanel Margin="0,16,0,0">
                                    <TextBlock Text="Paddles" Style="{StaticResource PlaceholderHeading}"/>
                                    <TextBlock Text="Placeholder only. Controls are not wired in this phase."
                                               Style="{StaticResource PlaceholderNote}"/>
                                </StackPanel>
                            </TabItem>
                            <TabItem Header="Extra">
                                <StackPanel Margin="0,16,0,0">
                                    <TextBlock Text="Extra" Style="{StaticResource PlaceholderHeading}"/>
                                    <TextBlock Text="Placeholder only. Controls are not wired in this phase."
                                               Style="{StaticResource PlaceholderNote}"/>
                                </StackPanel>
                            </TabItem>
                        </TabControl>
                    </DockPanel>
                </Border>

                <Border Padding="28,24"
                        Visibility="{Binding IsChecked, ElementName=navTrackpad, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Trackpad" Style="{StaticResource PlaceholderHeading}"/>
                        <TextBlock Text="Trackpad bindings and options will live here."
                                   Style="{StaticResource PlaceholderSub}"/>
                        <Separator Margin="0,16,0,16"/>
                        <TextBlock Text="Placeholder only. Controls are not wired in this phase." Style="{StaticResource PlaceholderNote}"/>
                    </StackPanel>
                </Border>

                <Border Padding="28,24"
                        Visibility="{Binding IsChecked, ElementName=navSticks, Converter={StaticResource BoolToVis}}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Sticks" Style="{StaticResource PlaceholderHeading}"/>
                            <TextBlock Text="Configure stick bindings, modes, and analog behaviour."
                                       Style="{StaticResource PlaceholderSub}"/>
                        </StackPanel>

                        <TabControl Margin="0,16,0,0" Style="{StaticResource JsmccPillTabControlStyle}">
                            <TabItem Header="Bindings" Style="{StaticResource JsmccPillTabItemStyle}">
                                <views:SticksBindingsControl Margin="0,16,0,0"/>
                            </TabItem>
                            <TabItem Header="Modes &amp; Settings" Style="{StaticResource JsmccPillTabItemStyle}">
                                <views:SticksModeSettingsControl Margin="0,16,0,0"/>
                            </TabItem>
                        </TabControl>
                    </DockPanel>
                </Border>

                <Border Padding="28,24"
                        Visibility="{Binding IsChecked, ElementName=navOther, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Other" Style="{StaticResource PlaceholderHeading}"/>
                        <TextBlock Text="Profile, documentation, and miscellaneous settings can move here later."
                                   Style="{StaticResource PlaceholderSub}"/>
                        <Separator Margin="0,16,0,16"/>
                        <TextBlock Text="Placeholder only. Controls are not wired in this phase." Style="{StaticResource PlaceholderNote}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </DockPanel>
</Window>
