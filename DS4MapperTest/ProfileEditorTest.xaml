<Window x:Class="DS4MapperTest.ProfileEditorTest"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:local="clr-namespace:DS4MapperTest"
        mc:Ignorable="d"
        Title="DS4Mapper — Profile Editor"
        Height="720" Width="1100"
        MinHeight="600" MinWidth="900"
        Closed="Window_Closed">

    <Window.Background>
        <SolidColorBrush Color="{DynamicResource RegionColor}"/>
    </Window.Background>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- Sidebar navigation tab style -->
        <Style x:Key="NavTabStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Padding" Value="20,13,16,13"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="border"
                                Background="{TemplateBinding Background}"
                                BorderThickness="3,0,0,0"
                                BorderBrush="Transparent">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ItemSelectBrush}"/>
                                <Setter TargetName="border" Property="BorderBrush" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                    <Condition Property="IsChecked" Value="False"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="border" Property="Background" Value="{DynamicResource ItemHoverBrush}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Placeholder card style -->
        <Style x:Key="PlaceholderHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryTextBrush}"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="PlaceholderSub" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource SecondaryTextBrush}"/>
        </Style>
        <Style x:Key="PlaceholderNote" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontStyle" Value="Italic"/>
            <Setter Property="Foreground" Value="{DynamicResource ThirdlyTextBrush}"/>
        </Style>
    </Window.Resources>

    <DockPanel>
        <!-- Top bar: profile name + save controls -->
        <Border DockPanel.Dock="Top"
                BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource BorderBrush}"
                Padding="16,10">
            <DockPanel LastChildFill="False">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="Profile:"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               FontSize="12"
                               Margin="0,0,8,0"/>
                    <TextBox Text="{Binding ProfileName, UpdateSourceTrigger=LostFocus}"
                             Width="220"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Button Content="Save"
                            Click="SaveProfileButton_Click"
                            Style="{StaticResource ButtonPrimary}"
                            Padding="16,6"
                            Margin="0,0,8,0"/>
                    <Button Content="Save &amp; Close"
                            Click="SaveProfileAndCloseButton_Click"
                            Padding="16,6"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Hidden legacy color-picker controls (named references kept for code-behind) -->
        <Grid DockPanel.Dock="Top" Visibility="Collapsed">
            <hc:ColorPicker x:Name="ColorPicker"
                            SelectedColorChanged="ColorPicker_SelectedColorChanged"/>
            <hc:ColorPicker x:Name="ColorPickerBattery"
                            SelectedColorChanged="ColorPickerBattery_SelectedColorChanged"/>
            <hc:ColorPicker x:Name="ColorPickerPulse"
                            SelectedColorChanged="ColorPickerPulse_SelectedColorChanged"/>
        </Grid>

        <!-- Main layout: left sidebar + content area -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left sidebar navigation -->
            <Border Grid.Column="0"
                    BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource BorderBrush}">
                <StackPanel Margin="0,8,0,0">
                    <RadioButton x:Name="navGyroBehavior"
                                 GroupName="MainNav"
                                 Content="Gyro Behavior"
                                 Style="{StaticResource NavTabStyle}"
                                 IsChecked="True"/>
                    <RadioButton x:Name="navKeybinds"
                                 GroupName="MainNav"
                                 Content="Keybinds"
                                 Style="{StaticResource NavTabStyle}"/>
                    <RadioButton x:Name="navSensitivity"
                                 GroupName="MainNav"
                                 Content="Sensitivity"
                                 Style="{StaticResource NavTabStyle}"/>
                    <RadioButton x:Name="navProfiles"
                                 GroupName="MainNav"
                                 Content="Profiles"
                                 Style="{StaticResource NavTabStyle}"/>
                    <RadioButton x:Name="navDocumentation"
                                 GroupName="MainNav"
                                 Content="Documentation"
                                 Style="{StaticResource NavTabStyle}"/>
                </StackPanel>
            </Border>

            <!-- Content panels (one per nav tab, switched by RadioButton IsChecked) -->
            <Grid Grid.Column="1">

                <!-- Gyro Behavior -->
                <Border Padding="28,24"
                        Visibility="{Binding IsChecked, ElementName=navGyroBehavior, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Gyro Behavior" Style="{StaticResource PlaceholderHeading}"/>
                        <TextBlock Text="Configure gyro output mode, axis mapping, and activation trigger."
                                   Style="{StaticResource PlaceholderSub}"/>
                        <Separator Margin="0,16,0,16"/>
                        <TextBlock Text="Settings panel — Step 2" Style="{StaticResource PlaceholderNote}"/>
                    </StackPanel>
                </Border>

                <!-- Keybinds -->
                <Border Padding="28,24"
                        Visibility="{Binding IsChecked, ElementName=navKeybinds, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Keybinds" Style="{StaticResource PlaceholderHeading}"/>
                        <TextBlock Text="Map controller buttons to keyboard, mouse, and gamepad outputs."
                                   Style="{StaticResource PlaceholderSub}"/>
                        <Separator Margin="0,16,0,16"/>
                        <TextBlock Text="Binding UI — Step 4" Style="{StaticResource PlaceholderNote}"/>
                    </StackPanel>
                </Border>

                <!-- Sensitivity -->
                <Border Padding="28,24"
                        Visibility="{Binding IsChecked, ElementName=navSensitivity, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Sensitivity" Style="{StaticResource PlaceholderHeading}"/>
                        <TextBlock Text="Set base and modeshift sensitivity, and choose an acceleration curve."
                                   Style="{StaticResource PlaceholderSub}"/>
                        <Separator Margin="0,16,0,16"/>
                        <TextBlock Text="Sensitivity controls — Step 3" Style="{StaticResource PlaceholderNote}"/>
                    </StackPanel>
                </Border>

                <!-- Profiles -->
                <Border Padding="28,24"
                        Visibility="{Binding IsChecked, ElementName=navProfiles, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Profiles" Style="{StaticResource PlaceholderHeading}"/>
                        <TextBlock Text="Load, save, copy, and delete configuration profiles."
                                   Style="{StaticResource PlaceholderSub}"/>
                        <Separator Margin="0,16,0,16"/>
                        <TextBlock Text="Profile manager — Step 5" Style="{StaticResource PlaceholderNote}"/>
                    </StackPanel>
                </Border>

                <!-- Documentation -->
                <Border Padding="28,24"
                        Visibility="{Binding IsChecked, ElementName=navDocumentation, Converter={StaticResource BoolToVis}}">
                    <StackPanel>
                        <TextBlock Text="Documentation" Style="{StaticResource PlaceholderHeading}"/>
                        <TextBlock Text="JoyShockMapper reference documentation with search."
                                   Style="{StaticResource PlaceholderSub}"/>
                        <Separator Margin="0,16,0,16"/>
                        <TextBlock Text="Embedded docs — Step 6" Style="{StaticResource PlaceholderNote}"/>
                    </StackPanel>
                </Border>

            </Grid>
        </Grid>
    </DockPanel>
</Window>
