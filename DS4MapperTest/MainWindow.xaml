<Window x:Class="DS4MapperTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:views="clr-namespace:DS4MapperTest.Views"
        mc:Ignorable="d"
        Title="DS4Mapper"
        Height="720" Width="1100"
        MinHeight="600" MinWidth="680"
        Background="{DynamicResource JsmccBg0Brush}"
        Closed="Window_Closed"
        Loaded="Window_Loaded"
        PreviewKeyDown="Window_PreviewKeyDown"
        SizeChanged="Window_SizeChanged">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="PlaceholderCardText" TargetType="TextBlock" BasedOn="{StaticResource JsmccMutedText}">
            <Setter Property="FontStyle" Value="Italic"/>
        </Style>

        <Style x:Key="OverlayLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{DynamicResource JsmccTextStrongBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="48"/>
        </Style>

        <Style x:Key="OtherSettingLabel" TargetType="TextBlock" BasedOn="{StaticResource JsmccLabelText}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{DynamicResource JsmccTextStrongBrush}"/>
        </Style>

        <Style x:Key="LightbarPresetButtonStyle" TargetType="Button" BasedOn="{StaticResource JsmccButtonStyle}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,8,3"/>
        </Style>

        <Style x:Key="SaveStatusPillBaseStyle" TargetType="Border">
            <Setter Property="CornerRadius" Value="{StaticResource JsmccButtonRadius}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style x:Key="SaveStatusPillSuccessStyle" TargetType="Border" BasedOn="{StaticResource SaveStatusPillBaseStyle}">
            <Setter Property="Background" Value="{DynamicResource JsmccSuccessBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource JsmccSuccessBorderBrush}"/>
        </Style>

        <Style x:Key="SaveStatusPillErrorStyle" TargetType="Border" BasedOn="{StaticResource SaveStatusPillBaseStyle}">
            <Setter Property="Background" Value="{DynamicResource JsmccDangerBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource JsmccDangerBorderBrush}"/>
        </Style>

        <Style x:Key="SaveStatusPillWarningStyle" TargetType="Border" BasedOn="{StaticResource SaveStatusPillBaseStyle}">
            <Setter Property="Background" Value="{DynamicResource JsmccWarningBgBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource JsmccWarningBorderBrush}"/>
        </Style>

        <Style x:Key="SaveStatusPillTextSuccessStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource JsmccSuccessTextBrush}"/>
        </Style>

        <Style x:Key="SaveStatusPillTextErrorStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource JsmccDangerTextBrush}"/>
        </Style>

        <Style x:Key="SaveStatusPillTextWarningStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource JsmccWarningTextBrush}"/>
        </Style>
    </Window.Resources>

    <Grid Background="{DynamicResource JsmccBg0Brush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="navColumn" Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="navSidebarBorder"
                    Grid.Column="0"
                    Background="{DynamicResource JsmccBg1Brush}"
                    BorderBrush="{DynamicResource JsmccBorderBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="20,24">
                <StackPanel x:Name="navStackPanel">
                    <RadioButton x:Name="navGyroSensitivity"
                                 GroupName="MainNav"
                                 Content="Gyro &amp; Sensitivity"
                                 Style="{StaticResource JsmccNavButtonStyle}"
                                 IsChecked="True"
                                 Checked="NavRadio_Checked"/>
                    <RadioButton x:Name="navKeybinds"
                                 GroupName="MainNav"
                                 Content="Keybinds"
                                 Style="{StaticResource JsmccNavButtonStyle}"
                                 Checked="NavRadio_Checked"/>
                    <RadioButton x:Name="navTrackpad"
                                 GroupName="MainNav"
                                 Content="Touchpad"
                                 Style="{StaticResource JsmccNavButtonStyle}"
                                 Checked="NavRadio_Checked"/>
                    <RadioButton x:Name="navSticks"
                                 GroupName="MainNav"
                                 Content="Sticks"
                                 Style="{StaticResource JsmccNavButtonStyle}"
                                 Checked="NavRadio_Checked"/>
                    <RadioButton x:Name="navOther"
                                 GroupName="MainNav"
                                 Content="Other"
                                 Style="{StaticResource JsmccNavButtonStyle}"
                                 Checked="NavRadio_Checked"/>
                </StackPanel>
            </Border>

            <Popup x:Name="navPopup"
                   PlacementTarget="{Binding ElementName=navHamburgerButton}"
                   Placement="Bottom"
                   StaysOpen="False"
                   AllowsTransparency="True"
                   PopupAnimation="Fade">
                <Border x:Name="navPopupHost"
                        Style="{StaticResource JsmccPanelBorder}"
                        MinWidth="200"
                        Margin="8"/>
            </Popup>

            <DockPanel Grid.Column="1"
                       LastChildFill="True"
                       Background="{DynamicResource JsmccBg0Brush}">
                <Border DockPanel.Dock="Top"
                        Background="{DynamicResource JsmccBg15Brush}"
                        BorderBrush="{DynamicResource JsmccBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="28,13">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <WrapPanel Grid.Column="0"
                                   Orientation="Horizontal"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0">
                            <Button x:Name="navHamburgerButton"
                                    Content="&#9776;"
                                    ToolTip="Menu"
                                    Click="NavHamburgerButton_Click"
                                    Style="{StaticResource JsmccOutputButtonStyle}"
                                    Width="46"
                                    Height="40"
                                    Padding="0"
                                    FontSize="20"
                                    Visibility="Collapsed"
                                    Margin="0,4,16,4"/>

                            <StackPanel Orientation="Horizontal" Margin="0,4,20,4">
                                <TextBlock Text="Device"
                                           Style="{StaticResource JsmccLabelText}"
                                           Margin="0,0,10,0"/>

                                <ComboBox x:Name="deviceComboBox"
                                          Width="230"
                                          DisplayMemberPath="DisplayName"
                                          Style="{StaticResource JsmccComboBoxStyle}"
                                          SelectionChanged="DeviceComboBox_SelectionChanged"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                <TextBlock Text="Profile"
                                           Style="{StaticResource JsmccLabelText}"
                                           Margin="0,0,10,0"/>

                                <ComboBox x:Name="profileComboBox"
                                          Width="230"
                                          DisplayMemberPath="Name"
                                          Style="{StaticResource JsmccComboBoxStyle}"
                                          SelectionChanged="ProfileComboBox_SelectionChanged"/>
                            </StackPanel>

                            <Button Content="Manage"
                                    Click="ManageProfilesBtn_Click"
                                    Margin="8,4,0,4"
                                    Style="{StaticResource JsmccButtonStyle}"/>

                            <TextBlock x:Name="noDeviceHint"
                                       Text="connect a controller to begin"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource JsmccTextMutedBrush}"
                                       FontSize="12"
                                       FontStyle="Italic"
                                       Margin="14,4,0,4"
                                       Visibility="Collapsed"/>
                        </WrapPanel>

                        <StackPanel Grid.Column="1"
                                    Orientation="Horizontal"
                                    VerticalAlignment="Center">
                            <Border x:Name="unsavedStatusPill"
                                    Visibility="{Binding IsProfileDirty, Converter={StaticResource BoolToVis}}"
                                    Style="{StaticResource SaveStatusPillWarningStyle}">
                                <TextBlock Text="Unsaved changes"
                                           Style="{StaticResource SaveStatusPillTextWarningStyle}"/>
                            </Border>

                            <Border x:Name="saveStatusPill"
                                    Visibility="Collapsed"
                                    Style="{StaticResource SaveStatusPillSuccessStyle}">
                                <TextBlock x:Name="saveStatusPillText"
                                           Text="Saved &#x2713;"
                                           Style="{StaticResource SaveStatusPillTextSuccessStyle}"/>
                            </Border>

                            <Button x:Name="saveProfileButton"
                                    Content="Save Profile"
                                    Click="SaveProfileButton_Click"
                                    Margin="12,0,0,0"
                                    Style="{StaticResource JsmccPrimaryButtonStyle}"/>

                            <views:ThemeToggleControl Margin="12,0,0,0"
                                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="actionContextRow"
                        DockPanel.Dock="Top"
                        Background="{DynamicResource JsmccBg1Brush}"
                        BorderBrush="{DynamicResource JsmccBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="28,8"
                        Visibility="Collapsed">
                    <WrapPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                            <TextBlock Text="Action Set"
                                       Style="{StaticResource JsmccLabelText}"
                                       Margin="0,0,8,0"/>

                            <ComboBox x:Name="actionSetComboBox"
                                      Width="140"
                                      DisplayMemberPath="DisplayName"
                                      Style="{StaticResource JsmccComboBoxStyle}"
                                      SelectionChanged="ActionSetComboBox_SelectionChanged"/>
                        </StackPanel>

                        <Button x:Name="addSetButton"
                                Content="+"
                                ToolTip="Add Action Set"
                                Click="AddSetBtn_Click"
                                Style="{StaticResource JsmccOutputButtonStyle}"
                                MinWidth="30"
                                Margin="6,4,0,4"/>
                        <Button x:Name="renameSetButton"
                                Content="Rename"
                                ToolTip="Rename Action Set"
                                Click="RenameSetBtn_Click"
                                Style="{StaticResource JsmccOutputButtonStyle}"
                                Margin="6,4,0,4"/>
                        <Button x:Name="removeSetButton"
                                Content="Remove"
                                ToolTip="Remove Action Set"
                                Click="RemoveSetBtn_Click"
                                Style="{StaticResource JsmccDangerButtonStyle}"
                                Padding="10,6"
                                MinHeight="30"
                                FontSize="12"
                                Margin="6,4,0,4"/>

                        <TextBox x:Name="renameSetTextBox"
                                 Width="140"
                                 Visibility="Collapsed"
                                 Style="{StaticResource JsmccTextBoxStyle}"
                                 KeyDown="RenameSetTextBox_KeyDown"
                                 Margin="0,4,0,4"/>
                        <Button x:Name="confirmRenameSetButton"
                                Content="&#x2713;"
                                ToolTip="Save name"
                                Visibility="Collapsed"
                                Click="ConfirmRenameSetBtn_Click"
                                Style="{StaticResource JsmccOutputButtonStyle}"
                                MinWidth="30"
                                Margin="6,4,0,4"/>
                        <Button x:Name="cancelRenameSetButton"
                                Content="&#x2715;"
                                ToolTip="Cancel"
                                Visibility="Collapsed"
                                Click="CancelRenameSetBtn_Click"
                                Style="{StaticResource JsmccOutputButtonStyle}"
                                MinWidth="30"
                                Margin="4,4,0,4"/>

                        <StackPanel Orientation="Horizontal" Margin="28,4,0,4">
                            <TextBlock Text="Layer"
                                       Style="{StaticResource JsmccLabelText}"
                                       Margin="0,0,8,0"/>

                            <ComboBox x:Name="actionLayerComboBox"
                                      Width="140"
                                      DisplayMemberPath="DisplayName"
                                      Style="{StaticResource JsmccComboBoxStyle}"
                                      SelectionChanged="ActionLayerComboBox_SelectionChanged"/>
                        </StackPanel>

                        <Button x:Name="addLayerButton"
                                Content="+"
                                ToolTip="Add Action Layer"
                                Click="AddLayerBtn_Click"
                                Style="{StaticResource JsmccOutputButtonStyle}"
                                MinWidth="30"
                                Margin="6,4,0,4"/>
                        <Button x:Name="renameLayerButton"
                                Content="Rename"
                                ToolTip="Rename Action Layer"
                                Click="RenameLayerBtn_Click"
                                Style="{StaticResource JsmccOutputButtonStyle}"
                                Margin="6,4,0,4"/>
                        <Button x:Name="removeLayerButton"
                                Content="Remove"
                                ToolTip="Remove Action Layer"
                                Click="RemoveLayerBtn_Click"
                                Style="{StaticResource JsmccDangerButtonStyle}"
                                Padding="10,6"
                                MinHeight="30"
                                FontSize="12"
                                Margin="6,4,0,4"/>

                        <TextBox x:Name="renameLayerTextBox"
                                 Width="140"
                                 Visibility="Collapsed"
                                 Style="{StaticResource JsmccTextBoxStyle}"
                                 KeyDown="RenameLayerTextBox_KeyDown"
                                 Margin="0,4,0,4"/>
                        <Button x:Name="confirmRenameLayerButton"
                                Content="&#x2713;"
                                ToolTip="Save name"
                                Visibility="Collapsed"
                                Click="ConfirmRenameLayerBtn_Click"
                                Style="{StaticResource JsmccOutputButtonStyle}"
                                MinWidth="30"
                                Margin="6,4,0,4"/>
                        <Button x:Name="cancelRenameLayerButton"
                                Content="&#x2715;"
                                ToolTip="Cancel"
                                Visibility="Collapsed"
                                Click="CancelRenameLayerBtn_Click"
                                Style="{StaticResource JsmccOutputButtonStyle}"
                                MinWidth="30"
                                Margin="4,4,0,4"/>
                    </WrapPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="{StaticResource JsmccShellPadding}">
                        <Border Visibility="{Binding IsChecked, ElementName=navGyroSensitivity, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource JsmccPanelBorder}">
                            <StackPanel>
                                <TextBlock Text="Gyro &amp; Sensitivity" Style="{StaticResource JsmccPageTitle}"/>
                                <TextBlock Text="Configure gyro behaviour, sensitivity, and curve settings."
                                           Style="{StaticResource JsmccBodyText}"
                                           Margin="0,0,0,12"/>

                                <TabControl Style="{StaticResource JsmccPillTabControlStyle}">
                                    <TabItem Header="Action">
                                        <views:GyroActionsPanel/>
                                    </TabItem>
                                    <TabItem Header="Gyro">
                                        <views:GyroOutputControl/>
                                    </TabItem>
                                    <TabItem Header="Sensitivity">
                                        <views:GyroSensitivityControl/>
                                    </TabItem>
                                    <TabItem Header="Noise &amp; Steadying">
                                        <views:GyroNoiseSteadyingControl/>
                                    </TabItem>
                                </TabControl>
                            </StackPanel>
                        </Border>

                        <Border Visibility="{Binding IsChecked, ElementName=navKeybinds, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource JsmccPanelBorder}">
                            <StackPanel>
                                <TextBlock Text="Keybinds" Style="{StaticResource JsmccPageTitle}"/>
                                <TextBlock Text="Map controller buttons to keyboard, mouse, and gamepad outputs."
                                           Style="{StaticResource JsmccBodyText}"
                                           Margin="0,0,0,12"/>

                                <TabControl Style="{StaticResource JsmccPillTabControlStyle}">
                                    <TabItem Header="Face">
                                        <views:FaceKeybindsControl/>
                                    </TabItem>
                                    <TabItem Header="D-Pad">
                                        <views:DPadKeybindsControl/>
                                    </TabItem>
                                    <TabItem Header="Bumpers">
                                        <views:BumpersKeybindsControl/>
                                    </TabItem>
                                    <TabItem Header="Triggers">
                                        <views:TriggersKeybindsControl/>
                                    </TabItem>
                                    <TabItem Header="Center">
                                        <views:CenterKeybindsControl/>
                                    </TabItem>
                                    <TabItem Header="Paddles">
                                        <views:PaddlesKeybindsControl/>
                                    </TabItem>
                                    <TabItem Header="Extra">
                                        <views:AlwaysOnKeybindsControl/>
                                    </TabItem>
                                </TabControl>
                            </StackPanel>
                        </Border>

                        <Border Visibility="{Binding IsChecked, ElementName=navTrackpad, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource JsmccPanelBorder}">
                            <StackPanel>
                                <TextBlock Text="Touchpad" Style="{StaticResource JsmccPageTitle}"/>
                                <TextBlock Text="Configure touchpad bindings, movement, zones, gestures, trackball, and scroll options."
                                           Style="{StaticResource JsmccBodyText}"
                                           Margin="0,0,0,12"/>

                                <views:TouchpadControl/>
                            </StackPanel>
                        </Border>

                        <Border Visibility="{Binding IsChecked, ElementName=navSticks, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource JsmccPanelBorder}">
                            <StackPanel>
                                <TextBlock Text="Sticks" Style="{StaticResource JsmccPageTitle}"/>
                                <TextBlock Text="Configure stick bindings, modes, and analog behaviour."
                                           Style="{StaticResource JsmccBodyText}"
                                           Margin="0,0,0,12"/>

                                <TabControl Style="{StaticResource JsmccPillTabControlStyle}">
                                    <TabItem Header="Bindings">
                                        <views:SticksBindingsControl/>
                                    </TabItem>
                                    <TabItem Header="Modes &amp; Settings">
                                        <views:SticksModeSettingsControl/>
                                    </TabItem>
                                </TabControl>
                            </StackPanel>
                        </Border>

                        <Border Visibility="{Binding IsChecked, ElementName=navOther, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource JsmccPanelBorder}">
                            <StackPanel>
                                <TextBlock Text="Other" Style="{StaticResource JsmccPageTitle}"/>
                                <TextBlock Text="Configure output controller, vibration, and lightbar options."
                                           Style="{StaticResource JsmccBodyText}"
                                           Margin="0,0,0,12"/>

                                <Border Style="{StaticResource JsmccCardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="Output Controller" Style="{StaticResource JsmccSectionTitle}"/>

                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Output Controller" Style="{StaticResource OtherSettingLabel}"/>
                                                <TextBlock Text="Enables controller output using the selected virtual controller type."
                                                           Style="{StaticResource JsmccMutedText}"
                                                           Margin="0,3,16,0"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1"
                                                      Style="{StaticResource JsmccToggleStyle}"
                                                      IsChecked="{Binding OutControllerEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="220"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Controller Type" Style="{StaticResource OtherSettingLabel}"/>
                                                <TextBlock Text="Selects the virtual controller type used for output."
                                                           Style="{StaticResource JsmccMutedText}"
                                                           Margin="0,3,16,0"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding OutputControllerTypeOptions}"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectedValuePath="ChoiceValue"
                                                      SelectedValue="{Binding CurrentOutputControllerType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource JsmccComboBoxStyle}"
                                                      VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource JsmccCardBorder}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Vibration/Haptic Feedback" Style="{StaticResource JsmccSectionTitle}"/>
                                            <TextBlock Text="Enables vibration or haptic feedback where supported."
                                                       Style="{StaticResource JsmccMutedText}"
                                                       Margin="0,6,16,0"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1"
                                                  Style="{StaticResource JsmccToggleStyle}"
                                                  IsChecked="{Binding ForceFeedbackEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource JsmccCardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="Lightbar" Style="{StaticResource JsmccSectionTitle}"/>

                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="220"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Lightbar Mode" Style="{StaticResource OtherSettingLabel}"/>
                                                <TextBlock Text="Chooses the existing lightbar behaviour for supported controllers."
                                                           Style="{StaticResource JsmccMutedText}"
                                                           Margin="0,3,16,0"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding LightbarModeOptions}"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectedValuePath="ChoiceValue"
                                                      SelectedValue="{Binding CurrentLightbarMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource JsmccComboBoxStyle}"
                                                      VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid Margin="0,12,0,0"
                                              Visibility="{Binding IsSolidLightbarMode, Converter={StaticResource BoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Lightbar Colour" Style="{StaticResource OtherSettingLabel}"/>
                                                <TextBlock Text="Sets the solid lightbar colour stored in the profile."
                                                           Style="{StaticResource JsmccMutedText}"
                                                           Margin="0,3,16,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Border Width="34"
                                                        Height="28"
                                                        Background="{Binding LightbarPreviewBrush}"
                                                        BorderBrush="{DynamicResource JsmccBorderStrongBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource JsmccControlRadius}"
                                                        Margin="0,0,8,0"/>
                                                <TextBox Width="92"
                                                         Text="{Binding LightbarHexColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         CharacterCasing="Upper"
                                                         MaxLength="7"
                                                         Style="{StaticResource JsmccTextBoxStyle}"/>
                                            </StackPanel>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding LightbarPresetColors}"
                                                      Margin="0,10,0,0"
                                                      Visibility="{Binding IsSolidLightbarMode, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="9" Rows="2"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Tag="{Binding HexColor}"
                                                            ToolTip="{Binding HexColor}"
                                                            Background="{Binding Brush}"
                                                            BorderBrush="{DynamicResource JsmccBorderStrongBrush}"
                                                            Click="LightbarPreset_Click"
                                                            Style="{StaticResource LightbarPresetButtonStyle}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Grid Margin="0,12,0,0"
                                              Visibility="{Binding IsRainbowLightbarMode, Converter={StaticResource BoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Cycle Time" Style="{StaticResource OtherSettingLabel}"/>
                                                <TextBlock Text="Time in seconds for one full rainbow cycle."
                                                           Style="{StaticResource JsmccMutedText}"
                                                           Margin="0,3,16,0"/>
                                            </StackPanel>
                                            <TextBox Grid.Column="1"
                                                     Width="92"
                                                     Text="{Binding RainbowSecondsCycle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource JsmccTextBoxStyle}"
                                                     VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid Margin="0,12,0,0"
                                              Visibility="{Binding IsPulseLightbarMode, Converter={StaticResource BoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Pulse Colour" Style="{StaticResource OtherSettingLabel}"/>
                                                <TextBlock Text="Colour used by the pulse lightbar effect."
                                                           Style="{StaticResource JsmccMutedText}"
                                                           Margin="0,3,16,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Border Width="34"
                                                        Height="28"
                                                        Background="{Binding LightbarPulsePreviewBrush}"
                                                        BorderBrush="{DynamicResource JsmccBorderStrongBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource JsmccControlRadius}"
                                                        Margin="0,0,8,0"/>
                                                <TextBox Width="92"
                                                         Text="{Binding LightbarPulseHexColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         CharacterCasing="Upper"
                                                         MaxLength="7"
                                                         Style="{StaticResource JsmccTextBoxStyle}"/>
                                            </StackPanel>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding LightbarPresetColors}"
                                                      Margin="0,10,0,0"
                                                      Visibility="{Binding IsPulseLightbarMode, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="9" Rows="2"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Tag="{Binding HexColor}"
                                                            ToolTip="{Binding HexColor}"
                                                            Background="{Binding Brush}"
                                                            BorderBrush="{DynamicResource JsmccBorderStrongBrush}"
                                                            Click="LightbarPulsePreset_Click"
                                                            Style="{StaticResource LightbarPresetButtonStyle}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <Grid Margin="0,12,0,0"
                                              Visibility="{Binding IsBatteryLightbarMode, Converter={StaticResource BoolToVis}}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Battery Colour" Style="{StaticResource OtherSettingLabel}"/>
                                                <TextBlock Text="Colour used by the battery lightbar mode where supported."
                                                           Style="{StaticResource JsmccMutedText}"
                                                           Margin="0,3,16,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Border Width="34"
                                                        Height="28"
                                                        Background="{Binding LightbarBatteryPreviewBrush}"
                                                        BorderBrush="{DynamicResource JsmccBorderStrongBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource JsmccControlRadius}"
                                                        Margin="0,0,8,0"/>
                                                <TextBox Width="92"
                                                         Text="{Binding LightbarBatteryHexColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         CharacterCasing="Upper"
                                                         MaxLength="7"
                                                         Style="{StaticResource JsmccTextBoxStyle}"/>
                                            </StackPanel>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding LightbarPresetColors}"
                                                      Margin="0,10,0,0"
                                                      Visibility="{Binding IsBatteryLightbarMode, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="9" Rows="2"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Tag="{Binding HexColor}"
                                                            ToolTip="{Binding HexColor}"
                                                            Background="{Binding Brush}"
                                                            BorderBrush="{DynamicResource JsmccBorderStrongBrush}"
                                                            Click="LightbarBatteryPreset_Click"
                                                            Style="{StaticResource LightbarPresetButtonStyle}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Grid>

        <Grid x:Name="profilesOverlay" Visibility="Collapsed">
            <Rectangle Fill="#AA000000"
                       MouseLeftButtonDown="ProfilesOverlayBackdrop_MouseDown"/>

            <Border MaxWidth="540"
                    MaxHeight="660"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="20"
                    Style="{StaticResource JsmccPanelBorder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <DockPanel LastChildFill="True" Margin="0,0,0,16">
                            <Button Content="X"
                                    Click="CloseProfileOverlay_Click"
                                    DockPanel.Dock="Right"
                                    Width="34" Height="34"
                                    Padding="0"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource JsmccButtonStyle}"/>
                            <TextBlock Text="Manage Profiles"
                                       Style="{StaticResource JsmccSectionTitle}"
                                       VerticalAlignment="Center"/>
                        </DockPanel>

                        <WrapPanel Margin="0,0,0,14">
                            <Button Content="New Profile"
                                    Click="NewProfileBtn_Click"
                                    Style="{StaticResource JsmccButtonStyle}"
                                    Margin="0,0,8,6"/>
                            <Button Content="Copy Active"
                                    Click="CopyActiveBtn_Click"
                                    Style="{StaticResource JsmccButtonStyle}"
                                    Margin="0,0,8,6"/>
                            <Button Content="Load from File..."
                                    Click="LoadProfileFileBtn_Click"
                                    Style="{StaticResource JsmccButtonStyle}"
                                    Margin="0,0,0,6"/>
                        </WrapPanel>

                        <ListBox x:Name="profileListBox"
                                 MaxHeight="240"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Background="{DynamicResource JsmccBgInputBrush}"
                                 BorderBrush="{DynamicResource JsmccBorderBrush}"
                                 Foreground="{DynamicResource JsmccTextStrongBrush}"
                                 SelectionChanged="ProfileListBox_SelectionChanged"
                                 Padding="0">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="Foreground" Value="{DynamicResource JsmccTextStrongBrush}"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="*"
                                                   Foreground="{DynamicResource JsmccAccentBrush}"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{DynamicResource JsmccTextStrongBrush}"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border x:Name="selectedProfilePanel"
                                Visibility="Collapsed"
                                BorderThickness="1,0,0,0"
                                BorderBrush="{DynamicResource JsmccBorderBrush}"
                                Margin="0,14,0,0"
                                Padding="0,14,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="Name"
                                               Style="{StaticResource OverlayLabel}"/>
                                    <TextBox x:Name="profileRenameBox"
                                             Width="210"
                                             Style="{StaticResource JsmccTextBoxStyle}"/>
                                    <Button Content="Save Name"
                                            Click="RenameProfileBtn_Click"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource JsmccButtonStyle}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Load This Profile"
                                            Click="LoadProfileFromListBtn_Click"
                                            Style="{StaticResource JsmccPrimaryButtonStyle}"
                                            Margin="0,0,10,0"/>
                                    <Button Content="Delete"
                                            Click="DeleteProfileBtn_Click"
                                            Style="{StaticResource JsmccDangerButtonStyle}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
