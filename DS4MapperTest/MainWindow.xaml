<Window x:Class="DS4MapperTest.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xmlns:views="clr-namespace:DS4MapperTest.Views"
        mc:Ignorable="d"
        Title="DS4Mapper"
        Height="720" Width="1100"
        MinHeight="600" MinWidth="900"
        Background="{StaticResource JsmccBg0Brush}"
        Closed="Window_Closed"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style x:Key="PlaceholderCardText" TargetType="TextBlock" BasedOn="{StaticResource JsmccMutedText}">
            <Setter Property="FontStyle" Value="Italic"/>
        </Style>

        <Style x:Key="OverlayLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="{StaticResource JsmccTextStrongBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width" Value="48"/>
        </Style>

        <Style x:Key="OtherSettingLabel" TargetType="TextBlock" BasedOn="{StaticResource JsmccLabelText}">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource JsmccTextStrongBrush}"/>
        </Style>

        <Style x:Key="LightbarPresetButtonStyle" TargetType="Button" BasedOn="{StaticResource JsmccButtonStyle}">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="MinHeight" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource JsmccBg0Brush}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Background="{StaticResource JsmccBg1Brush}"
                    BorderBrush="{StaticResource JsmccBorderBrush}"
                    BorderThickness="0,0,1,0"
                    Padding="20,24">
                <DockPanel LastChildFill="True">
                    <StackPanel>
                        <RadioButton x:Name="navGyroSensitivity"
                                     GroupName="MainNav"
                                     Content="Gyro &amp; Sensitivity"
                                     Style="{StaticResource JsmccNavButtonStyle}"
                                     IsChecked="True"/>
                        <RadioButton x:Name="navKeybinds"
                                     GroupName="MainNav"
                                     Content="Keybinds"
                                     Style="{StaticResource JsmccNavButtonStyle}"/>
                        <RadioButton x:Name="navTrackpad"
                                     GroupName="MainNav"
                                     Content="Touchpad"
                                     Style="{StaticResource JsmccNavButtonStyle}"/>
                        <RadioButton x:Name="navSticks"
                                     GroupName="MainNav"
                                     Content="Sticks"
                                     Style="{StaticResource JsmccNavButtonStyle}"/>
                        <RadioButton x:Name="navOther"
                                     GroupName="MainNav"
                                     Content="Other"
                                     Style="{StaticResource JsmccNavButtonStyle}"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <DockPanel Grid.Column="1"
                       LastChildFill="True"
                       Background="{StaticResource JsmccBg0Brush}">
                <Border DockPanel.Dock="Top"
                        Background="{StaticResource JsmccBg15Brush}"
                        BorderBrush="{StaticResource JsmccBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="28,13">
                    <DockPanel LastChildFill="False">
                        <StackPanel Orientation="Horizontal"
                                    DockPanel.Dock="Left"
                                    VerticalAlignment="Center">
                            <TextBlock Text="Profile"
                                       Style="{StaticResource JsmccLabelText}"
                                       Margin="0,0,10,0"/>

                            <ComboBox x:Name="profileComboBox"
                                      Width="230"
                                      DisplayMemberPath="Name"
                                      Style="{StaticResource JsmccComboBoxStyle}"
                                      SelectionChanged="ProfileComboBox_SelectionChanged"/>

                            <Button Content="Manage"
                                    Click="ManageProfilesBtn_Click"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource JsmccButtonStyle}"/>

                            <TextBlock x:Name="noDeviceHint"
                                       Text="connect a controller to begin"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource JsmccTextMutedBrush}"
                                       FontSize="12"
                                       FontStyle="Italic"
                                       Margin="14,0,0,0"
                                       Visibility="Collapsed"/>
                        </StackPanel>

                        <Button DockPanel.Dock="Right"
                                Content="Save Profile"
                                Click="SaveProfileButton_Click"
                                Style="{StaticResource JsmccPrimaryButtonStyle}"/>
                    </DockPanel>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid Margin="{StaticResource JsmccShellPadding}">
                        <Border Visibility="{Binding IsChecked, ElementName=navGyroSensitivity, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource JsmccPanelBorder}">
                            <StackPanel>
                                <TextBlock Text="Gyro &amp; Sensitivity" Style="{StaticResource JsmccPageTitle}"/>
                                <TextBlock Text="Configure gyro behaviour, sensitivity, and curve settings."
                                           Style="{StaticResource JsmccBodyText}"
                                           Margin="0,0,0,12"/>

                                <TabControl Style="{StaticResource JsmccPillTabControlStyle}">
                                    <TabItem Header="Gyro">
                                        <views:GyroCalibrationControl DataContext="{Binding GyroCalibVM}"/>
                                    </TabItem>
                                    <TabItem Header="Sensitivity">
                                        <views:GyroSensitivityControl DataContext="{Binding GyroSensitivityVM}"/>
                                    </TabItem>
                                    <TabItem Header="Noise &amp; Steadying">
                                        <views:GyroNoiseSteadyingControl DataContext="{Binding GyroNoiseSteadyingVM}"/>
                                    </TabItem>
                                </TabControl>
                            </StackPanel>
                        </Border>

                        <Border Visibility="{Binding IsChecked, ElementName=navKeybinds, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource JsmccPanelBorder}">
                            <StackPanel>
                                <TextBlock Text="Keybinds" Style="{StaticResource JsmccPageTitle}"/>
                                <TextBlock Text="Map controller buttons to keyboard, mouse, and gamepad outputs."
                                           Style="{StaticResource JsmccBodyText}"
                                           Margin="0,0,0,12"/>

                                <TabControl Style="{StaticResource JsmccPillTabControlStyle}">
                                    <TabItem Header="Face">
                                        <views:FaceKeybindsControl/>
                                    </TabItem>
                                    <TabItem Header="D-Pad">
                                        <views:DPadKeybindsControl/>
                                    </TabItem>
                                    <TabItem Header="Bumpers">
                                        <views:BumpersKeybindsControl/>
                                    </TabItem>
                                    <TabItem Header="Triggers">
                                        <views:TriggersKeybindsControl/>
                                    </TabItem>
                                    <TabItem Header="Center">
                                        <views:CenterKeybindsControl/>
                                    </TabItem>
                                    <TabItem Header="Paddles">
                                        <views:PaddlesKeybindsControl/>
                                    </TabItem>
                                    <TabItem Header="Extra">
                                        <Border Style="{StaticResource JsmccCardBorder}" Margin="0">
                                            <StackPanel>
                                                <TextBlock Text="Extra" Style="{StaticResource JsmccSectionTitle}"/>
                                                <TextBlock Text="Placeholder only. Controls are not wired in this phase."
                                                           Style="{StaticResource PlaceholderCardText}"
                                                           Margin="0,6,0,0"/>
                                            </StackPanel>
                                        </Border>
                                    </TabItem>
                                </TabControl>
                            </StackPanel>
                        </Border>

                        <Border Visibility="{Binding IsChecked, ElementName=navTrackpad, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource JsmccPanelBorder}">
                            <StackPanel>
                                <TextBlock Text="Touchpad" Style="{StaticResource JsmccPageTitle}"/>
                                <TextBlock Text="Configure touchpad bindings, movement, zones, gestures, trackball, and scroll options."
                                           Style="{StaticResource JsmccBodyText}"
                                           Margin="0,0,0,12"/>

                                <views:TouchpadControl/>
                            </StackPanel>
                        </Border>

                        <Border Visibility="{Binding IsChecked, ElementName=navSticks, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource JsmccPanelBorder}">
                            <StackPanel>
                                <TextBlock Text="Sticks" Style="{StaticResource JsmccPageTitle}"/>
                                <TextBlock Text="Configure stick bindings, modes, and analog behaviour."
                                           Style="{StaticResource JsmccBodyText}"
                                           Margin="0,0,0,12"/>

                                <TabControl Style="{StaticResource JsmccPillTabControlStyle}">
                                    <TabItem Header="Bindings">
                                        <views:SticksBindingsControl/>
                                    </TabItem>
                                    <TabItem Header="Modes &amp; Settings">
                                        <views:SticksModeSettingsControl/>
                                    </TabItem>
                                </TabControl>
                            </StackPanel>
                        </Border>

                        <Border Visibility="{Binding IsChecked, ElementName=navOther, Converter={StaticResource BoolToVis}}"
                                Style="{StaticResource JsmccPanelBorder}">
                            <StackPanel>
                                <TextBlock Text="Other" Style="{StaticResource JsmccPageTitle}"/>
                                <TextBlock Text="Configure output controller, vibration, and lightbar options."
                                           Style="{StaticResource JsmccBodyText}"
                                           Margin="0,0,0,12"/>

                                <Border Style="{StaticResource JsmccCardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="Output Controller" Style="{StaticResource JsmccSectionTitle}"/>

                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Output Controller" Style="{StaticResource OtherSettingLabel}"/>
                                                <TextBlock Text="Enables controller output using the selected virtual controller type."
                                                           Style="{StaticResource JsmccMutedText}"
                                                           Margin="0,3,16,0"/>
                                            </StackPanel>
                                            <CheckBox Grid.Column="1"
                                                      Style="{StaticResource JsmccToggleStyle}"
                                                      IsChecked="{Binding OutControllerEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="220"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Controller Type" Style="{StaticResource OtherSettingLabel}"/>
                                                <TextBlock Text="Selects the virtual controller type used for output."
                                                           Style="{StaticResource JsmccMutedText}"
                                                           Margin="0,3,16,0"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding OutputControllerTypeOptions}"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectedValuePath="ChoiceValue"
                                                      SelectedValue="{Binding CurrentOutputControllerType, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource JsmccComboBoxStyle}"
                                                      VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource JsmccCardBorder}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Vibration/Haptic Feedback" Style="{StaticResource JsmccSectionTitle}"/>
                                            <TextBlock Text="Enables vibration or haptic feedback where supported."
                                                       Style="{StaticResource JsmccMutedText}"
                                                       Margin="0,6,16,0"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="1"
                                                  Style="{StaticResource JsmccToggleStyle}"
                                                  IsChecked="{Binding ForceFeedbackEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                  VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>

                                <Border Style="{StaticResource JsmccCardBorder}">
                                    <StackPanel>
                                        <TextBlock Text="Lightbar" Style="{StaticResource JsmccSectionTitle}"/>

                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="220"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Lightbar Mode" Style="{StaticResource OtherSettingLabel}"/>
                                                <TextBlock Text="Chooses the existing lightbar behaviour for supported controllers."
                                                           Style="{StaticResource JsmccMutedText}"
                                                           Margin="0,3,16,0"/>
                                            </StackPanel>
                                            <ComboBox Grid.Column="1"
                                                      ItemsSource="{Binding LightbarModeOptions}"
                                                      DisplayMemberPath="DisplayName"
                                                      SelectedValuePath="ChoiceValue"
                                                      SelectedValue="{Binding CurrentLightbarMode, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                      Style="{StaticResource JsmccComboBoxStyle}"
                                                      VerticalAlignment="Center"/>
                                        </Grid>

                                        <Grid Margin="0,12,0,0"
                                              IsEnabled="{Binding IsSolidLightbarMode}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Text="Lightbar Colour" Style="{StaticResource OtherSettingLabel}"/>
                                                <TextBlock Text="Sets the solid lightbar colour stored in the profile."
                                                           Style="{StaticResource JsmccMutedText}"
                                                           Margin="0,3,16,0"/>
                                            </StackPanel>
                                            <StackPanel Grid.Column="1"
                                                        Orientation="Horizontal"
                                                        VerticalAlignment="Center">
                                                <Border Width="34"
                                                        Height="28"
                                                        Background="{Binding LightbarPreviewBrush}"
                                                        BorderBrush="{StaticResource JsmccBorderStrongBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="{StaticResource JsmccControlRadius}"
                                                        Margin="0,0,8,0"/>
                                                <TextBox Width="92"
                                                         Text="{Binding LightbarHexColor, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                         CharacterCasing="Upper"
                                                         MaxLength="7"
                                                         Style="{StaticResource JsmccTextBoxStyle}"/>
                                            </StackPanel>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding LightbarPresetHexColors}"
                                                      Margin="0,10,0,0"
                                                      IsEnabled="{Binding IsSolidLightbarMode}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Tag="{Binding}"
                                                            ToolTip="{Binding}"
                                                            Click="LightbarPreset_Click"
                                                            Style="{StaticResource LightbarPresetButtonStyle}">
                                                        <Border CornerRadius="5"
                                                                Margin="3"
                                                                BorderBrush="{StaticResource JsmccBorderStrongBrush}"
                                                                BorderThickness="1">
                                                            <Border.Background>
                                                                <SolidColorBrush Color="{Binding}"/>
                                                            </Border.Background>
                                                        </Border>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Grid>

        <Grid x:Name="profilesOverlay" Visibility="Collapsed">
            <Rectangle Fill="#AA000000"
                       MouseLeftButtonDown="ProfilesOverlayBackdrop_MouseDown"/>

            <Border MaxWidth="540"
                    MaxHeight="660"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Margin="20"
                    Style="{StaticResource JsmccPanelBorder}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <DockPanel LastChildFill="True" Margin="0,0,0,16">
                            <Button Content="X"
                                    Click="CloseProfileOverlay_Click"
                                    DockPanel.Dock="Right"
                                    Width="34" Height="34"
                                    Padding="0"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource JsmccButtonStyle}"/>
                            <TextBlock Text="Manage Profiles"
                                       Style="{StaticResource JsmccSectionTitle}"
                                       VerticalAlignment="Center"/>
                        </DockPanel>

                        <WrapPanel Margin="0,0,0,14">
                            <Button Content="New Profile"
                                    Click="NewProfileBtn_Click"
                                    Style="{StaticResource JsmccButtonStyle}"
                                    Margin="0,0,8,6"/>
                            <Button Content="Copy Active"
                                    Click="CopyActiveBtn_Click"
                                    Style="{StaticResource JsmccButtonStyle}"
                                    Margin="0,0,8,6"/>
                            <Button Content="Load from File..."
                                    Click="LoadProfileFileBtn_Click"
                                    Style="{StaticResource JsmccButtonStyle}"
                                    Margin="0,0,0,6"/>
                        </WrapPanel>

                        <ListBox x:Name="profileListBox"
                                 MaxHeight="240"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 Background="{StaticResource JsmccBgInputBrush}"
                                 BorderBrush="{StaticResource JsmccBorderBrush}"
                                 Foreground="{StaticResource JsmccTextStrongBrush}"
                                 SelectionChanged="ProfileListBox_SelectionChanged"
                                 Padding="0">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="10,8"/>
                                    <Setter Property="Foreground" Value="{StaticResource JsmccTextStrongBrush}"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="*"
                                                   Foreground="{StaticResource JsmccAccentBrush}"
                                                   FontSize="13"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,8,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Hidden"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{StaticResource JsmccTextStrongBrush}"
                                                   VerticalAlignment="Center"
                                                   FontSize="13"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>

                        <Border x:Name="selectedProfilePanel"
                                Visibility="Collapsed"
                                BorderThickness="1,0,0,0"
                                BorderBrush="{StaticResource JsmccBorderBrush}"
                                Margin="0,14,0,0"
                                Padding="0,14,0,0">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <TextBlock Text="Name"
                                               Style="{StaticResource OverlayLabel}"/>
                                    <TextBox x:Name="profileRenameBox"
                                             Width="210"
                                             Style="{StaticResource JsmccTextBoxStyle}"/>
                                    <Button Content="Save Name"
                                            Click="RenameProfileBtn_Click"
                                            Margin="8,0,0,0"
                                            Style="{StaticResource JsmccButtonStyle}"/>
                                </StackPanel>

                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Load This Profile"
                                            Click="LoadProfileFromListBtn_Click"
                                            Style="{StaticResource JsmccPrimaryButtonStyle}"
                                            Margin="0,0,10,0"/>
                                    <Button Content="Delete"
                                            Click="DeleteProfileBtn_Click"
                                            Style="{StaticResource JsmccDangerButtonStyle}"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</Window>
