<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <Platforms>x64</Platforms>
    <IsPublishable>False</IsPublishable>
    <Configurations>Debug;Release;Debug Tests;Release Tests</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.6.0" />
    <PackageReference Include="MSTest.TestAdapter" Version="4.2.3" />
    <PackageReference Include="MSTest.TestFramework" Version="4.2.3" />
    <PackageReference Include="coverlet.collector" Version="10.0.1">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DS4MapperTest\DS4MapperTest.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <Sdl3WindowsNativePath>$(NuGetPackageRoot)sdl3-cs.windows\3.4.14.1\runtimes\win-x64\native\SDL3.dll</Sdl3WindowsNativePath>
  </PropertyGroup>

  <Target Name="CopySdl3WindowsNativeLibrary" AfterTargets="Build"
          Condition="'$(Platform)' == 'x64' and Exists('$(Sdl3WindowsNativePath)')">
    <Copy SourceFiles="$(Sdl3WindowsNativePath)"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="true" />
  </Target>

</Project>
